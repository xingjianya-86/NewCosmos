<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/maui/global"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         设计令牌 · 纸墨档案风（code.html 同源色板）
         键名与历史版本完全一致，仅替换取值 → 全库页面自动继承，零编译改动。
         底色 暖纸 / 文字 暖墨 / 强调 朱砂 / 状态 松绿·赭金
         ═══════════════════════════════════════════════════════════════ -->

    <!-- 主题色 - 朱砂印红 -->
    <Color x:Key="Primary">#ab3227</Color>
    <Color x:Key="PrimaryLight">#c9483c</Color>
    <Color x:Key="PrimaryDark">#7f231b</Color>
    <Color x:Key="PrimaryGradientStart">#ab3227</Color>
    <Color x:Key="PrimaryGradientEnd">#7f231b</Color>

    <!-- 辅助色 - 松绿 -->
    <Color x:Key="Secondary">#2e4738</Color>
    <Color x:Key="SecondaryLight">#4a6b56</Color>
    <Color x:Key="SecondaryDark">#22352a</Color>

    <!-- 强调色 - 赭金 -->
    <Color x:Key="Accent">#96681c</Color>
    <Color x:Key="AccentLight">#b98a3c</Color>

    <!-- 背景色（暖纸三层） -->
    <Color x:Key="Background">#f2ece1</Color>
    <Color x:Key="CardBackground">#f8f3e9</Color>
    <Color x:Key="HeaderBackground">#e9e1d1</Color>
    <Color x:Key="SurfaceVariant">#e9e1d1</Color>
    <Color x:Key="Surface">#f8f3e9</Color>

    <!-- 文字色（暖墨） -->
    <Color x:Key="TextPrimary">#171310</Color>
    <Color x:Key="TextSecondary">#4c4237</Color>
    <Color x:Key="TextTertiary">#8b7f6c</Color>
    <Color x:Key="TextWhite">#ffffff</Color>
    <Color x:Key="TextDark">#171310</Color>

    <!-- 状态色（注意：Error 刻意比 Primary/Seal 更深一档 #7f231b，
         避免与 Primary 同为朱砂系导致"编辑/删除"等并列按钮无法区分——两令牌同值时渲染完全一致） -->
    <Color x:Key="Success">#2e4738</Color>
    <Color x:Key="SuccessLight">#4a6b56</Color>
    <Color x:Key="Warning">#96681c</Color>
    <Color x:Key="WarningDark">#7a5315</Color>
    <Color x:Key="WarningLight">#f3e6cf</Color>
    <Color x:Key="Error">#7f231b</Color>
    <Color x:Key="ErrorLight">#eddbd7</Color>
    <Color x:Key="Info">#5a4a72</Color>
    <Color x:Key="InfoLight">#e6e1ed</Color>

    <!-- 灰度色（暖调纸灰，非冷灰） -->
    <Color x:Key="White">#ffffff</Color>
    <Color x:Key="Black">#171310</Color>
    <Color x:Key="Gray50">#faf7f1</Color>
    <Color x:Key="Gray100">#f2ece1</Color>
    <Color x:Key="Gray200">#e9e1d1</Color>
    <Color x:Key="Gray300">#dfd5c2</Color>
    <Color x:Key="Gray400">#c4b8a2</Color>
    <Color x:Key="Gray500">#8b7f6c</Color>
    <Color x:Key="Gray600">#6d6354</Color>
    <Color x:Key="Gray700">#4c4237</Color>
    <Color x:Key="Gray800">#322b24</Color>
    <Color x:Key="Gray900">#171310</Color>

    <!-- 阴影色 -->
    <Color x:Key="ShadowLight">#10171310</Color>
    <Color x:Key="ShadowMedium">#20171310</Color>
    <Color x:Key="ShadowDark">#30171310</Color>

    <!-- 侧边栏颜色（墨黑系） -->
    <Color x:Key="SidebarBackground">#171310</Color>
    <Color x:Key="SidebarItemSelected">#ab3227</Color>
    <Color x:Key="SidebarItemUnselected">#a89a85</Color>
    <Color x:Key="SidebarItemHover">#2b241e</Color>

    <!-- 统计卡片渐变颜色（收敛为朱砂 / 松绿 / 赭金 / 墨） -->
    <Color x:Key="StatCardBlueStart">#ab3227</Color>
    <Color x:Key="StatCardBlueEnd">#7f231b</Color>
    <Color x:Key="StatCardGreenStart">#2e4738</Color>
    <Color x:Key="StatCardGreenEnd">#22352a</Color>
    <Color x:Key="StatCardOrangeStart">#96681c</Color>
    <Color x:Key="StatCardOrangeEnd">#7a5315</Color>
    <Color x:Key="StatCardPurpleStart">#4c4237</Color>
    <Color x:Key="StatCardPurpleEnd">#322b24</Color>

    <!-- 功能模块颜色 -->
    <Color x:Key="ModuleSocialAssistance">#ab3227</Color>
    <Color x:Key="ModuleElderly">#5a4a72</Color>
    <Color x:Key="ModuleAssetVerification">#96681c</Color>
    <Color x:Key="ModuleArchive">#2e4738</Color>
    <Color x:Key="ModuleDatabase">#6d6354</Color>
    <Color x:Key="ModuleUser">#7f231b</Color>

    <!-- 状态栏颜色 -->
    <Color x:Key="StatusBarBackground">#f2ece1</Color>
    <Color x:Key="TopBarBackground">#f8f3e9</Color>

    <!-- 其他 -->
    <Color x:Key="CardOptionBackground">#f8f3e9</Color>

    <!-- 交互态（悬停/按下/焦点/柔和底色）——设计系统 v2 -->
    <Color x:Key="PrimaryHover">#8f2a20</Color>
    <Color x:Key="PrimaryPressed">#7f231b</Color>
    <Color x:Key="PrimarySoft">#f2dcd9</Color>
    <Color x:Key="SecondaryHover">#3a5745</Color>
    <Color x:Key="DangerHover">#8f2a20</Color>
    <Color x:Key="DangerSoft">#f2dcd9</Color>
    <Color x:Key="SuccessSoft">#e3e9e4</Color>
    <Color x:Key="WarningSoft">#f3e6cf</Color>
    <Color x:Key="InfoSoft">#e6e1ed</Color>
    <Color x:Key="HoverOverlay">#ebe4d7</Color>
    <Color x:Key="FocusRing">#ab3227</Color>
    <Color x:Key="DisabledBackground">#e9e1d1</Color>
    <Color x:Key="DisabledText">#a89a85</Color>

    <!-- ═══ 纸墨档案风 · 专用令牌（新增，不影响既有键） ═══ -->
    <!-- 纸底三层 -->
    <Color x:Key="Paper">#f2ece1</Color>
    <Color x:Key="Paper2">#e9e1d1</Color>
    <Color x:Key="Paper3">#dfd5c2</Color>
    <!-- 墨色 -->
    <Color x:Key="Ink">#171310</Color>
    <Color x:Key="Ink2">#4c4237</Color>
    <Color x:Key="Muted">#8b7f6c</Color>
    <!-- 朱砂 / 松绿 / 赭金 -->
    <Color x:Key="Seal">#ab3227</Color>
    <Color x:Key="SealDark">#7f231b</Color>
    <Color x:Key="Pine">#2e4738</Color>
    <Color x:Key="Amber">#96681c</Color>
    <!-- 发丝线（半透明墨，随背景走） -->
    <Color x:Key="Line">#29171310</Color>
    <Color x:Key="LineStrong">#52171310</Color>

    <!-- ═══ 渐变色 ═══ -->
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource PrimaryGradientStart}" Offset="0"/>
        <GradientStop Color="{StaticResource PrimaryGradientEnd}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2e4738" Offset="0"/>
        <GradientStop Color="#4a6b56" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#ab3227" Offset="0"/>
        <GradientStop Color="#c9483c" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#171310" Offset="0"/>
        <GradientStop Color="#322b24" Offset="1"/>
    </LinearGradientBrush>

    <!-- 统计卡片渐变 -->
    <LinearGradientBrush x:Key="StatCardBlueGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource StatCardBlueStart}" Offset="0"/>
        <GradientStop Color="{StaticResource StatCardBlueEnd}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StatCardGreenGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource StatCardGreenStart}" Offset="0"/>
        <GradientStop Color="{StaticResource StatCardGreenEnd}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StatCardOrangeGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource StatCardOrangeStart}" Offset="0"/>
        <GradientStop Color="{StaticResource StatCardOrangeEnd}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="StatCardPurpleGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource StatCardPurpleStart}" Offset="0"/>
        <GradientStop Color="{StaticResource StatCardPurpleEnd}" Offset="1"/>
    </LinearGradientBrush>

    <!-- 收入类型标签颜色 -->
    <Color x:Key="IncomeLaborBg">#e6e1ed</Color>
    <Color x:Key="IncomeLaborText">#4a3d63</Color>
    <Color x:Key="IncomeBusinessBg">#e3e9e4</Color>
    <Color x:Key="IncomeBusinessText">#2e4738</Color>
    <Color x:Key="IncomePropertyBg">#f3e6cf</Color>
    <Color x:Key="IncomePropertyText">#7a5315</Color>
    <Color x:Key="IncomeTransferBg">#e6e1ed</Color>
    <Color x:Key="IncomeTransferText">#4a3d63</Color>
    <Color x:Key="IncomeOtherBg">#f2dcd9</Color>
    <Color x:Key="IncomeOtherText">#7f231b</Color>

</ResourceDictionary>
