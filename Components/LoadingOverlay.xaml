<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewCosmos.Components.LoadingOverlay"
             x:Name="RootOverlay"
             IsVisible="{Binding IsLoading, Source={x:Reference RootOverlay}}"
             BackgroundColor="#80000000"
             HorizontalOptions="Fill"
             VerticalOptions="Fill"
             InputTransparent="False"
             ZIndex="999">

    <!-- 加载卡片宽度 280→320：原 Padding 32×2=64 使文字可用宽仅 216px，
         叠加全局字号+2 与加粗后，加载文案必溢出；改 320/24 后可用宽 272px，
         且 Label 允许换行兜底（LineBreakMode=WordWrap），任何长度文案都不越界。 -->
    <Grid VerticalOptions="Center" HorizontalOptions="Center"
          WidthRequest="320">

        <!-- 纸墨档案卡片：纸底 + 发丝线描边 + 近直角（原为白底/圆角16/重阴影，与全站风格不符） -->
        <Border Padding="24,20"
                StrokeShape="{StaticResource ShapeMedium}"
                BackgroundColor="{StaticResource CardBackground}"
                Stroke="{StaticResource Line}"
                StrokeThickness="1">
            <Border.Shadow>
                <Shadow Brush="#40000000" Offset="0,3" Radius="10" Opacity="0.12"/>
            </Border.Shadow>

            <VerticalStackLayout Spacing="20" HorizontalOptions="Center">

                <!-- 动画圆环 -->
                <Grid WidthRequest="64" HeightRequest="64" HorizontalOptions="Center">
                    <!-- 外圈（RoundRectangle 32 = 64 的一半，本意是画正圆，非装饰圆角，须保留） -->
                    <Border WidthRequest="64" HeightRequest="64"
                            StrokeShape="RoundRectangle 32"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="4"
                            BackgroundColor="Transparent"/>

                    <!-- 中心图标（原生进度环，跨平台安全；原 Segoe 字符在 Android 显示为方块） -->
                    <ActivityIndicator IsRunning="True"
                                       Color="{StaticResource Primary}"
                                       WidthRequest="36" HeightRequest="36"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"/>
                </Grid>

                <!-- 加载文字（WordWrap 兜底：超宽自动换行，杜绝字符越界） -->
                <Label x:Name="LoadingTextLabel"
                       Text="{Binding LoadingText, Source={x:Reference RootOverlay}}"
                       FontSize="{OnPlatform WinUI=18, Android=14, Default=18}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"
                       LineBreakMode="WordWrap"
                       HorizontalTextAlignment="Center"
                       HorizontalOptions="Center"
                       WidthRequest="272"/>

                <!-- 进度条（可选） -->
                <Grid IsVisible="{Binding ShowProgress, Source={x:Reference RootOverlay}}" HeightRequest="6">
                    <ProgressBar Progress="{Binding Progress, Source={x:Reference RootOverlay}}"
                                 ProgressColor="{StaticResource Primary}"
                                 HeightRequest="6"/>
                </Grid>

                <!-- 进度百分比（可选） -->
                <Label IsVisible="{Binding ShowProgress, Source={x:Reference RootOverlay}}"
                       FontSize="{OnPlatform WinUI=16, Android=13, Default=16}"
                       TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center">
                    <Label.Text>
                        <Binding Path="Progress, Source={x:Reference RootOverlay}" StringFormat="{}{0:P0}"/>
                    </Label.Text>
                </Label>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
