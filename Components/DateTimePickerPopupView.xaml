<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Components.DateTimePickerPopupView"
             x:Name="ThisView">

    <Border BackgroundColor="White"
            Stroke="#E5E7EB"
            StrokeShape="RoundRectangle 12"
            Padding="0"
            MinimumWidthRequest="360"
            MaximumWidthRequest="480">
        <VerticalStackLayout Spacing="0">

            <!-- 标题 -->
            <Label x:Name="TitleLabel"
                   Text="选择日期与时间"
                   FontSize="{OnPlatform WinUI=17, Android=15, Default=17}"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   Margin="20,16,20,4"/>

            <Label x:Name="SubtitleLabel"
                   Text="日期不能晚于当前时间"
                   FontSize="{OnPlatform WinUI=14, Android=12, Default=14}"
                   TextColor="{StaticResource TextTertiary}"
                   Margin="20,0,20,12"/>

            <BoxView HeightRequest="1" Color="#E5E7EB"/>

            <!-- 选择区 -->
            <VerticalStackLayout Spacing="10" Padding="20,16">

                <Label Text="日期" FontSize="{OnPlatform WinUI=15, Android=13, Default=15}" TextColor="{StaticResource TextSecondary}"/>
                <DatePicker x:Name="DatePickerControl"
                            Format="yyyy-MM-dd"
                            HeightRequest="44"/>

                <VerticalStackLayout Spacing="8" x:Name="TimeSection">
                    <Label Text="时间" FontSize="{OnPlatform WinUI=15, Android=13, Default=15}" TextColor="{StaticResource TextSecondary}"/>
                    <TimePicker x:Name="TimePickerControl"
                                Format="HH:mm"
                                HeightRequest="44"/>
                </VerticalStackLayout>

                <!-- 快捷选择（多数场景一键完成，免碰 spinner） -->
                <HorizontalStackLayout Spacing="8" x:Name="QuickRow">
                    <Border Style="{StaticResource ChipNeutral}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTodayClicked"/>
                        </Border.GestureRecognizers>
                        <Label Text="今天" Style="{StaticResource ChipNeutralText}"/>
                    </Border>
                    <Border Style="{StaticResource ChipNeutral}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnYesterdayClicked"/>
                        </Border.GestureRecognizers>
                        <Label Text="昨天" Style="{StaticResource ChipNeutralText}"/>
                    </Border>
                    <Border Style="{StaticResource ChipNeutral}" x:Name="NowChip">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNowClicked"/>
                        </Border.GestureRecognizers>
                        <Label Text="此刻" Style="{StaticResource ChipNeutralText}"/>
                    </Border>
                </HorizontalStackLayout>

                <!-- 校验错误（未来时刻拦截提示） -->
                <Label x:Name="ErrorLabel"
                       Text=""
                       FontSize="{OnPlatform WinUI=14, Android=12, Default=14}"
                       TextColor="{StaticResource Error}"
                       IsVisible="False"/>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="#E5E7EB"/>

            <!-- 操作按钮 -->
            <Grid Padding="20,14" ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="取消"
                        Style="{StaticResource ButtonOutline}"
                        Clicked="OnCancelClicked"/>
                <Button Grid.Column="1"
                        Text="确定"
                        Style="{StaticResource ButtonPrimary}"
                        Clicked="OnConfirmClicked"/>
            </Grid>

        </VerticalStackLayout>
    </Border>
</ContentView>
