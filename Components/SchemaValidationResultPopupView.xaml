<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Components.SchemaValidationResultPopupView"
             x:Name="ThisView">

    <ContentView.Resources>
        <ResourceDictionary>
            <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
            
            <Style x:Key="PopupFrameStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="Stroke" Value="#E5E7EB"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="MinimumWidthRequest" Value="600"/>
                <Setter Property="MaximumWidthRequest" Value="800"/>
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="Black" Offset="0,4" Radius="16" Opacity="0.15"/>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </ContentView.Resources>

    <Border Style="{StaticResource PopupFrameStyle}">
        <VerticalStackLayout Spacing="0">
            <!-- 标题栏 -->
            <Grid Padding="20,16" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="表结构检查报告"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextPrimary}"/>

                <Button Grid.Column="1"
                        Text="&#xE711;"
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        TextColor="#9CA3AF"
                        BackgroundColor="Transparent"
                        WidthRequest="32"
                        HeightRequest="32"
                        CornerRadius="16"
                        Command="{Binding CloseCommand, Source={x:Reference ThisView}}"/>
            </Grid>

            <BoxView HeightRequest="1" Color="#E5E7EB"/>

            <!-- 摘要信息 -->
            <Grid Padding="20,16" RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                <Label Grid.Row="0" Grid.Column="0"
                       Text="{Binding ValidationResult.CheckedAt, StringFormat='检查时间: {0:yyyy-MM-dd HH:mm:ss}', Source={x:Reference ThisView}}"
                       FontSize="14" TextColor="{StaticResource TextSecondary}"/>

                <Label Grid.Row="0" Grid.Column="1"
                       Text="{Binding ValidationResult.TotalSchemas, StringFormat='检查范围: {0} 个 Schema', Source={x:Reference ThisView}}"
                       FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalOptions="End"/>

                <Label Grid.Row="1" Grid.Column="0"
                       Text="{Binding ValidationResult.TotalTablesInYaml, StringFormat='YAML定义: {0} 张表', Source={x:Reference ThisView}}"
                       FontSize="14" TextColor="{StaticResource TextSecondary}"/>

                <Label Grid.Row="1" Grid.Column="1"
                       Text="{Binding ValidationResult.TotalTablesInDatabase, StringFormat='数据库实际: {0} 张表', Source={x:Reference ThisView}}"
                       FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalOptions="End"/>
            </Grid>

            <!-- 结果统计 -->
            <Grid Padding="20,12" ColumnDefinitions="*,*,*" BackgroundColor="#F9FAFB">
                <Border Grid.Column="0" BackgroundColor="#FEE2E2" StrokeShape="RoundRectangle 8" Padding="12,8">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="🔴" FontSize="18"/>
                        <Label Text="{Binding ValidationResult.ErrorCount, Source={x:Reference ThisView}}"
                               FontSize="14" FontAttributes="Bold" TextColor="#DC2626"/>
                        <Label Text="错误" FontSize="16" TextColor="#DC2626"/>
                    </HorizontalStackLayout>
                </Border>

                <Border Grid.Column="1" BackgroundColor="#FEF3C7" StrokeShape="RoundRectangle 8" Padding="12,8" Margin="12,0">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="🟡" FontSize="18"/>
                        <Label Text="{Binding ValidationResult.WarningCount, Source={x:Reference ThisView}}"
                               FontSize="14" FontAttributes="Bold" TextColor="#D97706"/>
                        <Label Text="警告" FontSize="16" TextColor="#D97706"/>
                    </HorizontalStackLayout>
                </Border>

                <Border Grid.Column="2" BackgroundColor="#DBEAFE" StrokeShape="RoundRectangle 8" Padding="12,8">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="🔵" FontSize="18"/>
                        <Label Text="{Binding ValidationResult.InfoCount, Source={x:Reference ThisView}}"
                               FontSize="14" FontAttributes="Bold" TextColor="#2563EB"/>
                        <Label Text="提示" FontSize="16" TextColor="#2563EB"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,8,0,0"/>

            <!-- 差异列表 -->
            <CollectionView ItemsSource="{Binding ValidationResult.Differences, Source={x:Reference ThisView}}"
                           HeightRequest="350" Margin="20,12">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40" Spacing="8">
                        <Label Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="48"
                               TextColor="#10B981" HorizontalOptions="Center"/>
                        <Label Text="检查通过，所有表结构与 YAML 定义一致"
                               FontSize="18" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{StaticResource Gray50}" StrokeShape="RoundRectangle 8" Padding="12" Margin="0,0,0,8">
                            <VerticalStackLayout Spacing="6">
                                <!-- 标题行 -->
                                <Grid ColumnDefinitions="Auto,Auto,*">
                                    <Label Grid.Column="0" Text="{Binding SeverityIcon}" FontSize="16" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding TypeText}" FontSize="14" FontAttributes="Bold"
                                           TextColor="{Binding SeverityColor}" VerticalOptions="Center" Margin="6,0,0,0"/>
                                    <Label Grid.Column="2" Text="{Binding TableName}" FontSize="16" FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" HorizontalOptions="End"/>
                                </Grid>

                                <!-- 详情 -->
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="20,0,0,0">
                                    <Label Grid.Row="0" Grid.Column="0" Text="数据库: " FontSize="14" TextColor="{StaticResource TextTertiary}"/>
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Database}" FontSize="14" TextColor="{StaticResource TextSecondary}"/>

                                    <Label Grid.Row="1" Grid.Column="0" Text="列名: " FontSize="14" TextColor="{StaticResource TextTertiary}"
                                           IsVisible="{Binding ColumnName, Converter={StaticResource StringNotEmptyConverter}}"/>
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding ColumnName}" FontSize="14" TextColor="{StaticResource TextSecondary}"
                                           IsVisible="{Binding ColumnName, Converter={StaticResource StringNotEmptyConverter}}"/>

                                    <Label Grid.Row="2" Grid.Column="0" Text="描述: " FontSize="14" TextColor="{StaticResource TextTertiary}"/>
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding Description}" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                </Grid>

                                <!-- 期望值/实际值 -->
                                <Grid ColumnDefinitions="*,*" Margin="20,0,0,0">
                                    <Border BackgroundColor="#F0FDF4" StrokeShape="RoundRectangle 4" Padding="8,4">
                                        <Label Text="{Binding Expected, StringFormat='YAML: {0}'}" FontSize="14"
                                               TextColor="#166534" LineBreakMode="TailTruncation"/>
                                    </Border>
                                    <Border Grid.Column="1" BackgroundColor="#FEF2F2" StrokeShape="RoundRectangle 4" Padding="8,4" Margin="8,0,0,0">
                                        <Label Text="{Binding Actual, StringFormat='实际: {0}'}" FontSize="14"
                                               TextColor="#991B1B" LineBreakMode="TailTruncation"/>
                                    </Border>
                                </Grid>

                                <!-- 建议 -->
                                <Label Text="{Binding Suggestion}" FontSize="14" TextColor="#6B7280"
                                       LineBreakMode="TailTruncation" Margin="20,4,0,0" MaxLines="2"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" Color="#E5E7EB"/>

            <!-- 底部按钮 -->
            <Grid Padding="20,16" ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                <Button Grid.Column="0" Text="&#xE8C7; 修复错误和警告" FontFamily="Segoe Fluent Icons"
                        Style="{StaticResource WarningButton}" 
                        Command="{Binding FixSchemaErrorsCommand, Source={x:Reference ThisView}}"
                        IsVisible="{Binding HasFixableIssues, Source={x:Reference ThisView}}"/>

                <Button Grid.Column="1" Text="&#xE72C; 刷新" FontFamily="Segoe Fluent Icons"
                        Style="{StaticResource ButtonOutline}" 
                        Command="{Binding RefreshCommand, Source={x:Reference ThisView}}"
                        Margin="12,0,0,0"/>

                <Button Grid.Column="2" Text="&#xE896; 导出报告" FontFamily="Segoe Fluent Icons"
                        Style="{StaticResource ButtonOutline}" Command="{Binding ExportCommand, Source={x:Reference ThisView}}"
                        Margin="12,0,0,0"/>

                <Button Grid.Column="4" Text="关闭" Style="{StaticResource ButtonPrimary}"
                        Command="{Binding CloseCommand, Source={x:Reference ThisView}}"/>
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
