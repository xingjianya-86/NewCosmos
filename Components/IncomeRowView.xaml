<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Components.IncomeRowView"
             x:Name="Root">

    <!-- 收入明细行共享模板（2026-11 表单模板收敛：原 Step3 五类收入逐行重复 ~40 行 ×5 收敛至此）。
         用法（DataTemplate 内，外层 x:DataType 仍是实体类型）：
           <components:IncomeRowView
               ShowMember="True" MemberItems="{Binding BindingContext.IncomeMemberOptions, Source={x:Reference StepRoot}}"
               SelectedMember="{Binding SelectedIncomeMember, Mode=TwoWay}"
               ShowSubType="True" SubTypeItems="{Binding BindingContext.LaborSubTypeOptions, Source={x:Reference StepRoot}}"
               SubType="{Binding IncomeSubType, Mode=TwoWay}"
               ShowDescription="True" Description="{Binding WorkUnit, Mode=TwoWay}"
               DescriptionPlaceholder="{x:Static constants:UIConstants.WORK_UNIT_PLACEHOLDER}"
               Amount="{Binding MonthlyIncome, Mode=TwoWay}"
               IsEditable="{Binding BindingContext.IsEconomyEditable, Source={x:Reference StepRoot}}"
               RemoveCommand="{Binding BindingContext.RemoveLaborIncomeCommand, Source={x:Reference StepRoot}}"
               RemoveParameter="{Binding .}"/>
         可选行（成员/子类型/描述）由 Show* 开关控制，隐藏行在 Grid 中塌缩为 0 高度。
         Amount 为 string 型 BP：Entry.Text↔string↔实体 decimal 的两段转换与原
         Entry.Text↔decimal 直连同走 TypeConverter，语义一致（清空→null/保持不变同原）。 -->
    <Border Padding="8" Margin="2" StrokeShape="RoundRectangle 6"
            BackgroundColor="{StaticResource Gray50}" Stroke="{StaticResource Gray200}" StrokeThickness="1">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="4" RowSpacing="4">

            <!-- 行0：成员 Picker（ShowMember） -->
            <Picker x:Name="MemberPicker"
                    ItemsSource="{Binding MemberItems, Source={x:Reference Root}}"
                    SelectedItem="{Binding SelectedMember, Source={x:Reference Root}, Mode=TwoWay}"
                    ItemDisplayBinding="{Binding Name}"
                    FontSize="17" HeightRequest="38"
                    IsVisible="{Binding ShowMember, Source={x:Reference Root}}"
                    IsEnabled="{Binding IsEditable, Source={x:Reference Root}}"/>

            <!-- 行1：子类型 Picker（ShowSubType） -->
            <Picker x:Name="SubTypePicker" Grid.Row="1"
                    ItemsSource="{Binding SubTypeItems, Source={x:Reference Root}}"
                    SelectedItem="{Binding SubType, Source={x:Reference Root}, Mode=TwoWay}"
                    FontSize="17" HeightRequest="36"
                    VerticalOptions="Center"
                    IsVisible="{Binding ShowSubType, Source={x:Reference Root}}"
                    IsEnabled="{Binding IsEditable, Source={x:Reference Root}}"/>

            <!-- 行2：描述 Entry（ShowDescription） -->
            <Entry x:Name="DescriptionEntry" Grid.Row="2"
                   Text="{Binding Description, Source={x:Reference Root}, Mode=TwoWay}"
                   FontSize="17"
                   Placeholder="{Binding DescriptionPlaceholder, Source={x:Reference Root}}"
                   VerticalOptions="Center"
                   IsVisible="{Binding ShowDescription, Source={x:Reference Root}}"
                   IsEnabled="{Binding IsEditable, Source={x:Reference Root}}"/>

            <!-- 行3：月收入（恒显） -->
            <Grid Grid.Row="3" Grid.Column="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <Label Text="月收入" FontSize="16" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}"/>
                <Entry Grid.Column="1" Text="{Binding Amount, Source={x:Reference Root}, Mode=TwoWay}"
                       FontSize="17" Keyboard="Numeric"
                       VerticalOptions="Center"
                       IsEnabled="{Binding IsEditable, Source={x:Reference Root}}"/>
                <Label Grid.Column="2" Text="{x:Static constants:UIConstants.YUAN_PER_MONTH}" FontSize="16"
                       VerticalOptions="Center" TextColor="{StaticResource TextSecondary}"/>
            </Grid>

            <!-- 删除（RowSpan 覆盖 4 行；隐藏行塌缩后视觉居中同原逐类模板） -->
            <Button Grid.RowSpan="4" Grid.Column="1"
                    Text="{OnPlatform WinUI='&#xE74D;', Android='&#x1F5D1;&#xFE0F;'}"
                    FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}"
                    FontSize="18" BackgroundColor="{StaticResource ErrorLight}"
                    TextColor="{StaticResource Error}" WidthRequest="28" HeightRequest="28"
                    Padding="0" CornerRadius="14" VerticalOptions="Center"
                    Command="{Binding RemoveCommand, Source={x:Reference Root}}"
                    CommandParameter="{Binding RemoveParameter, Source={x:Reference Root}}"
                    IsVisible="{Binding IsEditable, Source={x:Reference Root}}"/>
        </Grid>
    </Border>
</ContentView>
