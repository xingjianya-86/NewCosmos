<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Components.BackButton"
             x:Name="Root">

    <!-- 全库统一的页面返回入口：
         图标 E72B + Segoe Fluent Icons；Text 非空时显示文字；IconColor 适配深浅背景。
         用法：<components:BackButton Command="{Binding GoBackCommand}"/>
               <components:BackButton Text="返回列表" Command="{Binding GoBackCommand}"/>
               <components:BackButton IconColor="White" Command="{Binding GoBackCommand}"/> -->
    <HorizontalStackLayout x:Name="Host" Spacing="6">
        <HorizontalStackLayout.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Command, Source={x:Reference Root}}"/>
        </HorizontalStackLayout.GestureRecognizers>
        <Label x:Name="IconLabel" Text="{OnPlatform WinUI='&#xE72B;', Android='&#x2190;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16"
               TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
        <Label x:Name="TextLabel" FontSize="14"
               TextColor="{StaticResource Primary}" VerticalOptions="Center" IsVisible="False"/>
    </HorizontalStackLayout>
</ContentView>
