<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Components.SignaturePopupView"
             x:Name="ThisView">

    <Border BackgroundColor="White"
            Stroke="#E5E7EB"
            StrokeShape="RoundRectangle 12"
            Padding="0"
            MinimumWidthRequest="420"
            MaximumWidthRequest="720">
        <VerticalStackLayout Spacing="0">

            <!-- 标题 -->
            <Label x:Name="PromptLabel"
                   Text="请本人签名"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   Margin="20,16,20,4"/>

            <Label Text="请在下方签字框内书写签名"
                   FontSize="12"
                   TextColor="{StaticResource TextTertiary}"
                   Margin="20,0,20,12"/>

            <BoxView HeightRequest="1" Color="#E5E7EB"/>

            <!-- 签名板 -->
            <Border Margin="20,16"
                    BackgroundColor="White"
                    Stroke="#94A3B8"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="0"
                    HeightRequest="200">
                <controls:SignatureCaptureView x:Name="CaptureView"/>
            </Border>

            <BoxView HeightRequest="1" Color="#E5E7EB"/>

            <!-- 操作按钮 -->
            <Grid Padding="20,14" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <Button Grid.Column="0"
                        Text="重签"
                        Style="{StaticResource ButtonOutline}"
                        Clicked="OnClearClicked"/>

                <Button Grid.Column="2"
                        Text="取消"
                        Style="{StaticResource ButtonOutline}"
                        Clicked="OnCancelClicked"/>

                <Button Grid.Column="3"
                        x:Name="ConfirmButton"
                        Text="确认签名"
                        Style="{StaticResource ButtonPrimary}"
                        IsEnabled="False"
                        Clicked="OnConfirmClicked"/>
            </Grid>

        </VerticalStackLayout>
    </Border>
</ContentView>
