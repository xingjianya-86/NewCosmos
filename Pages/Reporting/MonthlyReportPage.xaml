<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NewCosmos.Controls"
             x:Class="NewCosmos.Pages.Reporting.MonthlyReportPage"
             x:DataType="MonthlyReportMainViewModel"
             Title="月报表"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <DataTemplate x:Key="MonthlyReportEvenRow" x:DataType="MonthlyFormOption">
            <Grid ColumnDefinitions="Auto,*" Padding="4,2" BackgroundColor="White">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Center" Scale="0.9"/>
                <Label Grid.Column="1" Text="{Binding Label}" FontSize="14" VerticalOptions="Center"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MonthlyReportOddRow" x:DataType="MonthlyFormOption">
            <Grid ColumnDefinitions="Auto,*" Padding="4,2" BackgroundColor="#F8F9FA">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalOptions="Center" Scale="0.9"/>
                <Label Grid.Column="1" Text="{Binding Label}" FontSize="14" VerticalOptions="Center"/>
            </Grid>
        </DataTemplate>
        <converters:AlternatingRowTemplateSelector x:Key="MonthlyReportRowSelector"
            EvenTemplate="{StaticResource MonthlyReportEvenRow}"
            OddTemplate="{StaticResource MonthlyReportOddRow}"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- 渐变英雄头部（蓝色） -->
        <Border Grid.Row="0" Style="{StaticResource ModuleHeroHeader}" Background="{StaticResource StatCardBlueGradient}">
            <VerticalStackLayout Spacing="16">

                <!-- 返回行 -->
                <HorizontalStackLayout Spacing="6">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="{OnPlatform WinUI='&#xE72B;', Android='&#x2190;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="14" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                    <Label Text="返回工作台" FontSize="13" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- 标题与副标题 -->
                <HorizontalStackLayout Spacing="14">
                    <Border WidthRequest="52" HeightRequest="52" BackgroundColor="#33FFFFFF" StrokeShape="RoundRectangle 14">
                        <Label Text="{OnPlatform WinUI='&#xE8EF;', Android='&#x1F4CA;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="28" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="救助月报表" Style="{StaticResource ModuleHeroTitle}"/>
                        <Label Text="按月汇总社会救助业务数据" Style="{StaticResource ModuleHeroSubtitle}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="440,*" ColumnSpacing="0">

            <!-- 左侧面板 -->
            <ScrollView Grid.Column="0">
                <VerticalStackLayout Padding="16" Spacing="12">

                    <!-- 统计周期 -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="统计周期" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                            <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="8">
                                <Picker Grid.Column="0" HeightRequest="40" ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}"/>
                                <Label Grid.Column="1" Text="年" FontSize="16" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                <Picker Grid.Column="2" HeightRequest="40" ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedMonth}"/>
                                <Label Grid.Column="3" Text="月" FontSize="16" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            </Grid>
                            <Picker HeightRequest="40" ItemsSource="{Binding TownOptions}" SelectedItem="{Binding SelectedTown}"/>
                            <Label Text="{Binding CycleRangeText}" FontSize="15" TextColor="{StaticResource Primary}"/>
                            <Button Text="刷新数据" Command="{Binding RefreshCommand}" Style="{StaticResource ButtonPrimary}" HeightRequest="40"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 汇总卡片 -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                                <Border Grid.Column="0" Grid.Row="0" BackgroundColor="{StaticResource InfoSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="新增" FontSize="14" TextColor="{StaticResource PrimaryDark}"/>
                                        <Label Text="{Binding AddedCount}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Grid.Row="0" BackgroundColor="{StaticResource WarningSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="停保" FontSize="14" TextColor="{StaticResource WarningDark}"/>
                                        <Label Text="{Binding StoppedCount}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource WarningDark}"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="0" Grid.Row="1" BackgroundColor="{StaticResource SuccessSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="增发" FontSize="14" TextColor="{StaticResource SecondaryDark}"/>
                                        <Label Text="{Binding IncreaseCount}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource SecondaryDark}"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Grid.Row="1" BackgroundColor="{StaticResource DangerSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="减发" FontSize="14" TextColor="{StaticResource Error}"/>
                                        <Label Text="{Binding DecreaseCount}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Error}"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" BackgroundColor="{StaticResource Gray50}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="自然减员" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                        <Label Text="{Binding DeathCount}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                            <Label HorizontalOptions="End" TextColor="{StaticResource TextSecondary}" FontSize="14" Text="{Binding SummaryText}"/>
                            <Label HorizontalOptions="End" TextColor="{StaticResource TextSecondary}" FontSize="14" Text="{Binding TotalAmountText, StringFormat='月保障金合计：{0} 元'}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 表单渲染 -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Text="报表表单" Style="{StaticResource SectionTitleLabel}" Margin="0" VerticalOptions="Center"/>
                                <Button Grid.Column="1" Text="全选" Command="{Binding SelectAllFormsCommand}" Style="{StaticResource ButtonOutline}" HeightRequest="32" FontSize="13"/>
                                <Button Grid.Column="2" Text="清空" Command="{Binding ClearFormSelectionCommand}" Style="{StaticResource ButtonOutline}" HeightRequest="32" FontSize="13"/>
                            </Grid>
                            <Border BackgroundColor="{StaticResource Gray50}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,4">
                                <CollectionView ItemsSource="{Binding Forms}" SelectionMode="None" MaximumHeightRequest="260" ItemTemplate="{StaticResource MonthlyReportRowSelector}">
                                </CollectionView>
                            </Border>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="打印份数" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                <Entry Grid.Column="1" Text="{Binding Copies}" Keyboard="Numeric" WidthRequest="70" HeightRequest="34" HorizontalTextAlignment="Center"/>
                            </Grid>
                            <Button Text="{Binding PreviewSelectedActionText}" Command="{Binding PreviewSelectedCommand}" Style="{StaticResource ButtonPrimary}" HeightRequest="38"/>
                            <Button Text="{Binding PrintSelectedActionText}" Command="{Binding PrintSelectedCommand}" Style="{StaticResource ButtonOutline}" HeightRequest="38"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="{Binding SaveSelectedActionText}" Command="{Binding SaveSelectedCommand}" Style="{StaticResource ButtonSuccess}" HeightRequest="38"/>
                                <Button Grid.Column="1" Text="{Binding SaveAllActionText}" Command="{Binding SaveAllCommand}" Style="{StaticResource ButtonSuccess}" HeightRequest="38"/>
                            </Grid>
                            <Button Text="{Binding OpenOutputFolderActionText}" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource ButtonOutline}" HeightRequest="36" FontSize="13"/>
                        </VerticalStackLayout>
                    </Border>

                    </VerticalStackLayout>
            </ScrollView>

            <!-- 右侧 PDF 预览 -->
            <Grid Grid.Column="1" Margin="16,16,16,16">
                <controls:PdfPreviewView PdfFilePath="{Binding PdfPreviewUrl}" IsVisible="{Binding HasPdfPreview}" VerticalOptions="Fill" HorizontalOptions="Fill"/>
                <Label Text="点击左侧按钮生成报表表单预览"
                       Style="{StaticResource EmptyStateLabel}"
                       IsVisible="{Binding HasPdfPreview, Converter={StaticResource BoolToInverseConverter}}"/>
            </Grid>

        </Grid>

        <!-- 出席/缺席登记弹窗遮罩（含会议记录表单时按需弹出） -->
        <Grid Grid.RowSpan="2" BackgroundColor="#80000000" IsVisible="{Binding IsAttendancePopupVisible}">
            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                    WidthRequest="560" Padding="20,16">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding AttendancePopupTitle}" Style="{StaticResource SectionTitleLabel}" Margin="0" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="{OnPlatform WinUI='&#xE711;', Android='&#x2715;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="14"
                                Command="{Binding CancelAttendanceCommand}" Style="{StaticResource ButtonOutline}"
                                HeightRequest="30" WidthRequest="30" Padding="0"/>
                    </Grid>
                    <Label Text="{Binding AttendanceHistoryText}" FontSize="13" TextColor="{StaticResource TextSecondary}"
                           IsVisible="{Binding HasAttendanceHistory}"/>
                    <Label Text="出席人员（每行一人）" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                    <Border BackgroundColor="{StaticResource Gray50}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="4">
                        <Editor Text="{Binding PopupAttendees}" HeightRequest="120" BackgroundColor="Transparent"
                                Placeholder="请输入本期会议出席人员，每行一人..."/>
                    </Border>
                    <Label Text="缺席人员（每行一人）" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                    <Border BackgroundColor="{StaticResource Gray50}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="4">
                        <Editor Text="{Binding PopupAbsentees}" HeightRequest="100" BackgroundColor="Transparent"
                                Placeholder="请输入本期会议缺席人员，每行一人..."/>
                    </Border>
                    <Label Text="保存后将作为本周期会议记录，并记入历史，供下次生成时回填"
                           FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="取消" Command="{Binding CancelAttendanceCommand}" Style="{StaticResource ButtonOutline}" HeightRequest="38"/>
                        <Button Grid.Column="1" Text="保存并生成" Command="{Binding ConfirmAttendanceCommand}" Style="{StaticResource ButtonPrimary}" HeightRequest="38"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>

</ContentPage>