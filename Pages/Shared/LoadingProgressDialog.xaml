<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Pages.Shared.LoadingProgressDialog"
             x:DataType="LoadingProgressDialogViewModel"
             Title="加载中"
             BackgroundColor="#80000000"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*,Auto,Auto" Padding="24">

        <!-- 中间内容区 -->
        <Grid Grid.Row="0" VerticalOptions="Center">
            <Border Style="{StaticResource CardBorderElevated}"
                    MinimumWidthRequest="360"
                    HorizontalOptions="Center">
                <VerticalStackLayout Spacing="20">

                    <!-- 标题 -->
                    <Label Text="正在加载档案数据..."
                           FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"
                           HorizontalOptions="Center"/>

                    <!-- 进度条 -->
                    <ProgressBar Progress="{Binding Progress}"
                                 ProgressColor="{StaticResource Primary}"
                                 HeightRequest="8"/>

                    <!-- 进度百分比 -->
                    <Label FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center">
                        <Label.Text>
                            <Binding Path="Progress" StringFormat="{}{0:P0}"/>
                        </Label.Text>
                    </Label>

                    <!-- 步骤信息 -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding StepName}" FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center"/>
                        <Label Text="{Binding StepInfo}" FontSize="12" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>

                    <!-- 错误信息 -->
                    <Border Padding="12" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                            BackgroundColor="{StaticResource DangerSoft}"
                            IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}" FontSize="13" TextColor="{StaticResource Error}" HorizontalOptions="Center"/>
                    </Border>

                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <HorizontalStackLayout Grid.Row="2" Spacing="12" HorizontalOptions="Center">
            <Button Text="取消" Style="{StaticResource ButtonOutline}"
                    Command="{Binding CancelCommand}"
                    IsVisible="{Binding CanCancel}" WidthRequest="100"/>
            <Button Text="确定" Style="{StaticResource ButtonPrimary}"
                    Command="{Binding ConfirmCloseCommand}"
                    IsVisible="{Binding HasError}" WidthRequest="100"/>
        </HorizontalStackLayout>

    </Grid>

</ContentPage>
