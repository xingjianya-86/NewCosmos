<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NewCosmos.Controls"
             x:Class="NewCosmos.Pages.Auth.LoginPage"
             x:DataType="LoginViewModel"
             Title="登录"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- 背景层 -->
        <Grid>
            <!-- 背景图片 - 直接绑定当前背景图 -->
            <Image Source="{Binding CurrentBackgroundImage}"
                   Aspect="AspectFill"
                   Opacity="1.0">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ChangeBackgroundCommand}"
                                          NumberOfTapsRequired="1"/>
                </Image.GestureRecognizers>
            </Image>

            <!-- 黑客帝国 0/1 数据流（全屏覆盖，背景图上、内容层下；点击穿透保留背景切换） -->
            <controls:MatrixRainView HorizontalOptions="Fill"
                                     VerticalOptions="Fill"
                                     InputTransparent="True"/>

            <!-- 渐变覆盖层 -->
            <BoxView BackgroundColor="White"
                     Opacity="0.1" />

        </Grid>

        <!-- 内容层 -->
        <ScrollView VerticalOptions="Fill"
                    HorizontalOptions="Fill">
            <Grid RowDefinitions="Auto, *, Auto"
                  Padding="16"
                  RowSpacing="0">

                <!-- 顶部 Logo 区域 - Phone Layout -->
                <VerticalStackLayout Grid.Row="0"
                                    HorizontalOptions="Center"
                                    Margin="0,40,0,0">
                    <VerticalStackLayout.IsVisible>
                        <OnIdiom x:TypeArguments="x:Boolean">
                            <OnIdiom.Phone>True</OnIdiom.Phone>
                            <OnIdiom.Tablet>False</OnIdiom.Tablet>
                            <OnIdiom.Desktop>False</OnIdiom.Desktop>
                        </OnIdiom>
                    </VerticalStackLayout.IsVisible>

                    <!-- Logo 圆形 -->
                    <Border WidthRequest="80"
                            HeightRequest="80"
                            StrokeShape="Ellipse"
                            StrokeThickness="0"
                            BackgroundColor="{StaticResource Primary}"
                            Padding="0"
                            HorizontalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="Black"
                                    Offset="0,4"
                                    Radius="8"
                                    Opacity="0.3" />
                        </Border.Shadow>
                        <Label Text="&#xE80F;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="36"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <Label Text="帝皇权杖δ-me13 社会救助管理系统"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center"
                           Margin="0,16,0,8" />

                    <Label Text="专业的社会救助信息化解决方案"
                           FontSize="16"
                           TextColor="White"
                           Opacity="0.9"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- 登录卡片 - Desktop/Tablet Layout -->
                <Border Grid.Row="1"
                        Style="{StaticResource CardBorderElevated}"
                        Padding="0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                        WidthRequest="420"
                        Margin="80,0,0,0">
                    <Border.IsVisible>
                        <OnIdiom x:TypeArguments="x:Boolean">
                            <OnIdiom.Phone>False</OnIdiom.Phone>
                            <OnIdiom.Tablet>True</OnIdiom.Tablet>
                            <OnIdiom.Desktop>True</OnIdiom.Desktop>
                        </OnIdiom>
                    </Border.IsVisible>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black"
                                Offset="0,8"
                                Radius="16"
                                Opacity="0.25" />
                    </Border.Shadow>

                    <ScrollView>
                        <VerticalStackLayout Spacing="24"
                                           Padding="40,48">

                            <!-- Logo 区域 -->
                            <VerticalStackLayout Spacing="16"
                                                HorizontalOptions="Center">

                                <!-- Logo 圆形 -->
                                <Border WidthRequest="100"
                                        HeightRequest="100"
                                        StrokeShape="Ellipse"
                                        StrokeThickness="0"
                                        Padding="0"
                                        HorizontalOptions="Center">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0"
                                                            EndPoint="1,1">
                                            <GradientStop Color="{StaticResource Primary}"
                                                        Offset="0" />
                                            <GradientStop Color="{StaticResource PrimaryDark}"
                                                        Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Shadow>
                                        <Shadow Brush="Black"
                                                Offset="0,6"
                                                Radius="12"
                                                Opacity="0.3" />
                                    </Border.Shadow>
                                    <Label Text="&#xE80F;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="48"
                                           TextColor="White"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>

                                <!-- 标题 -->
                                <Label Text="帝皇权杖δ-me13"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center" />

                                <!-- 副标题 -->
                                <Label Text="专业的社会救助信息化解决方案"
                                       FontSize="16"
                                       TextColor="{StaticResource TextSecondary}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>

                            <!-- 分隔线 -->
                            <BoxView HeightRequest="1"
                                     BackgroundColor="{StaticResource Gray300}"
                                     Opacity="0.5" />

                            <!-- 登录表单 -->
                            <VerticalStackLayout Spacing="20">

                                <!-- 用户名输入框 -->
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="用户名"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextSecondary}" />
                                    <Grid ColumnDefinitions="Auto, *"
                                          HeightRequest="48">
                                        <Border Grid.Column="0"
                                               WidthRequest="48"
                                               BackgroundColor="{StaticResource Gray100}"
                                               StrokeThickness="0"
                                               Padding="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8,0,0,8" />
                                            </Border.StrokeShape>
                                            <Label Text="&#xE77B;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   TextColor="{StaticResource Primary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <Border Grid.Column="1"
                                               BackgroundColor="{StaticResource Gray100}"
                                               StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="0,8,8,0" />
                                            </Border.StrokeShape>
                                            <Entry Text="{Binding Username}"
                                                   Placeholder="请输入用户名"
                                                   FontSize="18"
                                                   BackgroundColor="Transparent" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- 密码输入框 -->
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="密码"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource TextSecondary}" />
                                    <Grid ColumnDefinitions="Auto, *"
                                          HeightRequest="48">
                                        <Border Grid.Column="0"
                                               WidthRequest="48"
                                               BackgroundColor="{StaticResource Gray100}"
                                               StrokeThickness="0"
                                               Padding="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8,0,0,8" />
                                            </Border.StrokeShape>
                                            <Label Text="&#xE72E;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   TextColor="{StaticResource Primary}"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                        <Border Grid.Column="1"
                                               BackgroundColor="{StaticResource Gray100}"
                                               StrokeThickness="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="0,8,8,0" />
                                            </Border.StrokeShape>
                                            <Entry Text="{Binding Password}"
                                                   Placeholder="请输入密码"
                                                   IsPassword="True"
                                                   FontSize="18"
                                                   BackgroundColor="Transparent"
                                                   ReturnCommand="{Binding LoginCommand}"
                                                   ReturnType="Go" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>

<!-- 记住账号和密码 - 改进版（垂直布局） -->
                                 <VerticalStackLayout Spacing="12">
                                     <!-- 记住账号选项 -->
                                     <Border Padding="12,10"
                                             BackgroundColor="{StaticResource CardOptionBackground}"
                                             StrokeThickness="0"
                                             StrokeShape="RoundRectangle 8">
                                         <Grid ColumnDefinitions="Auto,*"
                                               RowDefinitions="Auto,Auto"
                                               ColumnSpacing="10">
                                             <CheckBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                       IsChecked="{Binding RememberMe}"
                                                       Color="{StaticResource Primary}"
                                                       VerticalOptions="Center" />
                                             <Label Grid.Row="0" Grid.Column="1"
                                                    Text="记住账号"
                                                    FontSize="17"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    VerticalOptions="Center" />
                                             <Label Grid.Row="1" Grid.Column="1"
                                                    Text="下次自动填充用户名"
                                                    FontSize="14"
                                                    TextColor="{StaticResource TextTertiary}"
                                                    VerticalOptions="Center" />
                                         </Grid>
                                     </Border>

                                     <!-- 记住密码选项 -->
                                     <Border Padding="12,10"
                                             BackgroundColor="{StaticResource CardOptionBackground}"
                                             StrokeThickness="0"
                                             StrokeShape="RoundRectangle 8"
                                             IsVisible="{Binding RememberMe}">
                                         <Grid ColumnDefinitions="Auto,*"
                                               RowDefinitions="Auto,Auto"
                                               ColumnSpacing="10">
                                             <CheckBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                       IsChecked="{Binding RememberPassword}"
                                                       Color="{StaticResource Primary}"
                                                       VerticalOptions="Center" />
                                             <Label Grid.Row="0" Grid.Column="1"
                                                    Text="记住密码"
                                                    FontSize="17"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource TextPrimary}"
                                                    VerticalOptions="Center" />
                                             <Label Grid.Row="1" Grid.Column="1"
                                                    Text="下次自动填充密码"
                                                    FontSize="14"
                                                    TextColor="{StaticResource TextTertiary}"
                                                    VerticalOptions="Center" />
                                         </Grid>
                                     </Border>
                                 </VerticalStackLayout>

                                <!-- 错误提示 -->
                                <Label Text="{Binding ErrorMessage}"
                                       TextColor="{StaticResource Error}"
                                       FontSize="16"
                                       IsVisible="{Binding HasError}"
                                       HorizontalOptions="Center"
                                       Margin="0,8" />

                                <!-- 登录按钮 -->
                                <Button Text="登录"
                                        Command="{Binding LoginCommand}"
                                        IsEnabled="{Binding IsNotBusy}"
                                        Style="{StaticResource ButtonPrimary}"
                                        FontSize="20"
                                        HeightRequest="52"
                                        Margin="0,8,0,0" />

                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>
                </Border>

                <!-- 登录卡片 - Phone Layout -->
                <Border Grid.Row="1"
                        Style="{StaticResource CardBorderElevated}"
                        Padding="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        WidthRequest="340">
                    <Border.IsVisible>
                        <OnIdiom x:TypeArguments="x:Boolean">
                            <OnIdiom.Phone>True</OnIdiom.Phone>
                            <OnIdiom.Tablet>False</OnIdiom.Tablet>
                            <OnIdiom.Desktop>False</OnIdiom.Desktop>
                        </OnIdiom>
                    </Border.IsVisible>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="Black"
                                Offset="0,6"
                                Radius="12"
                                Opacity="0.25" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20"
                                        Padding="32,40">

                        <!-- 标题 -->
                        <Label Text="用户登录"
                               FontSize="26"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" />

                        <!-- 副标题 -->
                        <Label Text="欢迎使用 帝皇权杖δ-me13 用户中心"
                               FontSize="16"
                               HorizontalOptions="Center"
                               TextColor="{StaticResource TextSecondary}"
                               Margin="0,0,0,12" />

                        <!-- 用户名输入框 -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="用户名"
                                   FontSize="15"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Entry Text="{Binding Username}"
                                   Placeholder="请输入用户名"
                                   FontSize="18"
                                   HeightRequest="48" />
                        </VerticalStackLayout>

                        <!-- 密码输入框 -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="密码"
                                   FontSize="15"
                                   TextColor="{StaticResource TextSecondary}" />
                            <Entry Text="{Binding Password}"
                                   Placeholder="请输入密码"
                                   IsPassword="True"
                                   FontSize="18"
                                   HeightRequest="48"
                                   ReturnCommand="{Binding LoginCommand}"
                                   ReturnType="Go" />
                        </VerticalStackLayout>

<!-- 记住账号和密码 - 手机版（垂直布局） -->
                         <VerticalStackLayout Spacing="10">
                             <!-- 记住账号选项 -->
                             <Border Padding="10,8"
                                     BackgroundColor="{StaticResource CardOptionBackground}"
                                     StrokeThickness="0"
                                     StrokeShape="RoundRectangle 6">
                                 <Grid ColumnDefinitions="Auto,*"
                                       RowDefinitions="Auto,Auto"
                                       ColumnSpacing="8">
                                     <CheckBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                               IsChecked="{Binding RememberMe}"
                                               Color="{StaticResource Primary}"
                                               VerticalOptions="Center" />
                                     <Label Grid.Row="0" Grid.Column="1"
                                            Text="记住账号"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextPrimary}"
                                            VerticalOptions="Center" />
                                     <Label Grid.Row="1" Grid.Column="1"
                                            Text="下次自动填充用户名"
                                            FontSize="14"
                                            TextColor="{StaticResource TextTertiary}"
                                            VerticalOptions="Center" />
                                 </Grid>
                             </Border>

                             <!-- 记住密码选项 -->
                             <Border Padding="10,8"
                                     BackgroundColor="{StaticResource CardOptionBackground}"
                                     StrokeThickness="0"
                                     StrokeShape="RoundRectangle 6"
                                     IsVisible="{Binding RememberMe}">
                                 <Grid ColumnDefinitions="Auto,*"
                                       RowDefinitions="Auto,Auto"
                                       ColumnSpacing="8">
                                     <CheckBox Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                               IsChecked="{Binding RememberPassword}"
                                               Color="{StaticResource Primary}"
                                               VerticalOptions="Center" />
                                     <Label Grid.Row="0" Grid.Column="1"
                                            Text="记住密码"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            TextColor="{StaticResource TextPrimary}"
                                            VerticalOptions="Center" />
                                     <Label Grid.Row="1" Grid.Column="1"
                                            Text="下次自动填充密码"
                                            FontSize="14"
                                            TextColor="{StaticResource TextTertiary}"
                                            VerticalOptions="Center" />
                                 </Grid>
                             </Border>
                         </VerticalStackLayout>

                        <!-- 错误提示 -->
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource Error}"
                               FontSize="16"
                               IsVisible="{Binding HasError}"
                               HorizontalOptions="Center"
                               Margin="0,6" />

                        <!-- 登录按钮 -->
                        <Button Text="登录"
                                Command="{Binding LoginCommand}"
                                IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource ButtonPrimary}"
                                FontSize="18"
                                HeightRequest="48"
                                Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- 底部版权 -->
                <Label Grid.Row="2"
                       Text="© 2026 帝皇权杖δ-me13 社会救助管理系统 | 技术支持"
                       FontSize="14"
                       TextColor="White"
                       Opacity="0.8"
                       HorizontalOptions="Center"
                       VerticalOptions="End"
                       Margin="0,0,0,24" />
            </Grid>
        </ScrollView>

        <!-- 翁法罗斯 · 永劫回归 · 数据删除特效（全屏半透明背景层，点击穿透保留背景图切换） -->
        <controls:EternalRegressionView x:Name="EternalRegressionEffect"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill"
                                        InputTransparent="True"/>

        <!-- 加载指示器 - 放在最顶层 -->
<components:LoadingOverlay Grid.Row="0" Grid.RowSpan="3" IsLoading="{Binding IsBusy}"
    LoadingText="正在登录..."/>
    </Grid>
</ContentPage>
