<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:uent="clr-namespace:NewCosmos.Models.Entities.UserManagement"
             x:Class="NewCosmos.Pages.UserManagement.UserManagementPage"
             x:DataType="UserManagementViewModel"
             x:Name="MainPageRoot"
             Title="用户管理"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <converters:BoolToInverseConverter x:Key="BoolToInverseConverter"/>
        
        <Style x:Key="EntryStyle" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        
        <Style x:Key="EditorStyle" TargetType="Editor">
            <Setter Property="BackgroundColor" Value="White"/>
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="AutoSize" Value="TextChanges"/>
        </Style>

        <!-- 用户列表交替行色（白 / #F8F9FA） -->
        <DataTemplate x:Key="UserEvenRow" x:DataType="domain:User">
            <Grid Padding="16,12"
                  ColumnDefinitions="60, 2*, 1.5*, 2*, 2*, 1*, Auto"
                  ColumnSpacing="8"
                  BackgroundColor="White">
                <Label Text="{Binding Id}" FontSize="14"
                       TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="{Binding Username}" FontSize="15"
                       FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                       VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                <Label Grid.Column="2" Text="{Binding FullName}" FontSize="14"
                       TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>
                <Label Grid.Column="3" Text="{Binding Phone}" FontSize="14"
                       TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                <Label Grid.Column="4" Text="{Binding OrganizationName}" FontSize="14"
                       TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>
                <Border Grid.Column="5" Padding="10,4" StrokeShape="RoundRectangle 10"
                        BackgroundColor="{Binding IsActive, Converter={StaticResource BoolToColorConverter}}"
                        VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="{Binding IsActive, Converter={StaticResource BoolToTextConverter}, ConverterParameter='激活|停用'}"
                           FontSize="12" FontAttributes="Bold" TextColor="White"/>
                </Border>
                <HorizontalStackLayout Grid.Column="6" Spacing="6" VerticalOptions="Center">
                    <Button Text="&#xE70F;" FontFamily="Segoe Fluent Icons"
                            WidthRequest="32" HeightRequest="32" Padding="0" FontSize="14"
                            BackgroundColor="{StaticResource Info}" TextColor="White"
                            CornerRadius="6"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=EditUserCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding CanBeManaged}"
                            IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=CanEditUser}"/>
                    <Button Text="&#xE74D;" FontFamily="Segoe Fluent Icons"
                            WidthRequest="32" HeightRequest="32" Padding="0" FontSize="14"
                            BackgroundColor="{StaticResource Error}" TextColor="White"
                            CornerRadius="6"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=DeleteUserCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding CanBeManaged}"
                            IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=CanDeleteUser}"/>
                    <Button Text="&#xE17F;" FontFamily="Segoe Fluent Icons"
                            WidthRequest="32" HeightRequest="32" Padding="0" FontSize="14"
                            BackgroundColor="{StaticResource Warning}" TextColor="White"
                            CornerRadius="6"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=ResetPasswordCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=CanResetPassword}"/>
                    <Button Text="&#xE8D7;" FontFamily="Segoe Fluent Icons"
                            WidthRequest="32" HeightRequest="32" Padding="0" FontSize="14"
                            BackgroundColor="{StaticResource Secondary}" TextColor="White"
                            CornerRadius="6"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=ToggleUserStatusCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=CanToggleStatus}"/>
                </HorizontalStackLayout>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="UserOddRow" x:DataType="domain:User">
            <Grid Padding="16,12"
                  ColumnDefinitions="60, 2*, 1.5*, 2*, 2*, 1*, Auto"
                  ColumnSpacing="8"
                  BackgroundColor="#F8F9FA">
                <Label Text="{Binding Id}" FontSize="14"
                       TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="{Binding Username}" FontSize="15"
                       FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                       VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                <Label Grid.Column="2" Text="{Binding FullName}" FontSize="14"
                       TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>
                <Label Grid.Column="3" Text="{Binding Phone}" FontSize="14"
                       TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                <Label Grid.Column="4" Text="{Binding OrganizationName}" FontSize="14"
                       TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>
                <Border Grid.Column="5" Padding="10,4" StrokeShape="RoundRectangle 10"
                        BackgroundColor="{Binding IsActive, Converter={StaticResource BoolToColorConverter}}"
                        VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="{Binding IsActive, Converter={StaticResource BoolToTextConverter}, ConverterParameter='激活|停用'}"
                           FontSize="12" FontAttributes="Bold" TextColor="White"/>
                </Border>
                <HorizontalStackLayout Grid.Column="6" Spacing="6" VerticalOptions="Center">
                    <Button Text="&#xE70F;" FontFamily="Segoe Fluent Icons"
                            WidthRequest="32" HeightRequest="32" Padding="0" FontSize="14"
                            BackgroundColor="{StaticResource Info}" TextColor="White"
                            CornerRadius="6"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=EditUserCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding CanBeManaged}"
                            IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=CanEditUser}"/>
                    <Button Text="&#xE74D;" FontFamily="Segoe Fluent Icons"
                            WidthRequest="32" HeightRequest="32" Padding="0" FontSize="14"
                            BackgroundColor="{StaticResource Error}" TextColor="White"
                            CornerRadius="6"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=DeleteUserCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding CanBeManaged}"
                            IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=CanDeleteUser}"/>
                    <Button Text="&#xE17F;" FontFamily="Segoe Fluent Icons"
                            WidthRequest="32" HeightRequest="32" Padding="0" FontSize="14"
                            BackgroundColor="{StaticResource Warning}" TextColor="White"
                            CornerRadius="6"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=ResetPasswordCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=CanResetPassword}"/>
                    <Button Text="&#xE8D7;" FontFamily="Segoe Fluent Icons"
                            WidthRequest="32" HeightRequest="32" Padding="0" FontSize="14"
                            BackgroundColor="{StaticResource Secondary}" TextColor="White"
                            CornerRadius="6"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=ToggleUserStatusCommand}"
                            CommandParameter="{Binding}"
                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=CanToggleStatus}"/>
                </HorizontalStackLayout>
            </Grid>
        </DataTemplate>

        <converters:AlternatingRowTemplateSelector x:Key="UserRowSelector"
            EvenTemplate="{StaticResource UserEvenRow}"
            OddTemplate="{StaticResource UserOddRow}"/>

        <!-- 角色列表交替行色（白 / #F8F9FA） -->
        <DataTemplate x:Key="RoleEvenRow" x:DataType="uent:Role">
            <Border BackgroundColor="White" Margin="0,4" Padding="16"
                    StrokeShape="RoundRectangle 12" StrokeThickness="1"
                    Stroke="{StaticResource Gray200}">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.08"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <Border Grid.Column="0" WidthRequest="48" HeightRequest="48"
                            BackgroundColor="#EBF5FF" StrokeShape="RoundRectangle 12">
                        <Label Text="&#xE8C7;" FontFamily="Segoe Fluent Icons"
                               FontSize="24" TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Margin="16,0" VerticalOptions="Center" Spacing="4">
                        <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="{Binding Code}" FontSize="14" TextColor="{StaticResource TextTertiary}"/>
                        <Label Text="{Binding Description}" FontSize="14" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{Binding Level, StringFormat='等级: {0}'}"
                           FontSize="14" TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center" Margin="8,0"/>
                    <HorizontalStackLayout Grid.Column="3" Spacing="8" VerticalOptions="Center">
                        <Button Text="&#xE70F; 编辑" FontFamily="Segoe Fluent Icons"
                                Style="{StaticResource ButtonOutline}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=EditRoleCommand}"
                                CommandParameter="{Binding}"
                                Opacity="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=EditRoleOpacity}"/>
                        <Button Text="&#xE74D; 删除" FontFamily="Segoe Fluent Icons"
                                Style="{StaticResource WarningButton}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=DeleteRoleCommand}"
                                CommandParameter="{Binding}"
                                Opacity="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=DeleteRoleOpacity}"/>
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RoleOddRow" x:DataType="uent:Role">
            <Border BackgroundColor="#F8F9FA" Margin="0,4" Padding="16"
                    StrokeShape="RoundRectangle 12" StrokeThickness="1"
                    Stroke="{StaticResource Gray200}">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.08"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                    <Border Grid.Column="0" WidthRequest="48" HeightRequest="48"
                            BackgroundColor="#EBF5FF" StrokeShape="RoundRectangle 12">
                        <Label Text="&#xE8C7;" FontFamily="Segoe Fluent Icons"
                               FontSize="24" TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Margin="16,0" VerticalOptions="Center" Spacing="4">
                        <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="{Binding Code}" FontSize="14" TextColor="{StaticResource TextTertiary}"/>
                        <Label Text="{Binding Description}" FontSize="14" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation"/>
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{Binding Level, StringFormat='等级: {0}'}"
                           FontSize="14" TextColor="{StaticResource TextSecondary}"
                           VerticalOptions="Center" Margin="8,0"/>
                    <HorizontalStackLayout Grid.Column="3" Spacing="8" VerticalOptions="Center">
                        <Button Text="&#xE70F; 编辑" FontFamily="Segoe Fluent Icons"
                                Style="{StaticResource ButtonOutline}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=EditRoleCommand}"
                                CommandParameter="{Binding}"
                                Opacity="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=EditRoleOpacity}"/>
                        <Button Text="&#xE74D; 删除" FontFamily="Segoe Fluent Icons"
                                Style="{StaticResource WarningButton}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=DeleteRoleCommand}"
                                CommandParameter="{Binding}"
                                Opacity="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=DeleteRoleOpacity}"/>
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </DataTemplate>

        <converters:AlternatingRowTemplateSelector x:Key="RoleRowSelector"
            EvenTemplate="{StaticResource RoleEvenRow}"
            OddTemplate="{StaticResource RoleOddRow}"/>

        <!-- 权限分组交替行色（白 / #F8F9FA） -->
        <DataTemplate x:Key="PermGroupEvenRow" x:DataType="PermissionGroupViewModel">
            <Border BackgroundColor="White" Margin="0,4" Padding="16"
                    StrokeShape="RoundRectangle 12" StrokeThickness="1"
                    Stroke="{StaticResource Gray200}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding GroupName}" FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"/>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}"/>
                    <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="PermissionItemViewModel">
                                <HorizontalStackLayout Spacing="2" Margin="2,2" VerticalOptions="Center">
                                    <CheckBox IsChecked="{Binding IsChecked}"
                                              VerticalOptions="Center"
                                              Scale="0.85"
                                              Margin="0"/>
                                    <Label Text="{Binding Name}" FontSize="14" TextColor="{StaticResource TextSecondary}"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Start"
                                           HorizontalOptions="Start"/>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                        <BindableLayout.ItemsSource>
                            <Binding Path="Permissions"/>
                        </BindableLayout.ItemsSource>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PermGroupOddRow" x:DataType="PermissionGroupViewModel">
            <Border BackgroundColor="#F8F9FA" Margin="0,4" Padding="16"
                    StrokeShape="RoundRectangle 12" StrokeThickness="1"
                    Stroke="{StaticResource Gray200}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding GroupName}" FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}"/>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}"/>
                    <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="Start" AlignContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="PermissionItemViewModel">
                                <HorizontalStackLayout Spacing="2" Margin="2,2" VerticalOptions="Center">
                                    <CheckBox IsChecked="{Binding IsChecked}"
                                              VerticalOptions="Center"
                                              Scale="0.85"
                                              Margin="0"/>
                                    <Label Text="{Binding Name}" FontSize="14" TextColor="{StaticResource TextSecondary}"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="Start"
                                           HorizontalOptions="Start"/>
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                        <BindableLayout.ItemsSource>
                            <Binding Path="Permissions"/>
                        </BindableLayout.ItemsSource>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <converters:AlternatingRowTemplateSelector x:Key="PermRowSelector"
            EvenTemplate="{StaticResource PermGroupEvenRow}"
            OddTemplate="{StaticResource PermGroupOddRow}"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        
        <!-- 渐变英雄头部（蓝色） -->
        <Border Grid.Row="0" Style="{StaticResource ModuleHeroHeader}" Background="{StaticResource StatCardBlueGradient}">
            <VerticalStackLayout Spacing="16">

                <!-- 返回行 -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <HorizontalStackLayout Spacing="6">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                        </HorizontalStackLayout.GestureRecognizers>
                        <Label Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="14" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                        <Label Text="返回工作台" FontSize="13" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- 操作按钮 -->
                    <HorizontalStackLayout Grid.Column="2" Spacing="8">
                        <Button Text="&#xE710; 创建用户"
                                FontFamily="Segoe Fluent Icons"
                                BackgroundColor="#33FFFFFF"
                                TextColor="White"
                                FontSize="14"
                                Command="{Binding CreateUserCommand}"
                                VerticalOptions="Center"
                                Padding="16,10"
                                CornerRadius="20"
                                Opacity="{Binding CreateUserOpacity}"
                                IsVisible="{Binding IsUsersTabSelected}"/>
                        <Button Text="&#xE710; 创建角色"
                                FontFamily="Segoe Fluent Icons"
                                BackgroundColor="White"
                                TextColor="{StaticResource Primary}"
                                FontSize="14"
                                FontAttributes="Bold"
                                Command="{Binding CreateRoleCommand}"
                                VerticalOptions="Center"
                                Padding="16,10"
                                CornerRadius="20"
                                Opacity="{Binding CreateRoleOpacity}"
                                IsVisible="{Binding IsRolesTabSelected}"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- 标题与副标题 -->
                <HorizontalStackLayout Spacing="14">
                    <Border WidthRequest="52" HeightRequest="52" BackgroundColor="#33FFFFFF" StrokeShape="RoundRectangle 14">
                        <Label Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="28" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="用户与权限管理" Style="{StaticResource ModuleHeroTitle}"/>
                        <Label Text="管理系统用户、角色与权限分配" Style="{StaticResource ModuleHeroSubtitle}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>

        <!-- 统计栏 -->
        <Grid Grid.Row="1" Padding="20,10" ColumnDefinitions="*,*,*,*" ColumnSpacing="12"
              BackgroundColor="{StaticResource White}">
            <components:StatCapsule Grid.Column="0" IsLight="True" Value="{Binding ActiveUsersText}" Caption="活跃用户（人）"/>
            <components:StatCapsule Grid.Column="1" IsLight="True" Value="{Binding RoleCountText}" Caption="角色总数（个）"/>
            <Grid Grid.Column="2" Grid.ColumnSpan="2"/>
        </Grid>

        <!-- Row 2: Tab 切换栏 -->
        <Border Grid.Row="2" BackgroundColor="White" Padding="20,8" Margin="0,1,0,0">
            <HorizontalStackLayout Spacing="0">
                <Button Text="&#xE77B; 用户管理" FontFamily="Segoe Fluent Icons"
                        Command="{Binding SwitchTabCommand}" CommandParameter="Users"
                        BackgroundColor="{Binding IsUsersTabSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#3B82F6|#F1F5F9'}"
                        TextColor="{Binding IsUsersTabSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='White|#475569'}"
                        CornerRadius="0" Padding="16,8" FontSize="16"/>
                <Button Text="&#xE8C7; 角色管理" FontFamily="Segoe Fluent Icons"
                        Command="{Binding SwitchTabCommand}" CommandParameter="Roles"
                        BackgroundColor="{Binding IsRolesTabSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#3B82F6|#F1F5F9'}"
                        TextColor="{Binding IsRolesTabSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='White|#475569'}"
                        CornerRadius="0" Padding="16,8" FontSize="16"/>
                <Button Text="&#xE9D9; 权限配置" FontFamily="Segoe Fluent Icons"
                        Command="{Binding SwitchTabCommand}" CommandParameter="Permissions"
                        BackgroundColor="{Binding IsPermissionsTabSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#3B82F6|#F1F5F9'}"
                        TextColor="{Binding IsPermissionsTabSelected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='White|#475569'}"
                        CornerRadius="0" Padding="16,8" FontSize="16"/>
            </HorizontalStackLayout>
        </Border>

        <!-- Row 2: 主内容区 -->
        <Grid Grid.Row="3" BackgroundColor="#F1F5F9">
            
            <!-- Tab 1: 用户管理 -->
            <Grid IsVisible="{Binding IsUsersTabSelected}" BackgroundColor="#F1F5F9"
                  RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="24" RowSpacing="16">

                    <!-- 搜索栏 -->
                    <Border Grid.Row="0" BackgroundColor="White" StrokeShape="RoundRectangle 12" Padding="20">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="4" Opacity="0.05"/>
                        </Border.Shadow>
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="12">
                            <Border StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource Gray100}"
                                    Padding="12,6">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Text="&#xE721;" FontFamily="Segoe Fluent Icons"
                                           FontSize="14" TextColor="{StaticResource Gray500}"
                                           VerticalOptions="Center"/>
                                    <Entry Grid.Column="1" Placeholder="搜索用户名/姓名/手机号"
                                           Text="{Binding SearchText}" FontSize="14"
                                           Margin="8,0,0,0" BackgroundColor="Transparent"/>
                                </Grid>
                            </Border>
                            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                <Label Text="状态" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                <Picker ItemsSource="{Binding StatusOptions}"
                                        SelectedItem="{Binding SelectedStatus}"
                                        WidthRequest="80"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                <Label Text="角色" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                <Picker ItemsSource="{Binding RoleFilterOptions}"
                                        SelectedItem="{Binding SelectedRoleFilter}"
                                        ItemDisplayBinding="{Binding Name}"
                                        WidthRequest="100"/>
                            </HorizontalStackLayout>
                            <Button Grid.Column="3" Text="&#xE721; 搜索" FontFamily="Segoe Fluent Icons"
                                    Style="{StaticResource ButtonPrimary}"
                                    HeightRequest="40" Padding="16,0"
                                    Command="{Binding SearchCommand}"/>
                            <Button Grid.Column="4" Text="重置" Style="{StaticResource ButtonOutline}"
                                    HeightRequest="40" Padding="16,0"
                                    Command="{Binding ResetFiltersCommand}"/>
                        </Grid>
                    </Border>
                    
                    <!-- 加载指示器 -->
                    <components:LoadingOverlay Grid.Row="0" Grid.RowSpan="5" IsLoading="{Binding IsBusy}"
                                               LoadingText="正在加载用户..."/>

                    <!-- 错误提示 -->
                    <Border Grid.Row="2" BackgroundColor="#FEF2F2" StrokeShape="RoundRectangle 8"
                            Padding="16" Margin="0,8" IsVisible="{Binding HasError}">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="&#xE783;" FontFamily="Segoe Fluent Icons"
                                   FontSize="16" TextColor="{StaticResource Error}" VerticalOptions="Center"/>
                            <Label Text="{Binding ErrorMessage}" FontSize="14"
                                   TextColor="{StaticResource Error}" VerticalOptions="Center"
                                   LineBreakMode="WordWrap"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- 空状态提示 -->
                    <VerticalStackLayout Grid.Row="3" IsVisible="{Binding HasResults, Converter={StaticResource BoolToInverseConverter}}"
                                         HorizontalOptions="Center" Padding="40" Spacing="12">
                        <Label Text="&#xE77B;" FontFamily="Segoe Fluent Icons"
                               FontSize="48" TextColor="{StaticResource Gray400}"
                               HorizontalOptions="Center"/>
                        <Label Text="暂无用户数据" FontSize="16"
                               TextColor="{StaticResource TextTertiary}"
                               HorizontalOptions="Center"/>
                        <Label Text="点击「创建用户」按钮添加第一个用户" FontSize="14"
                               TextColor="{StaticResource Gray400}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    
                    <!-- 表格 -->
                    <Border Grid.Row="4" IsVisible="{Binding HasResults}" BackgroundColor="White"
                            StrokeShape="RoundRectangle 12" Padding="0" MinimumWidthRequest="850">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.08"/>
                        </Border.Shadow>
                        <Grid RowDefinitions="Auto,Auto,*">
                            
                            <!-- 表头 -->
                            <Grid Grid.Row="0" Style="{StaticResource TableHeader}" Padding="16,14"
                                  ColumnDefinitions="60, 2*, 1.5*, 2*, 2*, 1*, Auto"
                                  ColumnSpacing="8">
                                <Label Text="序号" FontAttributes="Bold" FontSize="14"
                                       TextColor="{StaticResource Gray700}" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="用户名" FontAttributes="Bold" FontSize="14"
                                       TextColor="{StaticResource Gray700}" VerticalOptions="Center"/>
                                <Label Grid.Column="2" Text="姓名" FontAttributes="Bold" FontSize="14"
                                       TextColor="{StaticResource Gray700}" VerticalOptions="Center"/>
                                <Label Grid.Column="3" Text="手机号" FontAttributes="Bold" FontSize="14"
                                       TextColor="{StaticResource Gray700}" VerticalOptions="Center"/>
                                <Label Grid.Column="4" Text="所属组织" FontAttributes="Bold" FontSize="14"
                                       TextColor="{StaticResource Gray700}" VerticalOptions="Center"/>
                                <Label Grid.Column="5" Text="状态" FontAttributes="Bold" FontSize="14"
                                       TextColor="{StaticResource Gray700}" VerticalOptions="Center" HorizontalOptions="Center"/>
                                <Label Grid.Column="6" Text="操作" FontAttributes="Bold" FontSize="14"
                                       TextColor="{StaticResource Gray700}" HorizontalOptions="Center"/>
                            </Grid>
                            
                            <BoxView Grid.Row="1" Grid.ColumnSpan="7" HeightRequest="1"
                                     BackgroundColor="{StaticResource Gray200}"/>
                            
                            <!-- 数据行 (CollectionView 虚拟化) -->
                            <CollectionView Grid.Row="2" x:Name="UserList" ItemsSource="{Binding Users}"
                                 ItemTemplate="{StaticResource UserRowSelector}">
                            </CollectionView>

                        </Grid>
                    </Border>

            </Grid>
            
            <!-- Tab 2: 角色管理 -->
            <ScrollView IsVisible="{Binding IsRolesTabSelected}">
                <VerticalStackLayout Padding="12" Spacing="8">
                    
                    <CollectionView x:Name="RoleList" ItemsSource="{Binding Roles}"
                         ItemTemplate="{StaticResource RoleRowSelector}">
                        <CollectionView.EmptyView>
                            <Label Text="暂无角色数据" FontSize="16" 
                                   TextColor="{StaticResource TextTertiary}"
                                   HorizontalOptions="Center" VerticalOptions="Center" Margin="0,40"/>
                        </CollectionView.EmptyView>
                    </CollectionView>
                    
                </VerticalStackLayout>
            </ScrollView>
            
            <!-- Tab 3: 权限配置 -->
            <ScrollView IsVisible="{Binding IsPermissionsTabSelected}">
                <VerticalStackLayout Padding="12" Spacing="16">
                    
                    <!-- 选择角色 -->
                    <Border BackgroundColor="White" Padding="16" StrokeShape="RoundRectangle 12">
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="选择角色:" FontSize="16" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                            <Picker WidthRequest="200"
                                    ItemsSource="{Binding Roles}"
                                    SelectedItem="{Binding SelectedRoleForPermission}"
                                    ItemDisplayBinding="{Binding Name}"/>
                        </HorizontalStackLayout>
                    </Border>
                    
                    <!-- 权限分组 -->
                    
                    <CollectionView x:Name="PermGroupList" ItemsSource="{Binding PermissionGroups}" IsVisible="{Binding SelectedRoleForPermission, Converter={StaticResource NullToBoolConverter}}"
                         ItemTemplate="{StaticResource PermRowSelector}">
                    </CollectionView>
                    
                </VerticalStackLayout>
            </ScrollView>
            
        </Grid>

        <!-- Row 3: 分页栏（仅用户管理显示） -->
        <Border Grid.Row="4" BackgroundColor="White" Margin="0,1,0,0"
                 IsVisible="{Binding IsUsersTabSelected}">
            <components:PaginationBarView/>
        </Border>

        <!-- 用户编辑抽屉（右侧滑出） -->
        <Border Grid.Row="0" Grid.RowSpan="5" Grid.Column="0"
                BackgroundColor="#80000000" 
                IsVisible="{Binding IsUserEditorVisible}"
                HorizontalOptions="Fill" VerticalOptions="Fill">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding UserEditorViewModel.CancelCommand}"/>
            </Border.GestureRecognizers>
            
            <Border BackgroundColor="White" WidthRequest="400" HorizontalOptions="End"
                    StrokeShape="RoundRectangle 0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer/>
                </Border.GestureRecognizers>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="-4,0" Radius="16" Opacity="0.2"/>
                </Border.Shadow>
                
                <Grid RowDefinitions="Auto,*,Auto">
                    
                    <!-- 抽屉标题 -->
                    <Border Grid.Row="0" BackgroundColor="{StaticResource Primary}" Padding="20,16">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="16" TextColor="White" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding UserEditorViewModel.IsEditMode, Converter={StaticResource BoolToTextConverter}, ConverterParameter='编辑用户|新建用户'}"
                                   FontSize="14" FontAttributes="Bold" TextColor="White" Margin="12,0,0,0" VerticalOptions="Center"/>
                            <Button Grid.Column="2" Text="&#xE711;" FontFamily="Segoe Fluent Icons"
                                    BackgroundColor="Transparent" TextColor="White"
                                    Command="{Binding UserEditorViewModel.CancelCommand}"/>
                        </Grid>
                    </Border>
                    
                    <!-- 抽屉内容 -->
                    <ScrollView Grid.Row="1" Padding="20">
                        <VerticalStackLayout Spacing="16">
                            
                            <Label Text="用户名" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Entry Text="{Binding UserEditorViewModel.Username}" 
                                   Placeholder="请输入用户名"
                                   IsReadOnly="{Binding UserEditorViewModel.IsEditMode}"
                                   Style="{StaticResource EntryStyle}"/>
                            
                            <Label Text="密码" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                                   IsVisible="{Binding UserEditorViewModel.IsEditMode, Converter={StaticResource BoolToInverseConverter}}"/>
                            <Entry Text="{Binding UserEditorViewModel.Password}" 
                                   Placeholder="请输入密码"
                                   IsPassword="True"
                                   IsVisible="{Binding UserEditorViewModel.IsEditMode, Converter={StaticResource BoolToInverseConverter}}"
                                   Style="{StaticResource EntryStyle}"/>
                            
                            <Label Text="姓名" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Entry Text="{Binding UserEditorViewModel.DisplayName}" 
                                   Placeholder="请输入姓名"
                                   Style="{StaticResource EntryStyle}"/>
                            
                            <Label Text="手机号" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Entry Text="{Binding UserEditorViewModel.Phone}" 
                                   Placeholder="请输入手机号"
                                   Keyboard="Telephone"
                                   Style="{StaticResource EntryStyle}"/>
                            
                            <Label Text="身份证号" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Entry Text="{Binding UserEditorViewModel.IdentityCard}" 
                                   Placeholder="请输入身份证号"
                                   Style="{StaticResource EntryStyle}"/>
                            
                            <Label Text="职位" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Picker Title="请选择职位"
                                    ItemsSource="{Binding UserEditorViewModel.PositionOptions}"
                                    SelectedItem="{Binding UserEditorViewModel.SelectedPosition}"/>
                            
                            <Label Text="所属组织" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Picker Title="请选择组织"
                                    ItemsSource="{Binding UserEditorViewModel.AvailableOrganizations}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding UserEditorViewModel.SelectedOrganization}"/>
                            
                            <Label Text="状态" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Switch IsToggled="{Binding UserEditorViewModel.IsActive}" HorizontalOptions="Start"/>
                            
<Label Text="分配角色" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                             <CollectionView ItemsSource="{Binding UserEditorViewModel.UserRoles}" HeightRequest="120">
                                 <CollectionView.EmptyView>
                                     <Label Text="暂未分配角色" FontSize="14" TextColor="{StaticResource TextTertiary}" Margin="0,8"/>
                                 </CollectionView.EmptyView>
                                 <CollectionView.ItemTemplate>
                                     <DataTemplate x:DataType="UserRoleItem">
                                         <Border BackgroundColor="#F1F5F9" Padding="12,8" Margin="0,4" StrokeShape="RoundRectangle 8">
                                             <Grid ColumnDefinitions="*,Auto">
                                                 <Label Text="{Binding RoleName}" FontSize="16" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
<Button Grid.Column="1" Text="&#xE74D;" FontFamily="Segoe Fluent Icons"
                                                          Style="{StaticResource WarningButton}" WidthRequest="32" HeightRequest="32" Padding="0"
                                                          Command="{Binding Source={RelativeSource AncestorType={x:Type UserManagementViewModel}}, Path=UserEditorViewModel.RemoveRoleCommand}"
                                                          CommandParameter="{Binding .}"/>
                                             </Grid>
                                         </Border>
                                     </DataTemplate>
                                 </CollectionView.ItemTemplate>
                             </CollectionView>
                             
                             <Grid ColumnDefinitions="*,Auto" Margin="0,8">
                                 <Picker Title="选择角色"
                                         ItemsSource="{Binding UserEditorViewModel.AvailableRoles}"
                                         ItemDisplayBinding="{Binding Name}"
                                         SelectedItem="{Binding UserEditorViewModel.SelectedRoleToAdd}"
                                         HorizontalOptions="Fill"/>
                                 <Button Grid.Column="1" Text="&#xE710;" FontFamily="Segoe Fluent Icons"
                                         Style="{StaticResource ButtonOutline}" WidthRequest="40" HeightRequest="40" Padding="0" Margin="8,0,0,0"
                                         Command="{Binding UserEditorViewModel.AddRoleCommand}"/>
                             </Grid>
                            
                        </VerticalStackLayout>
                    </ScrollView>
                    
                    <!-- 抽屉底部按钮 -->
                    <Border Grid.Row="2" BackgroundColor="{StaticResource Gray50}" Padding="20,12">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <Button Grid.Column="1" Text="取消" Style="{StaticResource ButtonOutline}"
                                    Command="{Binding UserEditorViewModel.CancelCommand}"/>
                            <Button Grid.Column="2" Text="&#xE74E; 保存" FontFamily="Segoe Fluent Icons"
                                    Style="{StaticResource ButtonPrimary}"
                                    Command="{Binding UserEditorViewModel.SaveCommand}"/>
                        </Grid>
                    </Border>
                    
                </Grid>
            </Border>
        </Border>

        <!-- 角色编辑抽屉（右侧滑出） -->
        <Border Grid.Row="0" Grid.RowSpan="5" Grid.Column="0"
                BackgroundColor="#80000000" 
                IsVisible="{Binding IsRoleEditorVisible}"
                HorizontalOptions="Fill" VerticalOptions="Fill">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding RoleEditorViewModel.CancelCommand}"/>
            </Border.GestureRecognizers>
            
            <Border BackgroundColor="White" WidthRequest="400" HorizontalOptions="End"
                    StrokeShape="RoundRectangle 0">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer/>
                </Border.GestureRecognizers>
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="-4,0" Radius="16" Opacity="0.2"/>
                </Border.Shadow>
                
                <Grid RowDefinitions="Auto,*,Auto">
                    
                    <!-- 抽屉标题 -->
                    <Border Grid.Row="0" BackgroundColor="{StaticResource Primary}" Padding="20,16">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Text="&#xE8C7;" FontFamily="Segoe Fluent Icons" FontSize="16" TextColor="White" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="{Binding RoleEditorViewModel.IsEditMode, Converter={StaticResource BoolToTextConverter}, ConverterParameter='编辑角色|新建角色'}"
                                   FontSize="14" FontAttributes="Bold" TextColor="White" Margin="12,0,0,0" VerticalOptions="Center"/>
                            <Button Grid.Column="2" Text="&#xE711;" FontFamily="Segoe Fluent Icons"
                                    BackgroundColor="Transparent" TextColor="White"
                                    Command="{Binding RoleEditorViewModel.CancelCommand}"/>
                        </Grid>
                    </Border>
                    
                    <!-- 抽屉内容 -->
                    <ScrollView Grid.Row="1" Padding="20">
                        <VerticalStackLayout Spacing="16">
                            
                            <Label Text="角色名称" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Entry Text="{Binding RoleEditorViewModel.RoleName}" 
                                   Placeholder="请输入角色名称"
                                   Style="{StaticResource EntryStyle}"/>
                            
                            <Label Text="角色代码" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"
                                   IsVisible="{Binding RoleEditorViewModel.IsEditMode, Converter={StaticResource BoolToInverseConverter}}"/>
                            <Entry Text="{Binding RoleEditorViewModel.RoleCode}" 
                                   Placeholder="请输入角色代码（英文大写）"
                                   IsVisible="{Binding RoleEditorViewModel.IsEditMode, Converter={StaticResource BoolToInverseConverter}}"
                                   Style="{StaticResource EntryStyle}"/>
                            
                            <Label Text="角色描述" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Editor Text="{Binding RoleEditorViewModel.RoleDescription}" 
                                    Placeholder="请输入角色描述"
                                    HeightRequest="100"
                                    Style="{StaticResource EditorStyle}"/>
                            
                            <Label Text="角色等级" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Entry Text="{Binding RoleEditorViewModel.RoleLevel}"
                                   Placeholder="请输入角色等级"
                                   Keyboard="Numeric"
                                   Style="{StaticResource EntryStyle}"/>

                            <Label Text="数据范围" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Picker ItemsSource="{Binding RoleEditorViewModel.DataScopeOptions}"
                                    SelectedItem="{Binding RoleEditorViewModel.RoleDataScope}"
                                    ItemDisplayBinding="{Binding ., Converter={StaticResource DataScopeToDisplayConverter}}"/>

                        </VerticalStackLayout>
                    </ScrollView>
                    
                    <!-- 抽屉底部按钮 -->
                    <Border Grid.Row="2" BackgroundColor="{StaticResource Gray50}" Padding="20,12">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                            <Button Grid.Column="1" Text="取消" Style="{StaticResource ButtonOutline}"
                                    Command="{Binding RoleEditorViewModel.CancelCommand}"/>
                            <Button Grid.Column="2" Text="&#xE74E; 保存" FontFamily="Segoe Fluent Icons"
                                    Style="{StaticResource ButtonPrimary}"
                                    Command="{Binding RoleEditorViewModel.SaveCommand}"/>
                        </Grid>
                    </Border>
                    
                </Grid>
            </Border>
        </Border>

        <!-- 权限配置加载遮罩（全屏覆盖） -->
        <components:LoadingOverlay Grid.Row="0" Grid.RowSpan="5" IsLoading="{Binding IsPermissionLoading}"
                                   LoadingText="正在加载权限..."/>

    </Grid>

</ContentPage>
