<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Pages.UserManagement.OrganizationPage"
             x:DataType="OrganizationTreeViewModel"
             Title="组织管理"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <converters:BoolToInverseConverter x:Key="BoolToInverseConverter"/>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- 渐变英雄头部（蓝色） -->
        <!-- 统一页头（纸墨档案风报头 · Phase 6，操作按钮映射到 HeaderActions 插槽） -->
        <components:PageHeaderView Grid.Row="0"
                                   Glyph="{OnPlatform WinUI='&#xE73E;', Android='&#x2713;'}"
                                   Title="经办机构管理"
                                   Subtitle="管理组织架构与机构树"
                                   BackCommand="{Binding GoBackCommand}"
                                   BackText="返回工作台">
            <components:PageHeaderView.HeaderActions>
<Button Grid.Column="2"
                            Text="{OnPlatform WinUI='&#xE72C; 刷新', Android='&#x1F5D1;&#xFE0F; 刷新'}"
                            FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}"
                            BackgroundColor="Transparent" BorderColor="{StaticResource LineStrong}" BorderWidth="1"
                            TextColor="{StaticResource Ink}"
                            FontSize="16"
                            Command="{Binding LoadTreeCommand}"
                            VerticalOptions="Center"
                            Padding="16,10"
                            CornerRadius="{StaticResource CornerRadiusMedium}"/>
            </components:PageHeaderView.HeaderActions>
        </components:PageHeaderView>

        <!-- Row 1: 主内容区 左树右仪表盘 -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <!-- Column 0: 左侧组织树面板 -->
            <Border Grid.Column="0" BackgroundColor="White" Margin="0,1,0,0" WidthRequest="320">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="2,0" Radius="4" Opacity="0.05"/>
                </Border.Shadow>
                <Grid RowDefinitions="Auto,Auto,Auto,*">

                    <!-- 搜索栏 -->
                    <Border Grid.Row="0" BackgroundColor="{StaticResource CardOptionBackground}" Padding="16,12" Margin="8,8,8,4"
                            StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Grid.Column="0" Placeholder="搜索组织名称..."
                                   Text="{Binding SearchText}" FontSize="18"
                                   TextColor="{StaticResource TextPrimary}"
                                   BackgroundColor="Transparent"
                                   PlaceholderColor="{StaticResource TextTertiary}"/>
                            <Label Grid.Column="1" Text="{OnPlatform WinUI='&#xE721;', Android='&#x1F50D;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}"
                                   FontSize="20" TextColor="{StaticResource TextSecondary}"
                                   VerticalOptions="Center" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- 新建组织按钮 -->
                    <Button Grid.Row="1" Text="{OnPlatform WinUI='&#xE710; 新建组织', Android='&#x2795; 新建组织'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}"
                            Style="{StaticResource ButtonPrimary}"
                            Command="{Binding CreateOrganizationCommand}"
                            HorizontalOptions="Fill" Margin="8,4,8,8"
                            Opacity="{Binding CreateOrganizationOpacity}"/>

                    <!-- 列表标题栏 -->
                    <Border Grid.Row="2" BackgroundColor="{StaticResource CardOptionBackground}" Padding="12,8" Margin="8,0">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0" Text="组织列表" Style="{StaticResource TableHeaderLabel}"/>
                            <Label Grid.Column="2" Text="{Binding TotalOrganizations, StringFormat='共 {0} 个'}"
                                   FontSize="16" TextColor="{StaticResource TextTertiary}"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <!-- 组织树列表 -->
                    <ScrollView Grid.Row="3">
                        <Grid>
                            <CollectionView ItemsSource="{Binding FilteredOrganizationTree}" Margin="8,0,8,8">
                                <CollectionView.EmptyView>
                                    <VerticalStackLayout HorizontalOptions="Center" Margin="0,40,0,0" Spacing="8">
                                        <Label Text="{OnPlatform WinUI='&#xE73E;', Android='&#x2713;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}"
                                               FontSize="34" TextColor="{StaticResource TextTertiary}"
                                               HorizontalOptions="Center"/>
                                        <Label Text="暂无组织数据" Style="{StaticResource EmptyStateLabel}" Margin="0"/>
                                    </VerticalStackLayout>
                                </CollectionView.EmptyView>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="domain:OrganizationTreeNode">
                                        <Border Padding="0" Margin="0,1" BackgroundColor="Transparent" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                                            <VisualStateManager.VisualStateGroups>
                                                <VisualStateGroupList>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="Transparent"/>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                        <VisualState x:Name="PointerOver">
                                                            <VisualState.Setters>
                                                                <Setter Property="BackgroundColor" Value="{StaticResource HoverOverlay}"/>
                                                            </VisualState.Setters>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateGroupList>
                                            </VisualStateManager.VisualStateGroups>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type OrganizationTreeViewModel}}, Path=SelectOrganizationCommand}"
                                                    CommandParameter="{Binding}"/>
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                <BoxView WidthRequest="{Binding IndentWidth}"
                                                         BackgroundColor="Transparent"
                                                         VerticalOptions="Fill"/>
                                                <Label Text="{OnPlatform WinUI='&#xE73E;', Android='&#x2713;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}"
                                                       FontSize="18" TextColor="{StaticResource Primary}"
                                                       VerticalOptions="Center" Margin="4,8,4,8"/>
                                                <Label Text="{Binding Name}" FontSize="18"
                                                       TextColor="{StaticResource TextPrimary}"
                                                       VerticalOptions="Center" Margin="0,8,8,8"/>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
<components:LoadingOverlay Grid.Row="0" Grid.RowSpan="2" IsLoading="{Binding IsBusy}"
    LoadingText="正在加载组织..."/>
                        </Grid>
                    </ScrollView>

                </Grid>
            </Border>
            <!-- Column 1: 右侧仪表盘 -->
            <ScrollView Grid.Column="1" BackgroundColor="{StaticResource Background}">
                <VerticalStackLayout Padding="20" Spacing="20">

                    <!-- 统计概览 -->
                    <Label Text="统计概览" Style="{StaticResource SectionTitleLabel}"/>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">
                        <Border Grid.Column="0" Style="{StaticResource StatCard}"
                                Background="{StaticResource StatCardBlueGradient}">
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{OnPlatform WinUI='&#xE73E;', Android='&#x2713;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18" TextColor="White"/>
                                    <Label Text="组织总数" FontSize="18" TextColor="White" Opacity="0.9"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding TotalOrganizations}" FontSize="38"
                                       FontAttributes="Bold" TextColor="White"/>
                                <Label Text="全部组织数量" FontSize="16" TextColor="White" Opacity="0.8"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource StatCard}"
                                Background="{StaticResource StatCardGreenGradient}">
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{OnPlatform WinUI='&#xE77B;', Android='&#x1F464;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18" TextColor="White"/>
                                    <Label Text="关联用户" FontSize="18" TextColor="White" Opacity="0.9"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding TotalUsers}" FontSize="38"
                                       FontAttributes="Bold" TextColor="White"/>
                                <Label Text="组织关联用户数" FontSize="16" TextColor="White" Opacity="0.8"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource StatCard}"
                                Background="{StaticResource StatCardOrangeGradient}">
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{OnPlatform WinUI='&#xE8F1;', Android='&#x1F5C2;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18" TextColor="White"/>
                                    <Label Text="子组织数" FontSize="18" TextColor="White" Opacity="0.9"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding SelectedOrganizationChildrenCount}" FontSize="38"
                                       FontAttributes="Bold" TextColor="White"/>
                                <Label Text="选中组织的子组织" FontSize="16" TextColor="White" Opacity="0.8"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource StatCard}"
                                Background="{StaticResource StatCardPurpleGradient}">
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{OnPlatform WinUI='&#xE7BE;', Android='&#x1F3E2;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18" TextColor="White"/>
                                    <Label Text="特困机构" FontSize="18" TextColor="White" Opacity="0.9"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding SpecialCareInstitutionCount}" FontSize="38"
                                       FontAttributes="Bold" TextColor="White"/>
                                <Label Text="特困供养机构" FontSize="16" TextColor="White" Opacity="0.8"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <!-- 快捷操作 -->
                    <Label Text="快捷操作" Style="{StaticResource SectionTitleLabel}" Margin="0,12,0,8"/>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <Border Grid.Column="0" Style="{StaticResource CardBorderElevated}">
                            <VerticalStackLayout Spacing="16">
                                <HorizontalStackLayout Spacing="12">
                                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#FDF2F8"
                                            StrokeShape="RoundRectangle 12">
                                        <Label Text="{OnPlatform WinUI='&#xE710;', Android='&#x2795;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="26"
                                               TextColor="{StaticResource ModuleUser}"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                        <Label Text="新建组织" FontSize="16" FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"/>
                                        <Label Text="创建新的组织机构" FontSize="16"
                                               TextColor="{StaticResource TextTertiary}"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}"/>
                                <Button Text="{OnPlatform WinUI='&#xE710; 新建组织', Android='&#x2795; 新建组织'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}"
                                        Style="{StaticResource ButtonPrimary}"
                                        Command="{Binding CreateOrganizationCommand}"
                                        Opacity="{Binding CreateOrganizationOpacity}"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardBorderElevated}">
                            <VerticalStackLayout Spacing="16">
                                <HorizontalStackLayout Spacing="12">
                                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{StaticResource SuccessSoft}"
                                            StrokeShape="RoundRectangle 12">
                                        <Label Text="{OnPlatform WinUI='&#xE8B5;', Android='&#x1F4E5;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="26"
                                               TextColor="#10B981" HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Border>
                                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                        <Label Text="导入组织" FontSize="16" FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"/>
                                        <Label Text="从Excel导入组织数据" FontSize="16"
                                               TextColor="{StaticResource TextTertiary}"/>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}"/>
                                <Button Text="{OnPlatform WinUI='&#xE8B5; 导入', Android='&#x1F4E5; 导入'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}"
                                        Style="{StaticResource ButtonOutline}"
                                        Command="{Binding NavigateToImportPageCommand}"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <!-- 组织详情 -->
                    <Label Text="组织详情" Style="{StaticResource SectionTitleLabel}" Margin="0,12,0,8"/>

                    <!-- 选中时显示详情 -->
                    <Grid IsVisible="{Binding SelectedOrganizationDetails, Converter={StaticResource NullToBoolConverter}}">
                        <Border Style="{StaticResource CardBorderElevated}">
                            <VerticalStackLayout Spacing="20">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding SelectedOrganizationDetails.Name}"
                                           FontSize="26" FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}"/>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                        <Button Text="{OnPlatform WinUI='&#xE70F; 编辑', Android='&#x270F;&#xFE0F; 编辑'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}"
                                                Style="{StaticResource ButtonPrimary}"
                                                Command="{Binding EditOrganizationCommand}"
                                                IsEnabled="{Binding CanEditSelected}"
                                                Opacity="{Binding EditOrganizationOpacity}"/>
                                        <Button Text="{OnPlatform WinUI='&#xE74D; 删除', Android='&#x1F5D1;&#xFE0F; 删除'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}"
                                                Style="{StaticResource ButtonDanger}"
                                                Command="{Binding DeleteOrganizationCommand}"
                                                IsEnabled="{Binding CanDeleteSelected}"
                                                Opacity="{Binding DeleteOrganizationOpacity}"/>
                                    </HorizontalStackLayout>
                                </Grid>
                                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}"/>
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                      RowSpacing="16" ColumnSpacing="40">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <Label Text="组织简称" FontSize="16" TextColor="{StaticResource TextTertiary}"/>
                                        <Label Text="{Binding SelectedOrganizationDetails.Abbreviation}"
                                               FontSize="19" TextColor="{StaticResource TextPrimary}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                        <Label Text="上级组织" FontSize="16" TextColor="{StaticResource TextTertiary}"/>
                                        <Label Text="{Binding SelectedOrganizationDetails.ParentName}"
                                               FontSize="19" TextColor="{StaticResource TextPrimary}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                        <Label Text="负责人" FontSize="16" TextColor="{StaticResource TextTertiary}"/>
                                        <Label Text="{Binding SelectedOrganizationDetails.Principal}"
                                               FontSize="19" TextColor="{StaticResource TextPrimary}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                        <Label Text="联系电话" FontSize="16" TextColor="{StaticResource TextTertiary}"/>
                                        <Label Text="{Binding SelectedOrganizationDetails.Phone}"
                                               FontSize="19" TextColor="{StaticResource TextPrimary}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                                        <Label Text="地址" FontSize="16" TextColor="{StaticResource TextTertiary}"/>
                                        <Label Text="{Binding SelectedOrganizationDetails.Address}"
                                               FontSize="19" TextColor="{StaticResource TextPrimary}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="3" Grid.Column="0" Spacing="4">
                                        <Label Text="邮政编码" FontSize="16" TextColor="{StaticResource TextTertiary}"/>
                                        <Label Text="{Binding SelectedOrganizationDetails.PostalCode}"
                                               FontSize="19" TextColor="{StaticResource TextPrimary}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="4">
                                        <Label Text="机构性质" FontSize="16" TextColor="{StaticResource TextTertiary}"/>
                                        <Label Text="{Binding SelectedOrganizationDetails.InstitutionNature}"
                                               FontSize="19" TextColor="{StaticResource TextPrimary}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Spacing="4">
                                        <Label Text="所在地区" FontSize="16" TextColor="{StaticResource TextTertiary}"/>
                                        <Label FontSize="19" TextColor="{StaticResource TextPrimary}">
                                            <Label.Text>
                                                <MultiBinding StringFormat="{}{0} {1} {2} {3}">
                                                    <Binding Path="SelectedOrganizationDetails.CityName"/>
                                                    <Binding Path="SelectedOrganizationDetails.CountyName"/>
                                                    <Binding Path="SelectedOrganizationDetails.TownName"/>
                                                    <Binding Path="SelectedOrganizationDetails.VillageName"/>
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="5" Grid.Column="0" Spacing="4">
                                        <Label Text="机构类型" FontSize="16" TextColor="{StaticResource TextTertiary}"/>
                                        <Label Text="{Binding SelectedOrganizationDetails.InstitutionType}"
                                               FontSize="19" TextColor="{StaticResource TextPrimary}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="5" Grid.Column="1" Spacing="4">
                                        <Label Text="特困供养机构" FontSize="16" TextColor="{StaticResource TextTertiary}"/>
                                        <Label Text="{Binding SelectedOrganizationDetails.IsSpecialCareInstitution, Converter={StaticResource BoolToTextConverter}}"
                                               FontSize="19" TextColor="{StaticResource TextPrimary}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="6" Grid.Column="0" Spacing="4">
                                        <Label Text="创建时间" FontSize="16" TextColor="{StaticResource TextTertiary}"/>
                                        <Label Text="{Binding SelectedOrganizationDetails.CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                               FontSize="19" TextColor="{StaticResource TextPrimary}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="6" Grid.Column="1" Spacing="4">
                                        <Label Text="更新时间" FontSize="16" TextColor="{StaticResource TextTertiary}"/>
                                        <Label Text="{Binding SelectedOrganizationDetails.UpdatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                               FontSize="19" TextColor="{StaticResource TextPrimary}"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- 未选中时空状态提示：源是 Organization 对象，必须用 NullToInverseBoolConverter
                         （BoolToInverseConverter 只认 bool，收到对象恒返回 true，会与详情面板同时显示） -->
                    <Grid IsVisible="{Binding SelectedOrganizationDetails, Converter={StaticResource NullToInverseBoolConverter}}">
                        <Border Style="{StaticResource CardBorderElevated}" Padding="40"
                                HorizontalOptions="Fill">
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="12">
                                <Label Text="{OnPlatform WinUI='&#xE73E;', Android='&#x2713;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="50"
                                       TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center"/>
                                <Label Text="请从左侧选择一个组织查看详情" Style="{StaticResource EmptyStateLabel}" Margin="0"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>

        </Grid>

        <!-- 编辑器弹窗覆盖层 -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              BackgroundColor="#80000000"
              IsVisible="{Binding IsOrganizationEditorVisible}"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <Border BackgroundColor="White" StrokeShape="RoundRectangle 12" Padding="28"
                    WidthRequest="560" VerticalOptions="Center" HorizontalOptions="Center">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="16" Opacity="0.2"/>
                </Border.Shadow>
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                        <Label Grid.Column="0" Text="{OnPlatform WinUI='&#xE70F;', Android='&#x270F;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}"
                               FontSize="18" TextColor="{StaticResource Primary}" VerticalOptions="Center"
                               Margin="0,0,8,0"/>
                        <Label Grid.Column="1" Text="{Binding OrganizationEditorViewModel.EditorTitle}"
                               Style="{StaticResource SectionTitleLabel}" Margin="0" VerticalOptions="Center"/>
                    </Grid>

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="14">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="组织名称" FontSize="17" FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}"/>
                                <Entry Text="{Binding OrganizationEditorViewModel.Name}"
                                       Placeholder="请输入组织名称"
                                       FontSize="18" BackgroundColor="{StaticResource Gray50}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="组织简称" FontSize="17" FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}"/>
                                <Entry Text="{Binding OrganizationEditorViewModel.Abbreviation}"
                                       Placeholder="请输入组织简称"
                                       FontSize="18" BackgroundColor="{StaticResource Gray50}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="上级组织" FontSize="17" FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}"/>
                                <Picker ItemsSource="{Binding OrganizationEditorViewModel.ParentOrganizationOptions}"
                                        SelectedItem="{Binding OrganizationEditorViewModel.SelectedParentOrganization}"
                                        ItemDisplayBinding="{Binding Name, x:DataType=domain:Organization}"
                                        FontSize="18" BackgroundColor="{StaticResource Gray50}"/>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="负责人" FontSize="17" FontAttributes="Bold"
                                           TextColor="{StaticResource TextSecondary}"/>
                                    <Entry Text="{Binding OrganizationEditorViewModel.Principal}"
                                           Placeholder="负责人姓名"
                                           FontSize="18" BackgroundColor="{StaticResource Gray50}"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="联系电话" FontSize="17" FontAttributes="Bold"
                                           TextColor="{StaticResource TextSecondary}"/>
                                    <Entry Text="{Binding OrganizationEditorViewModel.Phone}"
                                           Placeholder="联系电话"
                                           FontSize="18" BackgroundColor="{StaticResource Gray50}"/>
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="地址" FontSize="17" FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}"/>
                                <Entry Text="{Binding OrganizationEditorViewModel.Address}"
                                       Placeholder="请输入地址"
                                       FontSize="18" BackgroundColor="{StaticResource Gray50}"/>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="邮政编码" FontSize="17" FontAttributes="Bold"
                                           TextColor="{StaticResource TextSecondary}"/>
                                    <Entry Text="{Binding OrganizationEditorViewModel.PostalCode}"
                                           Placeholder="邮政编码"
                                           FontSize="18" BackgroundColor="{StaticResource Gray50}"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="机构性质" FontSize="17" FontAttributes="Bold"
                                           TextColor="{StaticResource TextSecondary}"/>
                                    <Entry Text="{Binding OrganizationEditorViewModel.InstitutionNature}"
                                           Placeholder="机构性质"
                                           FontSize="18" BackgroundColor="{StaticResource Gray50}"/>
                                </VerticalStackLayout>
                            </Grid>

                            <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                <Switch IsToggled="{Binding OrganizationEditorViewModel.IsSpecialCareInstitution}"
                                        OnColor="{StaticResource Primary}"/>
                                <Label Text="特困供养机构" FontSize="17"
                                       TextColor="{StaticResource TextPrimary}"
                                       VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="机构类别" FontSize="17" FontAttributes="Bold"
                                           TextColor="{StaticResource TextSecondary}"/>
                                    <Picker ItemsSource="{Binding OrganizationEditorViewModel.InstitutionCategoryOptions}"
                                            SelectedItem="{Binding OrganizationEditorViewModel.InstitutionCategory}"
                                            FontSize="18" BackgroundColor="{StaticResource Gray50}"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="机构类型" FontSize="17" FontAttributes="Bold"
                                           TextColor="{StaticResource TextSecondary}"/>
                                    <Picker ItemsSource="{Binding OrganizationEditorViewModel.InstitutionTypeOptions}"
                                            SelectedItem="{Binding OrganizationEditorViewModel.InstitutionTypeValue}"
                                            FontSize="18" BackgroundColor="{StaticResource Gray50}"/>
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="所在地区" FontSize="17" FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}"/>
                                <!-- 省（2026-10-26 真级联：选省 → 筛市；回显按市反查省） -->
                                <Picker Title="选择省/直辖市" FontSize="18" BackgroundColor="{StaticResource Gray50}"
                                        ItemsSource="{Binding OrganizationEditorViewModel.ProvinceOptions}"
                                        SelectedItem="{Binding OrganizationEditorViewModel.SelectedProvinceName}"/>
                                <Picker Title="选择地级市" FontSize="18" BackgroundColor="{StaticResource Gray50}"
                                        ItemsSource="{Binding OrganizationEditorViewModel.CityOptions}"
                                        SelectedItem="{Binding OrganizationEditorViewModel.SelectedCityName}"/>
                                <Picker Title="选择区县" FontSize="18" BackgroundColor="{StaticResource Gray50}"
                                        ItemsSource="{Binding OrganizationEditorViewModel.CountyOptions}"
                                        SelectedItem="{Binding OrganizationEditorViewModel.SelectedCountyName}"/>
                                <Picker Title="选择乡镇" FontSize="18" BackgroundColor="{StaticResource Gray50}"
                                        ItemsSource="{Binding OrganizationEditorViewModel.TownOptions}"
                                        SelectedItem="{Binding OrganizationEditorViewModel.SelectedTownName}"/>
                                <Picker Title="选择村/社区" FontSize="18" BackgroundColor="{StaticResource Gray50}"
                                        ItemsSource="{Binding OrganizationEditorViewModel.VillageOptions}"
                                        SelectedItem="{Binding OrganizationEditorViewModel.SelectedVillageName}"/>
                                <!-- 区划加载失败提示：原实现是静默空列表，既无提示也无日志，
                                     保存时还会把库中已有区划写成 NULL -->
                                <Label IsVisible="{Binding OrganizationEditorViewModel.RegionLoadFailed}"
                                       Text="{Binding OrganizationEditorViewModel.RegionLoadMessage}"
                                       FontSize="15" TextColor="#B45309" Margin="0,6,0,0"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <HorizontalStackLayout Grid.Row="2" Spacing="12" HorizontalOptions="End">
                        <Button Text="取消" Style="{StaticResource ButtonOutline}"
                                Command="{Binding OrganizationEditorViewModel.CancelCommand}"
                                WidthRequest="100"/>
                        <Button Text="{OnPlatform WinUI='&#xE74E; 保存', Android='&#x1F4BE; 保存'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}"
                                Style="{StaticResource ButtonPrimary}"
                                Command="{Binding OrganizationEditorViewModel.SaveCommand}"
                                WidthRequest="120"/>
                    </HorizontalStackLayout>
                </Grid>
            </Border>
        </Grid>

        <!-- SnackBar 提示 -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              VerticalOptions="End" HorizontalOptions="Fill"
              Padding="24,0,24,80" InputTransparent="True">
            <components:SnackBarView
                Message="{Binding SnackBarMessage}"
                Type="{Binding SnackBarType}"
                IsVisible="{Binding IsSnackBarVisible}"/>
        </Grid>

    </Grid>

</ContentPage>
