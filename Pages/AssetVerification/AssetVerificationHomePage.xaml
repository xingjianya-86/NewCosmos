<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Pages.AssetVerification.AssetVerificationHomePage"
             x:DataType="AssetVerificationHomeViewModel"
             Title="家庭经济状况核对"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,20">

                <!-- 域色渐变头部横幅：标题 + 职责描述 + 模块统计栏 -->
                <!-- 统一页头（纸墨档案风报头 · Phase 6，统计胶囊迁入 Stats 插槽并转浅色变体） -->
                <components:PageHeaderView
                                           Glyph="{OnPlatform WinUI='&#xE721;', Android='&#x1F50D;'}"
                                           Title="家庭经济状况核对"
                                           Subtitle="居民家庭经济状况核对 · 授权报告上传与月度审核"
                                           BackCommand="{Binding GoBackCommand}"
                                           BackText="返回工作台">
                    <components:PageHeaderView.Stats>
<Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                            <components:StatCapsule IsLight="True"  Grid.Column="0"  Value="{Binding PendingReportCountText}" Caption="待上传（户）"/>
                            <components:StatCapsule IsLight="True"  Grid.Column="1"  Value="{Binding MonthlyCompletedText}" Caption="本月已完成（户）"/>
                            <components:StatCapsule IsLight="True"  Grid.Column="2"  Value="{Binding MonthlyNewText}" Caption="本月新增（户）"/>
                            <components:StatCapsule IsLight="True"  Grid.Column="3"  Value="{Binding YearTotalText}" Caption="全年累计（户）"/>
                        </Grid>
                    </components:PageHeaderView.Stats>
                </components:PageHeaderView>

                <!-- 子功能卡片区 -->
                <VerticalStackLayout Margin="20,20,20,0" Spacing="14">
                    <Label Text="业务办理" Style="{StaticResource SectionTitleLabel}" Margin="4,4,0,0"/>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">

                        <!-- 快速经济核对 -->
                        <components:FeatureCard Grid.Row="0" Grid.Column="0" Glyph="{OnPlatform WinUI='&#xE721;', Android='&#x1F50D;'}"
                                                IconBackgroundColor="#FFFBEB" IconColor="{StaticResource ModuleAssetVerification}"
                                                Title="快速经济核对" Description="发起单户家庭经济状况核对申请"
                                                Command="{Binding OpenQuickVerificationCommand}"
                                                Opacity="{Binding AssetVerificationOpacity}"/>

                        <!-- 月度审核 -->
                        <components:FeatureCard Grid.Row="0" Grid.Column="1" Glyph="{OnPlatform WinUI='&#xE8FB;', Android='&#x1F50D;'}"
                                                IconBackgroundColor="#FFFBEB" IconColor="{StaticResource ModuleAssetVerification}"
                                                Title="月度审核" Description="核对报告上传、复核与批量处理"
                                                Command="{Binding OpenMonthlyAuditCommand}"
                                                Opacity="{Binding AssetVerificationOpacity}"/>

                        <!-- 核对月报表 -->
                        <components:FeatureCard Grid.Row="1" Grid.Column="0" Glyph="{OnPlatform WinUI='&#xE81E;', Android='&#x1F6E0;&#xFE0F;'}"
                                                IconBackgroundColor="#FFFBEB" IconColor="{StaticResource ModuleAssetVerification}"
                                                Title="核对月报表" Description="按月生成、导出核对统计报表"
                                                Command="{Binding OpenMonthlyReportCommand}"
                                                Opacity="{Binding AssetVerificationOpacity}"/>

                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
