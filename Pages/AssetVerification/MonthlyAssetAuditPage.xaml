<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Pages.AssetVerification.MonthlyAssetAuditPage"
             x:DataType="MonthlyAssetAuditViewModel"
             Title="月度审核"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <converters:BoolToInverseConverter x:Key="BoolToInverseConverter"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*" RowSpacing="0">

        <!-- 渐变英雄头部（橙色） -->
        <!-- 统一页头（纸墨档案风报头 · Phase 6 页头架构统一，替代旧渐变英雄头） -->
        <components:PageHeaderView Grid.Row="0"
                                   Glyph="{OnPlatform WinUI='&#xE898;', Android='&#x1F4CE;'}"
                                   Title="月度审核"
                                   Subtitle="按月核查资产状况与数据审核"
                                   BackCommand="{Binding GoBackCommand}"
                                   BackText="返回工作台"/>

        <Grid Grid.Row="1" ColumnDefinitions="420,*" ColumnSpacing="0">

            <!-- 左侧面板 -->
            <ScrollView Grid.Column="0">
                <VerticalStackLayout Padding="16" Spacing="12">

                    <!-- 报表周期 -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="报表周期" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                            <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="8">
                                <Picker Grid.Column="0" HeightRequest="40" ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="年" FontSize="18" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                <Picker Grid.Column="2" HeightRequest="40" ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedMonth}" VerticalOptions="Center"/>
                                <Label Grid.Column="3" Text="月" FontSize="18" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            </Grid>
                            <Label Text="{Binding PeriodText}" FontSize="17" TextColor="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 核对概览 -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="核对概览" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                                <Border Grid.Column="0" Grid.Row="0" BackgroundColor="{StaticResource InfoSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="已提交" FontSize="16" TextColor="{StaticResource PrimaryDark}"/>
                                        <Label Text="{Binding SubmittedCount}" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Grid.Row="0" BackgroundColor="{StaticResource WarningSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="有报告未建档" FontSize="16" TextColor="{StaticResource WarningDark}"/>
                                        <Label Text="{Binding HasReportCount}" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource WarningDark}"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="0" Grid.Row="1" BackgroundColor="{StaticResource SuccessSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="已建档" FontSize="16" TextColor="{StaticResource SecondaryDark}"/>
                                        <Label Text="{Binding ArchivedCount}" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource SecondaryDark}"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" Grid.Row="1" BackgroundColor="{StaticResource DangerSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="不予认定" FontSize="16" TextColor="{StaticResource Error}"/>
                                        <Label Text="{Binding RejectedCount}" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource Error}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                            <Label HorizontalOptions="End" TextColor="{StaticResource TextSecondary}" FontSize="16" Text="{Binding TotalCount, StringFormat='总计 {0} 户'}"/>
                            <Label Text="统计按户；名单/报告按人" FontSize="13" TextColor="{StaticResource TextTertiary}" HorizontalOptions="End"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 待核对人员 -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="待核对人员" Style="{StaticResource SectionTitleLabel}" Margin="0" VerticalOptions="Center"/>
                                <Border Grid.Column="1" Style="{StaticResource ChipInfo}" VerticalOptions="Center">
                                    <Label Text="{Binding MatchTasks.Count}" Style="{StaticResource ChipInfoText}" FontAttributes="Bold" VerticalOptions="Center"/>
                                </Border>
                                <Button Grid.Column="2" Text="保存报告" FontSize="15" Padding="10,2" HeightRequest="30"
                                        BackgroundColor="{StaticResource SuccessSoft}" TextColor="{StaticResource Success}" CornerRadius="6"
                                        VerticalOptions="Center"
                                        Command="{Binding SaveReportCommand}"
                                        IsEnabled="{Binding CanPrintReport}"/>
                                <Button Grid.Column="3" Text="打印报告" FontSize="15" Padding="10,2" HeightRequest="30"
                                        BackgroundColor="{StaticResource InfoSoft}" TextColor="{StaticResource PrimaryDark}" CornerRadius="6"
                                        VerticalOptions="Center"
                                        Command="{Binding PrintSelectedCommand}"
                                        IsEnabled="{Binding CanPrintReport}"/>
                            </Grid>
                            <!-- 人员名单搜索：姓名/身份证号关键字 -->
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Entry Grid.Column="0" Placeholder="搜索姓名/身份证号" Text="{Binding SearchKeyword}"
                                       HeightRequest="36" FontSize="16" IsTextPredictionEnabled="False"
                                       Completed="OnSearchEntryCompleted"/>
                                <Button Grid.Column="1" Text="搜索" FontSize="15" Padding="14,0" HeightRequest="36"
                                        BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="6"
                                        Command="{Binding SearchCommand}"/>
                                <Button Grid.Column="2" Text="打开输出目录" FontSize="14" Padding="10,0" HeightRequest="36"
                                        BackgroundColor="Transparent" TextColor="{StaticResource PrimaryDark}"
                                        Command="{Binding OpenOutputFolderCommand}"/>
                            </Grid>
                            <CollectionView ItemsSource="{Binding MatchTasks}" HeightRequest="180" SelectionMode="Single" SelectedItem="{Binding SelectedMatchTask}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="assetsvc:AssetVerificationTask">
                                        <Border Padding="12,8" Margin="0,4" BackgroundColor="{StaticResource Gray50}" StrokeThickness="0" StrokeShape="RoundRectangle 8">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <Label Grid.Column="0" Text="{Binding ArchiveName}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>

                                                <!-- 状态徽章（柔和 Chip：已提交/有报告未建档/已建档/不予认定） -->
                                                <Border Grid.Column="1" Style="{StaticResource ChipNeutral}" VerticalOptions="Center">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding StatusDisplay}" Value="已提交">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource InfoSoft}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border" Binding="{Binding StatusDisplay}" Value="有报告未建档">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource WarningSoft}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border" Binding="{Binding StatusDisplay}" Value="已建档（已纳入）">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource SuccessSoft}"/>
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border" Binding="{Binding StatusDisplay}" Value="不予认定">
                                                            <Setter Property="BackgroundColor" Value="{StaticResource DangerSoft}"/>
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Label Text="{Binding StatusDisplay}" Style="{StaticResource ChipNeutralText}">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding StatusDisplay}" Value="已提交">
                                                                <Setter Property="TextColor" Value="{StaticResource PrimaryDark}"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding StatusDisplay}" Value="有报告未建档">
                                                                <Setter Property="TextColor" Value="{StaticResource WarningDark}"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding StatusDisplay}" Value="已建档（已纳入）">
                                                                <Setter Property="TextColor" Value="{StaticResource SecondaryDark}"/>
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding StatusDisplay}" Value="不予认定">
                                                                <Setter Property="TextColor" Value="{StaticResource Error}"/>
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Border>

                                                <Button Grid.Column="2" Text="不予认定" FontSize="14" Padding="10,2" HeightRequest="30"
                                                        BackgroundColor="{StaticResource DangerSoft}" TextColor="{StaticResource Error}" CornerRadius="6" VerticalOptions="Center"
                                                        IsVisible="{Binding CanReject}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type MonthlyAssetAuditViewModel}}, Path=RejectCheckCommand}"
                                                        CommandParameter="{Binding .}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <Label Text="暂无待核对人员" Style="{StaticResource EmptyStateLabel}" Margin="0,24,0,0"/>
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 批量上传 -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="批量上传" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Border Grid.Column="0" BackgroundColor="{StaticResource WarningSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="待上传" FontSize="16" TextColor="{StaticResource WarningDark}"/>
                                        <Label Text="{Binding UploadPendingCount}" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource WarningDark}"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="{StaticResource DangerSoft}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="12,8">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="失败" FontSize="16" TextColor="{StaticResource Error}"/>
                                        <Label Text="{Binding UploadErrorCount}" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource Error}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                            <Button Text="选择文件夹并批量上传" Style="{StaticResource ButtonPrimary}" Command="{Binding BatchUploadCommand}" HeightRequest="44" FontSize="18" IsEnabled="{Binding IsUploading, Converter={x:Static converters:BoolToInverseConverter.Instance}}"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <HorizontalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                    <CheckBox IsChecked="{Binding IncludeSubfolders}" VerticalOptions="Center"/>
                                    <Label Text="包含子文件夹" FontSize="15" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Button Grid.Column="1" Text="取消上传" FontSize="15" Padding="12,0" HeightRequest="34"
                                        BackgroundColor="{StaticResource DangerSoft}" TextColor="{StaticResource Error}"
                                        CornerRadius="6" IsVisible="{Binding IsUploading}"
                                        Command="{Binding CancelBatchUploadCommand}"/>
                            </Grid>
                            <Grid IsVisible="{Binding IsUploading}" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <ProgressBar Grid.Column="0" Progress="{Binding UploadProgressPercent}" HeightRequest="16"/>
                                <Label Grid.Column="1" Text="{Binding UploadProgressText}" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 比对信息 -->
                    <Border Style="{StaticResource CardBorder}" IsVisible="{Binding HasSelectedMatchTask}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="比对信息" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                            <Label Text="{Binding MatchInfoText}" FontSize="16" TextColor="{StaticResource Gray800}"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- 右侧 PDF 预览 + 报告版本（只读） -->
            <Border Grid.Column="1" BackgroundColor="{StaticResource SurfaceVariant}" StrokeThickness="0">
                <Grid RowDefinitions="*,Auto">
                    <Grid Grid.Row="0">
                        <controls:PdfPreviewView x:Name="PdfPreview" PdfFilePath="{Binding PdfPreviewUrl}" IsVisible="{Binding HasPdfPreview}" VerticalOptions="Fill" HorizontalOptions="Fill"/>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" IsVisible="{Binding HasPdfPreview, Converter={StaticResource BoolToInverseConverter}}">
                            <Label Text="选择左侧人员后显示PDF预览" Style="{StaticResource EmptyStateLabel}" FontSize="22"/>
                        </VerticalStackLayout>
                    </Grid>

                    <Border Grid.Row="1" IsVisible="{Binding HasReportVersions}" BackgroundColor="White"
                            StrokeThickness="0" Padding="12,8">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="报告版本（只读）" FontSize="15" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                <Button Grid.Column="1" Text="打印此版本" FontSize="14" Padding="12,2" HeightRequest="30"
                                        BackgroundColor="{StaticResource InfoSoft}" TextColor="{StaticResource PrimaryDark}"
                                        CornerRadius="6" Command="{Binding PrintSelectedVersionCommand}"
                                        IsEnabled="{Binding CanPrintSelectedVersion}"/>
                            </Grid>
                            <CollectionView ItemsSource="{Binding ReportVersions}"
                                            SelectedItem="{Binding SelectedReportVersion}"
                                            SelectionMode="Single" HeightRequest="64">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="ReportVersionItem">
                                        <Border Padding="10,6" StrokeThickness="1" Stroke="{StaticResource Gray200}"
                                                StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource Gray50}">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimarySoft}"/>
                                                    <Setter Property="Stroke" Value="{StaticResource Primary}"/>
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding DisplayText}" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <Label Text="{Binding ReportVersionInfoText}" FontSize="13" TextColor="{StaticResource TextTertiary}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Border>

        </Grid>

    </Grid>

</ContentPage>
