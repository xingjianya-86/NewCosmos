<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Pages.ArchiveManagement.PendingPhotosPage"
             x:DataType="PendingPhotosViewModel"
             NavigationPage.HasNavigationBar="False"
             Title="待归属照片"
             BackgroundColor="{StaticResource Background}">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">
        <components:PageHeaderView Grid.Row="0"
                                   Title="待归属照片"
                                   Subtitle="身份证未定时先存照片；确认人员已建档后再归属"
                                   BackCommand="{Binding GoBackCommand}"
                                   BackText="返回"/>

        <Border Grid.Row="1" BackgroundColor="{StaticResource White}" StrokeThickness="0" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <Entry Text="{Binding Keyword}" Placeholder="姓名 / 身份证 / 备注关键词"
                       Style="{StaticResource FormFieldEntryStyle}"
                       ReturnCommand="{Binding SearchCommand}"/>
                <Button Grid.Column="1" Text="查询" Style="{StaticResource ButtonPrimary}"
                        Command="{Binding SearchCommand}"/>
                <Button Grid.Column="2" Text="归属选中" Style="{StaticResource ButtonSuccess}"
                        Command="{Binding AssignSelectedCommand}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Padding="16,8" RowDefinitions="Auto,*">
            <Label Text="{Binding StatusText}" FontSize="14" TextColor="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
            <CollectionView Grid.Row="1" ItemsSource="{Binding Photos}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="PendingPhotoItem">
                        <Border Style="{StaticResource CardBorder}" Padding="12">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                                <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center"/>
                                <Border Grid.Column="1" WidthRequest="84" HeightRequest="84"
                                        StrokeShape="RoundRectangle 8" StrokeThickness="0"
                                        BackgroundColor="{StaticResource Gray100}">
                                    <Image Source="{Binding Thumbnail}" Aspect="AspectFill"/>
                                </Border>
                                <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding Title}" FontSize="17" FontAttributes="Bold"
                                               TextColor="{StaticResource TextPrimary}"/>
                                        <Label Text="{Binding CategoryName}" FontSize="14"
                                               TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding RecognizedIdCard, StringFormat='身份证：{0}'}" FontSize="14"
                                           TextColor="{StaticResource TextSecondary}"/>
                                    <Label Text="{Binding CreatedAtText, StringFormat='采集：{0}   来源：'}" FontSize="13"
                                           TextColor="{StaticResource TextTertiary}"/>
                                    <Label Text="{Binding SourceText}" FontSize="13" TextColor="{StaticResource TextTertiary}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="3" Text="删除" Style="{StaticResource ButtonDanger}"
                                        VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type PendingPhotosViewModel}}, Path=DeleteCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="暂无待归属照片" Style="{StaticResource EmptyStateLabel}" Margin="0,24,0,0"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
