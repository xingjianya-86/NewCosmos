<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ent="clr-namespace:NewCosmos.Models.Entities"
             x:Class="NewCosmos.Pages.ArchiveManagement.TemplateManagementPage"
             x:DataType="TemplateManagementViewModel"
             Title="模板管理"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto, Auto, *" Padding="0">

        <!-- 渐变英雄头部（蓝色） -->
        <Border Grid.Row="0" Style="{StaticResource ModuleHeroHeader}" Background="{StaticResource StatCardBlueGradient}">
            <VerticalStackLayout Spacing="16">

                <!-- 返回行 -->
                <HorizontalStackLayout Spacing="6">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="14" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                    <Label Text="返回工作台" FontSize="13" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- 标题与副标题 -->
                <HorizontalStackLayout Spacing="14">
                    <Border WidthRequest="52" HeightRequest="52" BackgroundColor="#33FFFFFF" StrokeShape="RoundRectangle 14">
                        <Label Text="&#xE943;" FontFamily="Segoe Fluent Icons" FontSize="28" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="文书模板管理" Style="{StaticResource ModuleHeroTitle}"/>
                        <Label Text="管理、上传和维护各类文书模板" Style="{StaticResource ModuleHeroSubtitle}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>

        <!-- ========== 工具栏 ========== -->
        <Border Grid.Row="1" BackgroundColor="{StaticResource White}"
                StrokeThickness="0" Padding="20,12">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                <Border BackgroundColor="{StaticResource Gray100}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        Padding="16,8"
                        HorizontalOptions="Fill">
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               TextColor="{StaticResource Gray500}" VerticalOptions="Center" Margin="0,0,8,0"/>
                        <Entry Grid.Column="1" Placeholder="搜索模板名称..."
                               Text="{Binding SearchText}" FontSize="16"
                               BackgroundColor="Transparent"
                               ReturnCommand="{Binding SearchCommand}"/>
                    </Grid>
                </Border>
                <Button Grid.Column="1"
                        Command="{Binding ToggleUploadFormCommand}"
                        Text="{Binding IsUploadFormVisible, Converter={StaticResource BoolToTextConverter}, ConverterParameter=返回列表|上传模板}"
                        Style="{StaticResource ButtonPrimary}"
                        WidthRequest="120"/>
            </Grid>
        </Border>

        <!-- ========== 主体内容 ========== -->
        <ScrollView Grid.Row="2" BackgroundColor="{StaticResource Background}">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- ============================== -->
                <!-- 浏览模式: 模板列表 + 详情        -->
                <!-- ============================== -->
                <VerticalStackLayout IsVisible="{Binding IsBrowsing}" Spacing="16">

                    <!-- 模板列表 -->
                    <Border Style="{StaticResource CardBorder}" Padding="20">
                        <VerticalStackLayout Spacing="12">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="模板列表" Style="{StaticResource SectionTitleLabel}" Margin="0" VerticalOptions="Center"/>
                                <Label Text="{Binding Templates.Count, StringFormat='({0})'}"
                                       FontSize="14" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <BoxView Style="{StaticResource Divider}"/>

                            <CollectionView ItemsSource="{Binding Templates}"
                                            SelectionMode="Single"
                                            SelectedItem="{Binding SelectedTemplate}"
                                            HeightRequest="320">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="ent:Template">
                                        <Border StrokeShape="RoundRectangle 8" StrokeThickness="1"
                                                Stroke="{StaticResource Gray200}"
                                                BackgroundColor="{StaticResource Gray50}"
                                                Padding="12" Margin="0,4">
                                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12">
                                                <BoxView Grid.Column="0" WidthRequest="4" CornerRadius="2"
                                                         Color="{Binding FileType, Converter={StaticResource TemplateTypeToColorConverter}}"
                                                         VerticalOptions="Fill"/>
                                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                                    <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold"
                                                           TextColor="{StaticResource TextPrimary}"/>
                                                    <HorizontalStackLayout Spacing="8">
                                                        <Border Style="{StaticResource ChipInfo}" VerticalOptions="Center">
                                                            <Label Text="{Binding FileType}" Style="{StaticResource ChipInfoText}"/>
                                                        </Border>
                                                        <Label Text="{Binding Categories, Converter={StaticResource CategoryDisplayConverter}}"
                                                               FontSize="14" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center"/>
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16" TextColor="{StaticResource Gray400}"
                                                       VerticalOptions="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <Label Text="暂无模板" Style="{StaticResource EmptyStateLabel}"/>
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 模板详情 -->
                    <Border Style="{StaticResource CardBorder}" Padding="20"
                            IsVisible="{Binding HasSelectedTemplate}">
                        <VerticalStackLayout Spacing="16">
                            <!-- 标题 + 类型标签 -->
                            <Grid ColumnDefinitions="*, Auto">
                                <Label Grid.Column="0" Text="{Binding SelectedTemplate.Name}"
                                       FontSize="18" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                <Border Grid.Column="1"
                                        BackgroundColor="{Binding SelectedTemplate.FileType, Converter={StaticResource TemplateTypeToColorConverter}}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 999"
                                        Padding="12,4"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding SelectedTemplate.FileType}" FontSize="12"
                                           TextColor="{StaticResource White}" FontAttributes="Bold"/>
                                </Border>
                            </Grid>

                            <BoxView Style="{StaticResource Divider}"/>

                            <!-- 基本信息 -->
                            <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, *"
                                  RowSpacing="10" ColumnSpacing="12">
                                <Label Grid.Row="0" Grid.Column="0" Text="创建时间:"
                                       FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding SelectedTemplate.CreatedAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}"
                                       FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                <Label Grid.Row="1" Grid.Column="0" Text="分类标签:"
                                       FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding SelectedTemplate.Categories, Converter={StaticResource CategoryDisplayConverter}}"
                                       FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                <Label Grid.Row="2" Grid.Column="0" Text="更新时间:"
                                       FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                <Label Grid.Row="2" Grid.Column="1"
                                       Text="{Binding SelectedTemplate.UpdatedAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}"
                                       FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                            </Grid>

                            <!-- 配置 JSON -->
                            <BoxView Style="{StaticResource Divider}"/>
                            <Label Text="字段映射配置" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                            <ScrollView HeightRequest="160">
                                <Border BackgroundColor="{StaticResource Gray100}"
                                        StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray200}"
                                        StrokeThickness="1" Padding="12">
                                    <Grid>
                                        <Label Text="{Binding SelectedTemplate.ConfigJson, TargetNullValue='暂无配置'}"
                                               FontSize="14" FontFamily="Consolas"
                                               TextColor="{StaticResource TextPrimary}"
                                               IsVisible="{Binding IsEditingConfig, Converter={StaticResource BoolToInverseConverter}}"/>
                                        <Editor Text="{Binding EditingConfigJson}"
                                                FontSize="14" FontFamily="Consolas"
                                                TextColor="{StaticResource TextPrimary}"
                                                IsVisible="{Binding IsEditingConfig}"/>
                                    </Grid>
                                </Border>
                            </ScrollView>

                            <!-- 分类编辑 -->
                            <BoxView Style="{StaticResource Divider}"/>
                            <Label Text="所属分类" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                            <Border BackgroundColor="{StaticResource Gray50}"
                                    StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray200}"
                                    StrokeThickness="1" Padding="12"
                                    IsVisible="{Binding IsEditingCategories, Converter={StaticResource BoolToInverseConverter}}">
                                <Label Text="{Binding SelectedTemplate.Categories, Converter={StaticResource CategoryDisplayConverter}, TargetNullValue='暂无分类'}"
                                       FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                            </Border>
                            <Border BackgroundColor="{StaticResource Gray50}"
                                    StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray200}"
                                    StrokeThickness="1" Padding="12" HeightRequest="280"
                                    IsVisible="{Binding IsEditingCategories}">
                                <ScrollView>
                                    <VerticalStackLayout Spacing="1"
                                        BindableLayout.ItemsSource="{Binding FlattenedNodes}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="cat:TemplateCategoryNode">
                                                <Grid Padding="{Binding Depth, Converter={StaticResource DepthToMarginConverter}}"
                                                      ColumnDefinitions="28, *" ColumnSpacing="8"
                                                      HeightRequest="34">
                                                    <Label Grid.Column="0"
                                                           Text="{Binding IsExpanded, Converter={StaticResource BoolToExpandIconConverter}}"
                                                           FontSize="14" VerticalOptions="Center"
                                                           HorizontalOptions="Center"
                                                           IsVisible="{Binding IsLeaf, Converter={StaticResource BoolToInverseConverter}}">
                                                        <Label.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding ToggleSelfCommand}"/>
                                                        </Label.GestureRecognizers>
                                                    </Label>
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsChecked}"
                                                              IsVisible="{Binding IsLeaf}"
                                                              Color="{StaticResource Primary}"
                                                              VerticalOptions="Center"/>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding Label}" FontSize="14"
                                                           FontAttributes="{Binding Depth, Converter={StaticResource DepthToBoldConverter}}"
                                                           VerticalOptions="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </ScrollView>
                            </Border>

<!-- 操作按钮 -->
                             <BoxView Style="{StaticResource Divider}"/>
                             <Grid ColumnDefinitions="*" HorizontalOptions="End">
                                 <HorizontalStackLayout Spacing="12" HorizontalOptions="End"
                                         IsVisible="{Binding IsNotEditing}">
                                     <Button Text="&#xE74E; 导出" FontFamily="Segoe Fluent Icons"
                                             Style="{StaticResource ButtonPrimary}"
                                             Command="{Binding DownloadCommand}" WidthRequest="120"/>
                                     <Button Text="&#xE777; 变更文件" FontFamily="Segoe Fluent Icons"
                                             Style="{StaticResource ButtonSecondary}"
                                             Command="{Binding ReplaceFileCommand}" WidthRequest="130"/>
                                     <Button Text="&#xE843; 修改字段映射" FontFamily="Segoe Fluent Icons"
                                             Style="{StaticResource ButtonOutline}"
                                             Command="{Binding EditConfigCommand}" WidthRequest="160"/>
                                     <Button Text="&#xE8F1; 修改分类" FontFamily="Segoe Fluent Icons"
                                             Style="{StaticResource ButtonOutline}"
                                             Command="{Binding EditCategoriesCommand}" WidthRequest="120"/>
                                     <Button Text="&#xE73A; 上移" FontFamily="Segoe Fluent Icons"
                                             Style="{StaticResource ButtonOutline}"
                                             Command="{Binding MoveUpCommand}" WidthRequest="80"/>
                                     <Button Text="&#xE73B; 下移" FontFamily="Segoe Fluent Icons"
                                             Style="{StaticResource ButtonOutline}"
                                             Command="{Binding MoveDownCommand}" WidthRequest="80"/>
                                     <Button Text="&#xE74D; 删除" FontFamily="Segoe Fluent Icons"
                                             Style="{StaticResource ButtonDanger}"
                                             Command="{Binding DeleteCommand}" WidthRequest="120"/>
                                 </HorizontalStackLayout>
                                 <HorizontalStackLayout Spacing="12" HorizontalOptions="End"
                                         IsVisible="{Binding IsEditingConfig}">
                                     <Button Text="&#xE74E; 保存配置" FontFamily="Segoe Fluent Icons"
                                             Style="{StaticResource ButtonPrimary}"
                                             Command="{Binding SaveConfigCommand}" WidthRequest="130"/>
                                     <Button Text="取消" Style="{StaticResource ButtonOutline}"
                                             Command="{Binding CancelEditConfigCommand}" WidthRequest="100"/>
                                 </HorizontalStackLayout>
                                 <HorizontalStackLayout Spacing="12" HorizontalOptions="End"
                                         IsVisible="{Binding IsEditingCategories}">
                                     <Button Text="&#xE74E; 保存分类" FontFamily="Segoe Fluent Icons"
                                             Style="{StaticResource ButtonPrimary}"
                                             Command="{Binding SaveCategoriesCommand}" WidthRequest="130"/>
                                     <Button Text="取消" Style="{StaticResource ButtonOutline}"
                                             Command="{Binding CancelEditCategoriesCommand}" WidthRequest="100"/>
                                 </HorizontalStackLayout>
                             </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 未选择时的占位提示 -->
                    <Border Style="{StaticResource CardBorder}" Padding="20"
                            IsVisible="{Binding HasSelectedTemplate, Converter={StaticResource BoolToInverseConverter}}">
                        <Label Text="请从上方列表选择一个模板" Style="{StaticResource EmptyStateLabel}"/>
                    </Border>
                </VerticalStackLayout>

                <!-- ============================== -->
                <!-- 上传模式: 上传表单               -->
                <!-- ============================== -->
                <VerticalStackLayout IsVisible="{Binding IsUploadFormVisible}" Spacing="16">

                    <Border Style="{StaticResource CardBorder}" Padding="20">
                        <VerticalStackLayout Spacing="16">
                            <Label Text="上传新模板" Style="{StaticResource SectionTitleLabel}" Margin="0"/>

                            <BoxView Style="{StaticResource Divider}"/>

                            <!-- 文件选择 -->
                            <VerticalStackLayout Spacing="8">
                                <Label Text="模板文件" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextSecondary}"/>
                                <Border BackgroundColor="{StaticResource Gray50}"
                                        StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray200}"
                                        StrokeThickness="1" Padding="12">
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="{Binding FileName, TargetNullValue='未选择文件'}"
                                               FontSize="14" VerticalOptions="Center" LineBreakMode="TailTruncation"
                                               TextColor="{StaticResource TextPrimary}"/>
                                        <Button Grid.Column="1" Text="选择文件" Command="{Binding SelectFileCommand}"
                                                Style="{StaticResource ButtonOutline}"
                                                HeightRequest="36" WidthRequest="100"/>
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>

                            <!-- 名称 / 类型 -->
                            <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" Text="模板名称" FontSize="14"
                                       TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                <Entry Grid.Column="1" Text="{Binding TemplateName}"
                                       Placeholder="输入模板名称" HeightRequest="40"/>
                                <Label Grid.Column="2" Text="类型" FontSize="14"
                                       TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                <Picker Grid.Column="3" ItemsSource="{Binding TemplateTypes}"
                                        SelectedItem="{Binding TemplateType}"
                                        WidthRequest="100" HeightRequest="40"/>
                            </Grid>

                            <!-- 分类 + 配置 两列布局 -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                                <!-- 左列: 分类选择 -->
                                <VerticalStackLayout Grid.Column="0" Spacing="8">
                                    <Label Text="分类选择" FontSize="14" FontAttributes="Bold"
                                           TextColor="{StaticResource TextSecondary}"/>
                                    <Border BackgroundColor="{StaticResource Gray50}"
                                            StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray200}"
                                            StrokeThickness="1" Padding="12" HeightRequest="280">
                                        <ScrollView>
                                            <VerticalStackLayout Spacing="1"
                                                BindableLayout.ItemsSource="{Binding FlattenedNodes}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="cat:TemplateCategoryNode">
                                                        <Grid Padding="{Binding Depth, Converter={StaticResource DepthToMarginConverter}}"
                                                              ColumnDefinitions="28, *" ColumnSpacing="8"
                                                              HeightRequest="34">
                                                            <Label Grid.Column="0"
                                                                   Text="{Binding IsExpanded, Converter={StaticResource BoolToExpandIconConverter}}"
                                                                   FontSize="14" VerticalOptions="Center"
                                                                   HorizontalOptions="Center"
                                                                   IsVisible="{Binding IsLeaf, Converter={StaticResource BoolToInverseConverter}}">
                                                                <Label.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding ToggleSelfCommand}"/>
                                                                </Label.GestureRecognizers>
                                                            </Label>
                                                            <CheckBox Grid.Column="0"
                                                                      IsChecked="{Binding IsChecked}"
                                                                      IsVisible="{Binding IsLeaf}"
                                                                      Color="{StaticResource Primary}"
                                                                      VerticalOptions="Center"/>
                                                            <Label Grid.Column="1"
                                                                   Text="{Binding Label}" FontSize="14"
                                                                   FontAttributes="{Binding Depth, Converter={StaticResource DepthToBoldConverter}}"
                                                                   VerticalOptions="Center"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </ScrollView>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- 右列: 字段映射配置 -->
                                <VerticalStackLayout Grid.Column="1" Spacing="8">
                                    <Label Text="字段映射配置 (JSON)" FontSize="14" FontAttributes="Bold"
                                           TextColor="{StaticResource TextSecondary}"/>
                                    <Label Text="定义占位符与数据源的对应关系" FontSize="14"
                                           TextColor="{StaticResource TextTertiary}"/>
                                    <Border BackgroundColor="{StaticResource Gray50}"
                                            StrokeShape="RoundRectangle 8" Stroke="{StaticResource Gray200}"
                                            StrokeThickness="1" Padding="12">
                                        <Editor Text="{Binding ConfigJson}"
                                                Placeholder='{}{"fields":[{"placeholder":"{户主姓名}","fieldKey":"HEAD_NAME"}]}'
                                                HeightRequest="242" FontFamily="Consolas" FontSize="14"
                                                TextColor="{StaticResource TextPrimary}"/>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- 操作按钮 -->
                            <BoxView Style="{StaticResource Divider}"/>
                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                                <Button Grid.Column="1" Text="取消" Command="{Binding ToggleUploadFormCommand}"
                                        Style="{StaticResource ButtonOutline}" WidthRequest="100"/>
                                <Button Grid.Column="2" Text="上传模板" Command="{Binding UploadCommand}"
                                        Style="{StaticResource ButtonPrimary}" WidthRequest="120"/>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 全局加载指示器 -->
        <components:LoadingOverlay Grid.Row="0" Grid.RowSpan="3"
                                   IsLoading="{Binding IsBusy}"
                                   LoadingText="正在加载模板..."/>
        <components:LoadingOverlay Grid.Row="0" Grid.RowSpan="3"
                                   IsLoading="{Binding IsUploading}"
                                   LoadingText="正在上传..."/>
    </Grid>
</ContentPage>