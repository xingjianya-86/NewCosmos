<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Pages.ChangeManagement.GracePeriodConfirmPage"
             x:DataType="GracePeriodConfirmViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <!-- 渐变英雄头部（蓝色） -->
        <!-- 统一页头（纸墨档案风报头 · Phase 6 特殊页：业务信息迁入 Stats 插槽） -->
        <components:PageHeaderView Grid.Row="0"
                                   Glyph="{OnPlatform WinUI='&#xE716;', Android='&#x2139;&#xFE0F;'}"
                                   Title="{Binding Title}"
                                   Subtitle="{Binding Subtitle}"
                                   BackCommand="{Binding CancelCommand}"
                                   BackText="返回">
        </components:PageHeaderView>

        <!-- 内容区域 -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- 分类变化 -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="分类变化" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="渐退前原分类" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                <Label Text="{Binding OriginalClassification}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{OnPlatform WinUI='&#xE72A;', Android='&#x2753;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="本次判定分类" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                <Label Text="{Binding NewClassification}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 收入与标准 -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="收入与标准" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="低保标准（元/人·月）" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                <Label Text="{Binding SubsistenceStandardText}" FontSize="17" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="月人均收入（元）" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                <Label Text="{Binding PerCapitaMonthlyText}" FontSize="17" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Spacing="2">
                                <Label Text="年家庭总收入（元）" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                <Label Text="{Binding TotalAnnualIncomeText}" FontSize="17" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="2">
                                <Label Text="家庭人数（人）" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                <Label Text="{Binding FamilySizeText}" FontSize="17" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 保障金与渐退期 -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="保障金与渐退期" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="保障金额（元/月）" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                <Label Text="{Binding GuaranteeAmountText}" FontSize="17" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="渐退期区间" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                <Label Text="{Binding PeriodText}" FontSize="16" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                        <!-- 分类施保变化（户主死亡进入渐退期减去死者份额等链档案场景，原=现隐藏） -->
                        <VerticalStackLayout Spacing="2" IsVisible="{Binding IsClassifiedChangeVisible}">
                            <Label Text="分类施保" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                            <Label Text="{Binding ClassifiedChangeText}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="渐退期月数（1–12）" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                            <Picker ItemsSource="{Binding MonthOptions}"
                                    SelectedItem="{Binding SelectedMonth}"
                                    Style="{StaticResource FormFieldPickerStyle}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 提示 -->
                <Border Style="{StaticResource CardBorder}" BackgroundColor="{StaticResource WarningSoft}" Stroke="Transparent">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="{OnPlatform WinUI='&#xE7BA;', Android='&#x26A0;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="22" TextColor="{StaticResource WarningDark}" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding HintText}" FontSize="14" TextColor="{StaticResource WarningDark}"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 底部按钮栏 -->
        <Border Grid.Row="2" BackgroundColor="White" Padding="20,12" StrokeThickness="0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <Button Grid.Column="1" Text="确认进入渐退期" Style="{StaticResource ButtonPrimary}" Command="{Binding ConfirmCommand}" MinimumWidthRequest="120"/>
                <Button Grid.Column="2" Text="取消" Style="{StaticResource ButtonOutline}" Command="{Binding CancelCommand}" MinimumWidthRequest="100"/>
            </Grid>
        </Border>

    </Grid>

</ContentPage>
