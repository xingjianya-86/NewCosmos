<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Pages.ChangeManagement.MemberChangeReasonPopup"
             x:DataType="MemberChangeReasonPopupViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <!-- 渐变英雄头部（绿色） -->
        <!-- 统一页头（纸墨档案风报头 · Phase 6 特殊页：业务信息迁入 Stats 插槽） -->
        <components:PageHeaderView Grid.Row="0"
                                   Glyph="{OnPlatform WinUI='&#xE716;', Android='&#x2139;&#xFE0F;'}"
                                   Title="{Binding Title}"
                                   Subtitle="{Binding Subtitle}"
                                   BackCommand="{Binding CancelCommand}"
                                   BackText="返回">
        </components:PageHeaderView>

        <!-- 内容区域 -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- 成员信息（减员时只读展示） -->
                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsRemoveMode}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="成员信息" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Text="{OnPlatform WinUI='&#xE77B;', Android='&#x1F464;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="34" TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="{Binding MemberName}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                <Label Text="{Binding MemberIdCard}" FontSize="16" TextColor="{StaticResource TextSecondary}"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="2" Style="{StaticResource ChipNeutral}" VerticalOptions="Center">
                                <Label Text="{Binding MemberRelationship}" Style="{StaticResource ChipNeutralText}"/>
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="年龄" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                <Label Text="{Binding MemberAge, StringFormat='{0}岁'}" FontSize="16" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="性别" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                <Label Text="{Binding MemberGender}" FontSize="16" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="健康状况" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                <Label Text="{Binding MemberHealthStatus}" FontSize="16" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 变更原因 -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding ReasonPrompt}" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                        <CollectionView ItemsSource="{Binding Reasons}" SelectionMode="Single" SelectedItem="{Binding SelectedReason}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="MemberChangeReasonOption">
                                    <Border StrokeShape="RoundRectangle 8" StrokeThickness="1"
                                            Stroke="{StaticResource Gray200}"
                                            BackgroundColor="{StaticResource Gray50}"
                                            Padding="12" Margin="0,4">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Label Text="{OnPlatform WinUI='&#xE73E;', Android='&#x2713;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18" TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding Name}" FontSize="16" TextColor="{StaticResource TextPrimary}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- 事由日期（非死亡减员/增员；死亡模式下被下方整块日期时刻取代） -->
                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsEventDateVisible}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="事由日期" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                        <DatePicker Date="{Binding EventDate}" Format="yyyy-MM-dd"/>
                    </VerticalStackLayout>
                </Border>

                <!-- 死亡日期与时刻（仅减员原因=人员死亡；必填，落 nc_biz_death_records.death_date/death_time） -->
                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsDeathTimeVisible}">
                    <VerticalStackLayout Spacing="12">
                        <components:DateTimeEntryView Title="死亡日期与时间" IsRequired="True" Value="{Binding DeathDateTime}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- 备注 -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="备注" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                        <Editor Text="{Binding Remark}" Placeholder="补充说明（选填）..." HeightRequest="80"/>
                    </VerticalStackLayout>
                </Border>

                <!-- 提示 -->
                <Border Style="{StaticResource CardBorder}" BackgroundColor="{StaticResource WarningSoft}" Stroke="Transparent">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Text="{OnPlatform WinUI='&#xE7BA;', Android='&#x26A0;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="22" TextColor="{StaticResource WarningDark}" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding HintText}" FontSize="14" TextColor="{StaticResource WarningDark}" VerticalOptions="Center"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 底部按钮栏（上方显示死亡日期时刻行内校验提示） -->
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto">
            <Label Grid.Row="0" Text="{Binding ValidationMessage}" FontSize="14" TextColor="{StaticResource Error}"
                   Margin="20,0,20,4" IsVisible="{Binding ValidationMessage, Converter={StaticResource StringNotEmptyConverter}}"/>
            <Border Grid.Row="1" BackgroundColor="White" Padding="20,12" StrokeThickness="0">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                    <Button Grid.Column="1" Text="确认" Style="{StaticResource ButtonPrimary}" Command="{Binding ConfirmCommand}" MinimumWidthRequest="100"/>
                    <Button Grid.Column="2" Text="取消" Style="{StaticResource ButtonOutline}" Command="{Binding CancelCommand}" MinimumWidthRequest="100"/>
                </Grid>
            </Border>
        </Grid>

    </Grid>

</ContentPage>
