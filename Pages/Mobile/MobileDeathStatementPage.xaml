<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Pages.Mobile.MobileDeathStatementPage"
             x:DataType="DeathStatementViewModel"
             Title="死亡情况说明"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToInverseConverter x:Key="BoolToInverseConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- 六步线性向导骨架（与桌面页同构，2026-10-30 重设计）：
         蓝条 / 范围提示 / 步进条（唯一导航层：圆点 + 当前步文字）/ 内容（六选一）/ 底部操作条 -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="0">

        <!-- Row0 蓝色标题栏 -->
        <Border Grid.Row="0" Padding="16,14" BackgroundColor="{StaticResource Primary}" StrokeThickness="0">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <components:BackButton Grid.Column="0" Command="{Binding GoBackCommand}" IconColor="White" VerticalOptions="Center"/>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <Label Text="死亡情况说明" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource White}"/>
                    <Label Text="死亡申报 · 身份聚合 · 文书出具" FontSize="14" TextColor="{StaticResource PrimarySoft}" Opacity="0.9"/>
                </VerticalStackLayout>
                <Border Grid.Column="2" BackgroundColor="{StaticResource White}" Opacity="0.95" StrokeThickness="0"
                        StrokeShape="RoundRectangle 6" Padding="8,5" VerticalOptions="Center">
                    <Label Text="{Binding VillageLabel}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Row1 范围提示（黄=镇级降级 / 红=真失败） -->
        <VerticalStackLayout Grid.Row="1">
            <Border BackgroundColor="#FFF3CD" StrokeThickness="0" Padding="14,7"
                    IsVisible="{Binding ScopeNotice, Converter={StaticResource StringNotEmptyConverter}}">
                <Label Text="{Binding ScopeNotice}" FontSize="12" TextColor="#856404" LineBreakMode="WordWrap"/>
            </Border>
            <Border BackgroundColor="#FEE2E2" StrokeThickness="0" Padding="14,7"
                    IsVisible="{Binding ScopeError, Converter={StaticResource StringNotEmptyConverter}}">
                <Label Text="{Binding ScopeError}" FontSize="12" TextColor="#7F1D1D" LineBreakMode="WordWrap"/>
            </Border>
        </VerticalStackLayout>

        <!-- Row2 步进条（唯一导航层：圆点 + 连接线 + 当前步文字） -->
        <Border Grid.Row="2" BackgroundColor="White" Padding="4,2" StrokeThickness="0">
            <VerticalStackLayout Spacing="0">
                <components:MobileStepperBar CurrentStep="{Binding CurrentStep}" StepCount="{Binding TotalSteps}"
                                             StepTappedCommand="{Binding SwitchStepCommand}"/>
                <Label Text="{Binding StepTitle}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                       HorizontalOptions="Center" Margin="0,0,0,6"/>
            </VerticalStackLayout>
        </Border>

        <!-- Row3 内容（六选一） -->
        <Grid Grid.Row="3">

            <!-- 第①步 死者信息：检索条 + 表单卡 -->
            <ScrollView IsVisible="{Binding IsStep1}">
                <VerticalStackLayout Padding="12" Spacing="10">

                    <!-- 检索条 -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="从库内带出" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                                <Button Grid.Column="1" Text="手工录入" Style="{StaticResource ButtonOutline}" Command="{Binding ManualEntryCommand}"/>
                            </Grid>
                            <Entry Placeholder="姓名或身份证号" Text="{Binding SearchKeyword}" ReturnCommand="{Binding SearchCommand}" ClearButtonVisibility="WhileEditing"/>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding SearchSummary}" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                <Button Grid.Column="1" Text="搜索" Style="{StaticResource ButtonPrimary}" Command="{Binding SearchCommand}"/>
                            </Grid>
                            <CollectionView ItemsSource="{Binding SearchResults}" IsVisible="{Binding HasSearchResults}" SelectionMode="None" MaximumHeightRequest="180">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="DeathSearchItem">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="8" Style="{StaticResource TableRowInteractive}">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                                <Label Text="{Binding IdCard}" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                                <Label Text="{Binding Subtitle}" FontSize="12" TextColor="{StaticResource TextTertiary}" LineBreakMode="TailTruncation"/>
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Text="带出" Style="{StaticResource ButtonOutline}" HeightRequest="34" Padding="14,0" VerticalOptions="Center"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type DeathStatementViewModel}}, Path=SelectItemCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <!-- 表单卡① 死者信息（人） -->
                    <Border Style="{StaticResource CardBorderElevated}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="死者信息" Style="{StaticResource SectionTitleLabel}" Margin="0" VerticalOptions="Center"/>
                                <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                    <Border Style="{StaticResource ChipInfo}" VerticalOptions="Center" IsVisible="{Binding IsDeclared}">
                                        <Label Text="{Binding StatusName}" Style="{StaticResource ChipInfoText}" FontAttributes="Bold"/>
                                    </Border>
                                    <!-- 作废入口（2026-11 简化·手机孪生同步：已申报且未归档才显示） -->
                                    <Button Text="作废" Style="{StaticResource ButtonSmall}" Padding="12,0" HeightRequest="30"
                                            TextColor="{StaticResource Error}" Command="{Binding RevokeCommand}"
                                            IsEnabled="{Binding CanRevoke}"/>
                                </HorizontalStackLayout>
                            </Grid>
                            <Label Text="死者姓名" Style="{StaticResource FormFieldLabelStyle}"/>
                            <Entry Text="{Binding Name}" Style="{StaticResource FormFieldEntryStyle}" Placeholder="必填"/>
                            <Label Text="死者身份证号" Style="{StaticResource FormFieldLabelStyle}"/>
                            <Entry Text="{Binding IdCard}" Style="{StaticResource FormFieldEntryStyle}" Placeholder="18 位，必填"/>
                            <Label Text="{Binding GenderEthnicitySummary}" FontSize="14" TextColor="{StaticResource TextTertiary}"
                                   IsVisible="{Binding HasGenderEthnicity}"/>
                            <Label Text="{Binding ArchiveInfo}" FontSize="14" TextColor="{StaticResource TextPrimary}" LineBreakMode="WordWrap"
                                   IsVisible="{Binding ArchiveInfo, Converter={StaticResource StringNotEmptyConverter}}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ── 原②死亡信息（事件）并入第①步「申报信息」（三步简化 2026-11） ── -->
                    <Border Style="{StaticResource CardBorderElevated}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="死亡信息" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                            <!-- 死亡日期与时刻（组件：未选择为 null，必填校验真实生效；弹窗内限 ≤ 当前时刻） -->
                            <components:DateTimeEntryView Title="死亡日期与时间" IsRequired="True" Value="{Binding DeathDateTime}"/>
                            <Label Text="死亡原因" Style="{StaticResource FormFieldLabelStyle}"/>
                            <Picker ItemsSource="{Binding DeathReasonOptions}" SelectedItem="{Binding SelectedDeathReason}"/>
                            <Entry Text="{Binding DeathReason}" Style="{StaticResource FormFieldEntryStyle}" Placeholder="请输入其他死亡原因"
                                   IsVisible="{Binding IsDeathReasonCustom}"/>
                            <Label Text="死亡证明编号" Style="{StaticResource FormFieldLabelStyle}"/>
                            <Entry Text="{Binding DeathCertNo}" Style="{StaticResource FormFieldEntryStyle}" Placeholder="选填，缺失会进提醒"/>
                            <Label Text="死亡地点" Style="{StaticResource FormFieldLabelStyle}"/>
                            <Picker ItemsSource="{Binding DeathPlaceOptions}" SelectedItem="{Binding SelectedDeathPlace}"/>
                            <Entry Text="{Binding DeathPlace}" Style="{StaticResource FormFieldEntryStyle}" Placeholder="选「其他」时手填"
                                   IsVisible="{Binding IsDeathPlaceCustom}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ── 原③申报与报告（人证）并入第①步「申报信息」（三步简化 2026-11） ── -->
                    <Border Style="{StaticResource CardBorderElevated}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="申报人信息（类型与姓名必填）" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                            <Label Text="申报人类型" Style="{StaticResource FormFieldLabelStyle}"/>
                            <Picker ItemsSource="{Binding DeclaredByTypeOptions}" SelectedItem="{Binding DeclaredByType}"/>
                            <Label Text="申报人姓名" Style="{StaticResource FormFieldLabelStyle}"/>
                            <Entry Text="{Binding DeclaredByName}" Style="{StaticResource FormFieldEntryStyle}" Placeholder="必填"/>
                            <Label Text="申报人身份证号码（必填）" Style="{StaticResource FormFieldLabelStyle}"/>
                            <Entry Text="{Binding DeclaredByIdCard}" Style="{StaticResource FormFieldEntryStyle}" Placeholder="18 位身份证号"/>
                            <Label Text="申报人电话" Style="{StaticResource FormFieldLabelStyle}"/>
                            <Entry Text="{Binding DeclaredByPhone}" Style="{StaticResource FormFieldEntryStyle}" Placeholder="选填"/>
                            <Label Text="死者与申报人关系" Style="{StaticResource FormFieldLabelStyle}"/>
                            <Picker ItemsSource="{Binding RelationOptions}" SelectedItem="{Binding DeclaredRelation}"/>
                            <Label Text="{Binding DeclaredAtText, StringFormat='申报受理时间：{0}'}" FontSize="12" TextColor="{StaticResource TextSecondary}"
                                   IsVisible="{Binding DeclaredAtText, Converter={StaticResource StringNotEmptyConverter}}"/>

                            <BoxView Style="{StaticResource Divider}" Margin="0"/>
                            <Label Text="发现（报告）人（默认与申报人相同）" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                            <!-- 默认勾选"与申报人相同"：隐藏三输入框；取消勾选展开独立填写 -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                <CheckBox IsChecked="{Binding IsReporterSameAsDeclarer, Mode=TwoWay}"
                                          Color="{StaticResource Primary}" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="与申报人相同（姓名/关系/电话自动带入）"
                                       FontSize="14" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                            </Grid>
                            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsReporterEditable}">
                                <Label Text="报告人姓名" Style="{StaticResource FormFieldLabelStyle}"/>
                                <Entry Text="{Binding ReporterName}" Style="{StaticResource FormFieldEntryStyle}" Placeholder="最先发现或报告的人"/>
                                <Label Text="报告人与死者关系" Style="{StaticResource FormFieldLabelStyle}"/>
                                <Picker ItemsSource="{Binding RelationOptions}" SelectedItem="{Binding ReporterRelation}"/>
                                <Label Text="报告人联系电话" Style="{StaticResource FormFieldLabelStyle}"/>
                                <Entry Text="{Binding ReporterPhone}" Style="{StaticResource FormFieldEntryStyle}" Placeholder="选填"/>
                            </VerticalStackLayout>
                            <Label Text="{Binding ReporterName, StringFormat='报告人：{0}（与申报人相同）'}" FontSize="14" TextColor="{StaticResource TextSecondary}"
                                   IsVisible="{Binding IsReporterSameAsDeclarer}"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- 第②步 核实与汇总（原④核实要素 + 原⑤身份与提醒合并） -->
            <ScrollView IsVisible="{Binding IsStep2}">
                <VerticalStackLayout Padding="12" Spacing="10">
                    <Border Style="{StaticResource CardBorderElevated}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="核实说明要素（《死亡情况核实说明》正文）" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                            <Label Text="所在村（镇级账号必填，落款用）" Style="{StaticResource FormFieldLabelStyle}"/>
                            <Picker ItemsSource="{Binding VillageOptions}" SelectedItem="{Binding DeclaredVillage}"
                                    IsVisible="{Binding IsTownScope}"/>
                            <Entry Text="{Binding DeclaredVillage}" Style="{StaticResource FormFieldEntryStyle}" Placeholder="自动带出" IsReadOnly="True"
                                   IsVisible="{Binding IsTownScope, Converter={StaticResource BoolToInverseConverter}}"/>
                            <Label Text="业务办理人" Style="{StaticResource FormFieldLabelStyle}"/>
                            <Entry Text="{Binding BusinessAgent}" Style="{StaticResource FormFieldEntryStyle}" Placeholder="默认经办人"/>

                            <!-- 核实要素折叠区（2026-11 简化·手机孪生同步：字典默认值已自动填好，收起为摘要行） -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="核实要素（已按字典默认填好，点击右侧展开微调）" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                    <Label Text="{Binding VerifyDetailSummary}" FontSize="12" TextColor="{StaticResource TextTertiary}" LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="{Binding IsVerifyDetailExpanded, Converter={StaticResource BoolToExpandIconConverter}}"
                                        Style="{StaticResource ButtonSmall}" VerticalOptions="Center"
                                        Command="{Binding ToggleVerifyDetailCommand}"/>
                            </Grid>
                            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsVerifyDetailExpanded}">
                                <Label Text="相关业务事项（可多选）" Style="{StaticResource FormFieldLabelStyle}"/>
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding BusinessMatterChecks}" Spacing="2">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="BusinessMatterOption">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="2,3">
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          Color="{StaticResource Primary}" VerticalOptions="Center"/>
                                                <Label Grid.Column="1" Text="{Binding Name}" FontSize="15"
                                                       TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Label Text="现场所见情况" Style="{StaticResource FormFieldLabelStyle}"/>
                                <Picker ItemsSource="{Binding SituationOptions}" SelectedItem="{Binding SelectedSituation}"/>
                                <Editor Text="{Binding SituationDesc}" Placeholder="选预设自动填入，可微调" HeightRequest="88"/>
                                <Label Text="遗体安置情况" Style="{StaticResource FormFieldLabelStyle}"/>
                                <Picker ItemsSource="{Binding RemainsOptions}" SelectedItem="{Binding SelectedRemains}"/>
                                <Editor Text="{Binding RemainsArrangement}" Placeholder="选预设自动填入，可微调" HeightRequest="72"/>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- ── 原⑤身份与提醒并入第②步「核实与汇总」（三步简化 2026-11） ── -->
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="在库身份（本范围）" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                            <Label Text="{Binding IdentitySummary}" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                            <CollectionView ItemsSource="{Binding Identities}" SelectionMode="None" MaximumHeightRequest="220">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="DeathIdentityItem">
                                        <Grid ColumnDefinitions="110,90,*" Padding="8,6" Style="{StaticResource TableRowInteractive}">
                                            <Label Text="{Binding TypeLabel}" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                            <Label Grid.Column="1" Text="{Binding StatusLabel}" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                                            <Label Grid.Column="2" Text="{Binding Period}" FontSize="12" TextColor="{StaticResource TextTertiary}" LineBreakMode="TailTruncation"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                                <CollectionView.EmptyView>
                                    <Label Text="系统内无该人身份记录" FontSize="14" TextColor="{StaticResource TextTertiary}" Margin="0,6"/>
                                </CollectionView.EmptyView>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" IsVisible="{Binding HasReminders}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="数据信息提醒" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                            <CollectionView ItemsSource="{Binding Reminders}" SelectionMode="None" MaximumHeightRequest="220">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="DeathReminderItem">
                                        <Border Padding="8,6" Margin="0,3" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource WarningSoft}">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Message}" FontSize="14" TextColor="{StaticResource TextPrimary}"/>
                                                <Label Text="{Binding SuggestAction}" FontSize="12" TextColor="{StaticResource WarningDark}"
                                                       IsVisible="{Binding SuggestAction, Converter={StaticResource StringNotEmptyConverter}}"/>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" IsVisible="{Binding HasLinks}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="关联流程办理" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                            <CollectionView ItemsSource="{Binding Links}" SelectionMode="None" MaximumHeightRequest="220">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="DeathLinkAction">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="4,4">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                                <Label Text="{Binding StateText}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Text="{Binding ActionText}" Style="{StaticResource ButtonSmall}" VerticalOptions="Center"
                                                    IsEnabled="{Binding CanHandle}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type DeathStatementViewModel}}, Path=OpenLinkCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- 第③步 文书输出（手机端无本地 PDF 预览，只推送打印/保存） -->
            <ScrollView IsVisible="{Binding IsStep3}">
                <VerticalStackLayout Padding="12" Spacing="10">
                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="文书模板" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                            <Label Text="{Binding SelectedTemplateName, StringFormat='模板：{0}'}" FontSize="14" TextColor="{StaticResource Primary}"
                                   IsVisible="{Binding HasTemplate}"/>
                            <Label Text="{Binding NoTemplateHint}" FontSize="14" TextColor="{StaticResource WarningDark}"
                                   IsVisible="{Binding HasTemplate, Converter={StaticResource BoolToInverseConverter}}"/>
                            <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}"/>
                            <Label Text="手机端不生成本地 PDF：点「推送打印」由电脑端（PC 打印代理）用默认打印机出件。" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                            <BoxView Style="{StaticResource Divider}" Margin="0"/>
                            <!-- 三联折叠区（2026-11 简化·手机孪生同步：收起显摘要行，PrintTriple 逻辑不动） -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0" Text="{Binding TripleSummary}" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                <Button Grid.Column="1" Text="{Binding IsTripleExpanded, Converter={StaticResource BoolToExpandIconConverter}}"
                                        Style="{StaticResource ButtonSmall}" VerticalOptions="Center"
                                        Command="{Binding ToggleTripleCommand}"/>
                            </Grid>
                            <Label Text="三联「推送单位」三份不同，逐份入队。" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsTripleExpanded}">
                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                    <Switch IsToggled="{Binding PrintRetain}" OnColor="{StaticResource Primary}" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="村留存" FontSize="14" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" WidthRequest="52"/>
                                    <Entry Grid.Column="2" Text="{Binding PushUnitRetain}" Placeholder="如：土甸子村村民委员会（本委存档）" FontSize="14"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                    <Switch IsToggled="{Binding PrintGov}" OnColor="{StaticResource Primary}" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="镇政府" FontSize="14" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" WidthRequest="52"/>
                                    <Entry Grid.Column="2" Text="{Binding PushUnitGov}" Placeholder="如：柳树镇人民政府" FontSize="14"/>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                                    <Switch IsToggled="{Binding PrintClinic}" OnColor="{StaticResource Primary}" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="卫生院" FontSize="14" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" WidthRequest="52"/>
                                    <Entry Grid.Column="2" Text="{Binding PushUnitClinic}" Placeholder="如：柳树镇中心卫生院" FontSize="14"/>
                                </Grid>
                            </VerticalStackLayout>
                            <Button Text="三联推送打印" Style="{StaticResource ButtonPrimary}"
                                    Command="{Binding PushPrintTripleCommand}" IsEnabled="{Binding CanPrint}"/>
                            <Button Text="完结归档（申报办结后点此，退出首页联动提醒）" Style="{StaticResource ButtonOutline}"
                                    Command="{Binding ArchiveDeclarationCommand}" IsEnabled="{Binding CanArchive}"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

        </Grid>

        <!-- Row4 底部操作条（固定常显，按步段切换按钮组）
             注意：Border.Content 为单值，三组按钮必须包在同一个父 Grid 内（同格重叠、IsVisible 互斥） -->
        <Border Grid.Row="4" BackgroundColor="White" Padding="12,10" StrokeThickness="0">
            <Grid>
                <!-- 第 1-2 步：上一步（第1步隐藏） / 重新汇总（仅第2步） / 下一步 / 提交申报 -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding IsSteps1To2}">
                    <Button Grid.Column="0" Text="上一步" Style="{StaticResource ButtonOutline}" Command="{Binding PreviousStepCommand}" IsVisible="{Binding IsPreviousVisible}" FontSize="14" Padding="12,0"/>
                    <Button Grid.Column="1" Text="重新汇总" Style="{StaticResource ButtonOutline}" Command="{Binding BuildManualContextCommand}" IsEnabled="{Binding IsNotBusy}" FontSize="14" Padding="12,0"
                            IsVisible="{Binding IsStep2}"/>
                    <Button Grid.Column="3" Text="{Binding NextStepText}" Style="{StaticResource ButtonPrimary}" Command="{Binding NextStepCommand}" FontSize="14" Padding="12,0"/>
                    <Button Grid.Column="4" Text="提交申报" Style="{StaticResource ButtonPrimary}" Command="{Binding DeclareCommand}" IsEnabled="{Binding IsNotBusy}" FontSize="14" Padding="12,0"/>
                </Grid>
                <!-- 第 3 步 -->
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsStep3}">
                    <Button Grid.Column="0" Text="上一步" Style="{StaticResource ButtonOutline}" Command="{Binding PreviousStepCommand}" FontSize="14" Padding="12,0"/>
                    <Button Grid.Column="1" Text="{Binding OpenOutputFolderActionText}" Style="{StaticResource ButtonOutline}" Command="{Binding OpenOutputFolderCommand}" FontSize="14" Padding="12,0"/>
                    <Button Grid.Column="2" Text="{Binding SaveActionText}" Style="{StaticResource ButtonSuccess}" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" FontSize="14" Padding="12,0"/>
                    <Button Grid.Column="3" Text="推送打印" Style="{StaticResource ButtonPrimary}" Command="{Binding PushPrintCommand}" IsEnabled="{Binding CanPrint}" FontSize="14" Padding="12,0"/>
                </Grid>
            </Grid>
        </Border>

        <components:LoadingOverlay Grid.Row="0" Grid.RowSpan="5" IsLoading="{Binding IsOverallBusy}" LoadingText="正在加载..."/>
    </Grid>
</ContentPage>
