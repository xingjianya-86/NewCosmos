<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ent="clr-namespace:NewCosmos.Models.Entities"
             x:Class="NewCosmos.Pages.Mobile.MobilePrintJobsPage"
             x:DataType="MobilePrintJobsViewModel"
             Title="打印任务"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">

        <!-- 顶部栏 -->
        <Border Grid.Row="0" Background="{StaticResource StatCardBlueGradient}" Padding="16,16,16,14">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <HorizontalStackLayout Grid.Column="0" Spacing="6">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                        </HorizontalStackLayout.GestureRecognizers>
                        <Label Text="‹" FontSize="22" TextColor="#E6FFFFFF" VerticalOptions="Center" FontAttributes="Bold"/>
                        <Label Text="返回" FontSize="14" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Button Grid.Column="2" Text="刷新" FontSize="13" BackgroundColor="White" TextColor="{StaticResource Primary}"
                            Padding="14,0" HeightRequest="36" CornerRadius="18" Command="{Binding RefreshCommand}"/>
                </Grid>
                <Label Text="打印任务" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                <Label Text="手机端推送的打印任务将在电脑端自动打印" FontSize="12" TextColor="#E6FFFFFF"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <components:StatCapsule Grid.Column="0" Value="{Binding PendingCount}" Caption="待打印（件）"/>
                    <components:StatCapsule Grid.Column="1" Value="{Binding FailedCount}" Caption="失败（件）"/>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Tab 胶囊 -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" BackgroundColor="White" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Padding="12,10" Spacing="8">
                <Border StrokeShape="RoundRectangle 16" Padding="12,7"
                        BackgroundColor="{Binding IsTab0Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#1a73e8|#EEF2F7'}">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="0"/></Border.GestureRecognizers>
                    <Label Text="全部" FontSize="13" TextColor="{Binding IsTab0Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#475569'}"/>
                </Border>
                <Border StrokeShape="RoundRectangle 16" Padding="12,7"
                        BackgroundColor="{Binding IsTab1Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#1a73e8|#EEF2F7'}">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="1"/></Border.GestureRecognizers>
                    <Label Text="待打印" FontSize="13" TextColor="{Binding IsTab1Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#475569'}"/>
                </Border>
                <Border StrokeShape="RoundRectangle 16" Padding="12,7"
                        BackgroundColor="{Binding IsTab2Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#1a73e8|#EEF2F7'}">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="2"/></Border.GestureRecognizers>
                    <Label Text="打印中" FontSize="13" TextColor="{Binding IsTab2Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#475569'}"/>
                </Border>
                <Border StrokeShape="RoundRectangle 16" Padding="12,7"
                        BackgroundColor="{Binding IsTab3Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#1a73e8|#EEF2F7'}">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="3"/></Border.GestureRecognizers>
                    <Label Text="已完成" FontSize="13" TextColor="{Binding IsTab3Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#475569'}"/>
                </Border>
                <Border StrokeShape="RoundRectangle 16" Padding="12,7"
                        BackgroundColor="{Binding IsTab4Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#1a73e8|#EEF2F7'}">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="4"/></Border.GestureRecognizers>
                    <Label Text="失败" FontSize="13" TextColor="{Binding IsTab4Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#475569'}"/>
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 任务列表 -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Jobs}" SelectionMode="None" Margin="12,8">
            <CollectionView.EmptyView>
                <Label Text="暂无打印任务" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Margin="0,32"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ent:PrintJob">
                    <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" StrokeThickness="0" Padding="14" Margin="0,5">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding TemplateName}" FontSize="15" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                                <Border Grid.Column="1" StrokeShape="RoundRectangle 8" Padding="8,2" StrokeThickness="0"
                                        BackgroundColor="{StaticResource Gray100}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Pending">
                                            <Setter Property="BackgroundColor" Value="{StaticResource WarningSoft}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Completed">
                                            <Setter Property="BackgroundColor" Value="{StaticResource SuccessSoft}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Failed">
                                            <Setter Property="BackgroundColor" Value="{StaticResource DangerSoft}"/>
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding StatusName}" FontSize="12">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Pending">
                                                <Setter Property="TextColor" Value="{StaticResource WarningDark}"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                <Setter Property="TextColor" Value="{StaticResource SecondaryDark}"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Failed">
                                                <Setter Property="TextColor" Value="{StaticResource Error}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>
                            <Label Text="{Binding JobNo, StringFormat='任务：{0}'}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                            <Label Text="{Binding BusinessDisplay}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                            <Label Text="{Binding CreatedAtDisplay, StringFormat='入队：{0}'}" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                            <Label Text="{Binding ErrorMessage}" FontSize="12" TextColor="{StaticResource Error}"
                                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                                   LineBreakMode="WordWrap"/>

                            <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                                <Button Text="重试" FontSize="12" Padding="12,0" HeightRequest="30" CornerRadius="8"
                                        IsVisible="False"
                                        BackgroundColor="{StaticResource Warning}" TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type MobilePrintJobsViewModel}}, Path=RetryCommand}"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding Status}" Value="Failed">
                                            <Setter Property="IsVisible" Value="True"/>
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="删除" FontSize="12" Padding="12,0" HeightRequest="30" CornerRadius="8"
                                        BackgroundColor="{StaticResource DangerSoft}" TextColor="{StaticResource Error}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type MobilePrintJobsViewModel}}, Path=DeleteCommand}"
                                        CommandParameter="{Binding .}"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 分页 -->
        <Border Grid.Row="3" BackgroundColor="White" StrokeThickness="0" Padding="12,8,12,14">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                <Button Text="上一页" FontSize="13" Padding="14,0" HeightRequest="38" CornerRadius="8"
                        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                        BorderColor="{StaticResource Gray200}" BorderWidth="1"
                        Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}"/>
                <Label Text="{Binding PageStatusText}" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                <Button Text="下一页" FontSize="13" Padding="14,0" HeightRequest="38" CornerRadius="8"
                        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                        BorderColor="{StaticResource Gray200}" BorderWidth="1"
                        Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"/>
            </HorizontalStackLayout>
        </Border>

        <!-- 加载蒙版 -->
        <Border Grid.Row="0" Grid.RowSpan="4" BackgroundColor="#80000000"
                IsVisible="{Binding IsBusy}" InputTransparent="True">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="White" IsVisible="{Binding IsBusy}"/>
                <Label Text="{Binding LoadingMessage}" TextColor="White" FontSize="14" HorizontalOptions="Center"
                       IsVisible="{Binding LoadingMessage, Converter={StaticResource StringNotEmptyConverter}}"/>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
