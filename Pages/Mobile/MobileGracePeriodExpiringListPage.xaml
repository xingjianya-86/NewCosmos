<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ent="clr-namespace:NewCosmos.Models.Entities"
             x:Class="NewCosmos.Pages.Mobile.MobileGracePeriodExpiringListPage"
             x:DataType="GracePeriodExpiringListViewModel"
             Title="渐退期管理"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">

        <!-- 蓝色英雄头部 -->
        <Border Grid.Row="0" Background="{StaticResource StatCardBlueGradient}" Padding="16,16,16,14">
            <VerticalStackLayout Spacing="10">
                <HorizontalStackLayout Spacing="6">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="‹" FontSize="22" TextColor="#E6FFFFFF" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Label Text="返回" FontSize="14" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Label Text="渐退期管理" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                <Label Text="进行中与已到期的渐退户统一管理" FontSize="13" TextColor="#E6FFFFFF"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <components:StatCapsule Grid.Column="0" Value="{Binding ExpiringCountText}" Caption="进行中/已到期（户）"/>
                    <components:StatCapsule Grid.Column="1" Value="{Binding ActiveCountText}" Caption="在享保障（户）"/>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- 搜索栏 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="12,8" BackgroundColor="White">
            <Entry Grid.Column="0" Placeholder="搜索申请人姓名、身份证号" Text="{Binding SearchText}"
                   HeightRequest="40" FontSize="14" ReturnCommand="{Binding SearchCommand}"/>
            <Button Grid.Column="1" Text="搜索" FontSize="13" Padding="14,0" HeightRequest="40"
                    BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="8"
                    Command="{Binding SearchCommand}"/>
        </Grid>

        <!-- 列表 -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding ExpiringItems}" SelectionMode="None" Margin="12,8">
            <CollectionView.EmptyView>
                <Label Text="暂无进行中或已到期的渐退期档案" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Margin="0,32"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ent:GracePeriodExpiringItem">
                    <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" StrokeThickness="0" Padding="14" Margin="0,5">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="{Binding ApplicantName}" FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                <Button Grid.Column="1" Text="重新核算" FontSize="12" Padding="12,0" HeightRequest="32" CornerRadius="8"
                                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type GracePeriodExpiringListViewModel}}, Path=ReReviewCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>
                            <Label Text="{Binding ApplicationNo, StringFormat='编号: {0}'}" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                            <Label Text="{Binding ApplicantIdCard}" FontSize="13" TextColor="{StaticResource TextTertiary}"/>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="渐退期" FontSize="11" TextColor="{StaticResource TextTertiary}"/>
                                    <Label Text="{Binding GracePeriodMonths, StringFormat='{0} 个月'}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding StatusText}" FontSize="11" TextColor="{StaticResource TextTertiary}"/>
                                    <Label FontSize="12" FontAttributes="Bold" Text="{Binding DurationText}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsActivePeriod}" Value="True">
                                                <Setter Property="TextColor" Value="#16A34A"/>
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsActivePeriod}" Value="False">
                                                <Setter Property="TextColor" Value="{StaticResource Error}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                            <Label Text="{Binding OriginalClassification, StringFormat='原分类：{0}'}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 分页 -->
        <Border Grid.Row="3" BackgroundColor="White" StrokeThickness="0" Padding="12,8,12,14">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                <Button Text="上一页" FontSize="13" Padding="14,0" HeightRequest="38" CornerRadius="8"
                        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                        BorderColor="{StaticResource Gray200}" BorderWidth="1"
                        Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}"/>
                <Label Text="{Binding PageStatusText}" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                <Button Text="下一页" FontSize="13" Padding="14,0" HeightRequest="38" CornerRadius="8"
                        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                        BorderColor="{StaticResource Gray200}" BorderWidth="1"
                        Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"/>
            </HorizontalStackLayout>
        </Border>

        <!-- 加载蒙版 -->
        <Border Grid.Row="0" Grid.RowSpan="4" BackgroundColor="#80000000"
                IsVisible="{Binding IsBusy}" InputTransparent="True">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="White" IsVisible="{Binding IsBusy}"/>
                <Label Text="{Binding LoadingMessage}" TextColor="White" FontSize="14" HorizontalOptions="Center"
                       IsVisible="{Binding LoadingMessage, Converter={StaticResource StringNotEmptyConverter}}"/>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
