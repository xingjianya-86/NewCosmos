<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Pages.Mobile.MobileApplicationWorkflowPage"
             x:DataType="ViewModels.SocialAssistance.ApplicationWorkflowViewModel"
             Title="业务申请工作流"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <!-- 五 Tab 共用的卡片模板：资产两 Tab 显示"建档"，申请 Tab 显示"编辑/删除"，
             差异由 WorkflowCardItem.ShowArchiveButton / ShowEditButtons 控制。 -->
        <DataTemplate x:Key="WorkflowCardTemplate" x:DataType="results:WorkflowCardItem">
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" StrokeThickness="0"
                    Padding="14" Margin="0,5">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8">
                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                            <Border IsVisible="{Binding ShowSingleRescue}" StrokeShape="RoundRectangle 6"
                                    BackgroundColor="#FEE2E2" StrokeThickness="0" Padding="6,1" VerticalOptions="Center">
                                <Label Text="单人保" FontSize="11" TextColor="#DC2626"/>
                            </Border>
                            <Border IsVisible="{Binding HasGraceNote}" StrokeShape="RoundRectangle 6"
                                    BackgroundColor="#FEF3C7" StrokeThickness="0" Padding="6,1" VerticalOptions="Center">
                                <Label Text="{Binding GraceNote}" FontSize="11" TextColor="#D97706"/>
                            </Border>
                        </HorizontalStackLayout>
                        <Border Grid.Column="1" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource InfoSoft}"
                                StrokeThickness="0" Padding="8,2" VerticalOptions="Center">
                            <Label Text="{Binding StatusText}" FontSize="12" TextColor="{StaticResource PrimaryDark}"/>
                        </Border>
                    </Grid>

                    <Label Text="{Binding IdCard}" FontSize="13" TextColor="{StaticResource TextTertiary}"/>

                    <Label FontSize="13" TextColor="{StaticResource TextSecondary}" IsVisible="{Binding HasMeta}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding MetaLabel}"/><Span Text="："/><Span Text="{Binding MetaValue}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Text="{Binding Address}" FontSize="13" TextColor="{StaticResource TextSecondary}"
                           LineBreakMode="TailTruncation" IsVisible="{Binding HasAddress}"/>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Label Grid.Column="0" Text="{Binding Time, StringFormat='{0:yyyy-MM-dd HH:mm}'}"
                               FontSize="12" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center"/>

                        <!-- 资产核查两 Tab：建档 -->
                        <Button Grid.Column="1" Text="建档" FontSize="12" Padding="12,0" HeightRequest="32"
                                CornerRadius="8" BackgroundColor="{StaticResource Primary}" TextColor="White"
                                IsVisible="{Binding ShowArchiveButton}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ViewModels.SocialAssistance.ApplicationWorkflowViewModel}}, Path=NavigateToArchiveProductionCommand}"
                                CommandParameter="{Binding .}"/>

                        <!-- 已完结 Tab：查看档案（只读） -->
                        <Button Grid.Column="1" Text="查看档案" FontSize="12" Padding="12,0" HeightRequest="32"
                                CornerRadius="8" BackgroundColor="{StaticResource Primary}" TextColor="White"
                                IsVisible="{Binding ShowViewArchiveButton}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ViewModels.SocialAssistance.ApplicationWorkflowViewModel}}, Path=ViewArchiveCommand}"
                                CommandParameter="{Binding .}"/>

                        <!-- 草稿 / 已建档 Tab：编辑 + 删除 -->
                        <Button Grid.Column="1" Text="编辑" FontSize="12" Padding="12,0" HeightRequest="32"
                                CornerRadius="8" BackgroundColor="{StaticResource Primary}" TextColor="White"
                                IsVisible="{Binding ShowEditButtons}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ViewModels.SocialAssistance.ApplicationWorkflowViewModel}}, Path=EditDraftCommand}"
                                CommandParameter="{Binding .}"/>
                        <Button Grid.Column="2" Text="删除" FontSize="12" Padding="12,0" HeightRequest="32"
                                CornerRadius="8" BackgroundColor="{StaticResource DangerSoft}" TextColor="{StaticResource Error}"
                                IsVisible="{Binding ShowEditButtons}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ViewModels.SocialAssistance.ApplicationWorkflowViewModel}}, Path=DeleteDraftCommand}"
                                CommandParameter="{Binding .}"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="0">

        <!-- 蓝色英雄头部 -->
        <Border Grid.Row="0" Background="{StaticResource StatCardBlueGradient}" Padding="16,16,16,14">
            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout Spacing="6">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="‹" FontSize="22" TextColor="#E6FFFFFF" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Label Text="返回" FontSize="14" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Label Text="业务申请工作流" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                <Label Text="资产核查转建档 · 草稿续办 · 档案编辑" FontSize="13" TextColor="#E6FFFFFF"/>
            </VerticalStackLayout>
        </Border>

        <!-- Tab 胶囊 -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" BackgroundColor="White" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Padding="12,10" Spacing="8">
                <Border BackgroundColor="{Binding IsTab0Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#1a73e8|#EEF2F7'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14,7">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="0"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="已提交" FontSize="13" VerticalOptions="Center"
                               TextColor="{Binding IsTab0Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#475569'}"/>
                        <Label Text="{Binding SubmittedCount}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                               TextColor="{Binding IsTab0Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#1a73e8'}"/>
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="{Binding IsTab1Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#1a73e8|#EEF2F7'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14,7">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="1"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="有报告" FontSize="13" VerticalOptions="Center"
                               TextColor="{Binding IsTab1Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#475569'}"/>
                        <Label Text="{Binding HasReportCount}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                               TextColor="{Binding IsTab1Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#1a73e8'}"/>
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="{Binding IsTab2Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#1a73e8|#EEF2F7'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14,7">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="2"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="草稿" FontSize="13" VerticalOptions="Center"
                               TextColor="{Binding IsTab2Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#475569'}"/>
                        <Label Text="{Binding DraftCount}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                               TextColor="{Binding IsTab2Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#1a73e8'}"/>
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="{Binding IsTab3Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#1a73e8|#EEF2F7'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14,7">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="3"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="已建档" FontSize="13" VerticalOptions="Center"
                               TextColor="{Binding IsTab3Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#475569'}"/>
                        <Label Text="{Binding ArchiveBuiltCount}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                               TextColor="{Binding IsTab3Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#1a73e8'}"/>
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="{Binding IsTab4Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#1a73e8|#EEF2F7'}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14,7">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="4"/></Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="已完结" FontSize="13" VerticalOptions="Center"
                               TextColor="{Binding IsTab4Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#475569'}"/>
                        <Label Text="{Binding ArchiveCompletedCount}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                               TextColor="{Binding IsTab4Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#1a73e8'}"/>
                    </HorizontalStackLayout>
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- 搜索栏 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="12,6" BackgroundColor="White">
            <Entry Grid.Column="0" Placeholder="搜索姓名/身份证号" Text="{Binding SearchText}"
                   HeightRequest="40" FontSize="14" ReturnCommand="{Binding SearchCommand}"/>
            <Button Grid.Column="1" Text="搜索" FontSize="13" Padding="14,0" HeightRequest="40"
                    BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="8"
                    Command="{Binding SearchCommand}"/>
        </Grid>

        <!-- 列表区：五 Tab 复用同一模板 -->
        <Grid Grid.Row="3">
            <CollectionView ItemsSource="{Binding SubmittedItems}" ItemTemplate="{StaticResource WorkflowCardTemplate}"
                            IsVisible="{Binding IsTab0Selected}" Margin="12,8" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="暂无已提交的资产核查" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Margin="0,32"/>
                </CollectionView.EmptyView>
            </CollectionView>
            <CollectionView ItemsSource="{Binding HasReportItems}" ItemTemplate="{StaticResource WorkflowCardTemplate}"
                            IsVisible="{Binding IsTab1Selected}" Margin="12,8" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="暂无可建档的报告" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Margin="0,32"/>
                </CollectionView.EmptyView>
            </CollectionView>
            <CollectionView ItemsSource="{Binding DraftItems}" ItemTemplate="{StaticResource WorkflowCardTemplate}"
                            IsVisible="{Binding IsTab2Selected}" Margin="12,8" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="暂无草稿" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Margin="0,32"/>
                </CollectionView.EmptyView>
            </CollectionView>
            <CollectionView ItemsSource="{Binding ArchiveBuiltItems}" ItemTemplate="{StaticResource WorkflowCardTemplate}"
                            IsVisible="{Binding IsTab3Selected}" Margin="12,8" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="暂无已建档申请" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Margin="0,32"/>
                </CollectionView.EmptyView>
            </CollectionView>
            <CollectionView ItemsSource="{Binding ArchiveCompletedItems}" ItemTemplate="{StaticResource WorkflowCardTemplate}"
                            IsVisible="{Binding IsTab4Selected}" Margin="12,8" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="暂无已完结档案" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Margin="0,32"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <!-- 分页 -->
        <Border Grid.Row="4" BackgroundColor="White" StrokeThickness="0" Padding="12,8,12,14">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                <Button Text="上一页" FontSize="13" Padding="14,0" HeightRequest="38" CornerRadius="8"
                        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                        BorderColor="{StaticResource Gray200}" BorderWidth="1"
                        Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}"/>
                <Label Text="{Binding PageStatusText}" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                <Button Text="下一页" FontSize="13" Padding="14,0" HeightRequest="38" CornerRadius="8"
                        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                        BorderColor="{StaticResource Gray200}" BorderWidth="1"
                        Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"/>
            </HorizontalStackLayout>
        </Border>

        <!-- 加载蒙版 -->
        <Border Grid.Row="0" Grid.RowSpan="5" BackgroundColor="#80000000"
                IsVisible="{Binding IsBusy}" InputTransparent="True">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="White" IsVisible="{Binding IsBusy}"/>
                <Label Text="{Binding LoadingMessage}" TextColor="White" FontSize="14" HorizontalOptions="Center"
                       IsVisible="{Binding LoadingMessage, Converter={StaticResource StringNotEmptyConverter}}"/>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
