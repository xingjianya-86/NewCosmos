<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ent="clr-namespace:NewCosmos.Models.Entities"
             x:Class="NewCosmos.Pages.Mobile.MobileArchivePhotoPage"
             x:DataType="MobileArchivePhotoViewModel"
             Title="档案照片"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="0">

        <!-- 顶部栏 -->
        <!-- 统一页头（纸墨档案风报头 · Phase 6 移动端；业务信息/统计迁入 Stats） -->
        <components:PageHeaderView Grid.Row="0"
                                   Title="档案照片"
                                   Subtitle="{Binding ApplicantName, StringFormat='申请人：{0}'}"
                                   BackCommand="{Binding GoBackCommand}"
                                   BackText="返回">
            <components:PageHeaderView.Stats>
                <VerticalStackLayout Spacing="10">
            <Label Text="采集证件与核查照片，按类别归档（仅存内网）" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
            <Border IsVisible="{Binding HasSession}" BackgroundColor="White" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8" Padding="10,6" Margin="0,4,0,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding SessionText}" FontSize="14" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                                    <Button Grid.Column="1" Text="{Binding SessionActionText}"
                                            FontSize="14" Padding="12,0" HeightRequest="32" CornerRadius="8"
                                            BackgroundColor="{StaticResource Primary}" TextColor="{StaticResource Ink}"
                                            Command="{Binding NextPersonCommand}"/>
                                </Grid>
                            </Border>
                </VerticalStackLayout>
            </components:PageHeaderView.Stats>
        </components:PageHeaderView>

        <!-- 类别选择 + 采集按钮 -->
        <Border Grid.Row="1" BackgroundColor="White" Padding="12,10" Margin="12,8" StrokeThickness="0" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="照片类别" FontSize="14" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding CategoryOptions}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedCategoryOption, Mode=TwoWay}"
                            FontSize="15"
                            TextColor="{StaticResource TextPrimary}"
                            BackgroundColor="Transparent"
                            HorizontalOptions="Fill"/>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="拍照" FontSize="15" BackgroundColor="{StaticResource Primary}" TextColor="White"
                            HeightRequest="40" CornerRadius="10" Command="{Binding TakePhotoCommand}"/>
                    <Button Grid.Column="1" Text="从相册选择" FontSize="15" BackgroundColor="{StaticResource SuccessSoft}" TextColor="{StaticResource SecondaryDark}"
                            HeightRequest="40" CornerRadius="10" Command="{Binding PickPhotoCommand}"/>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- 当前类别小计 -->
        <Label Grid.Row="2"
               Text="{Binding SelectedCategoryName, StringFormat='当前类别：{0}'}"
               FontSize="14" TextColor="{StaticResource TextTertiary}" Margin="16,0,16,4"/>

        <!-- 照片列表 -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding Photos}" SelectionMode="None" Margin="12,4">
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="20" Spacing="8" VerticalOptions="Center">
                    <Label Text="📷" FontSize="30" HorizontalOptions="Center" TextColor="{StaticResource TextTertiary}"/>
                    <Label Text="该类别暂无照片，点击上方按钮采集" FontSize="14"
                           TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ent:ArchivePhoto">
                    <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" StrokeThickness="0" Padding="14" Margin="0,5">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" RowDefinitions="Auto,Auto" RowSpacing="4">
                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding DisplayName}"
                                   FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding CreatedAt, StringFormat='采集：{0:yyyy-MM-dd HH:mm}'}"
                                   FontSize="14" TextColor="{StaticResource TextTertiary}"/>

                            <Button Grid.Row="0" Grid.Column="1"
                                    Text="打印" FontSize="14" Padding="12,0" HeightRequest="30" CornerRadius="8"
                                    BackgroundColor="{StaticResource Primary}" TextColor="White"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type MobileArchivePhotoViewModel}}, Path=PrintPhotoCommand}"
                                    CommandParameter="{Binding .}"/>
                            <Button Grid.Row="1" Grid.Column="1"
                                    Text="删除" FontSize="14" Padding="12,0" HeightRequest="30" CornerRadius="8"
                                    BackgroundColor="{StaticResource DangerSoft}" TextColor="{StaticResource Error}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type MobileArchivePhotoViewModel}}, Path=DeletePhotoCommand}"
                                    CommandParameter="{Binding .}"/>
                            <Button Grid.Row="0" Grid.Column="2"
                                    Text="导出" FontSize="14" Padding="12,0" HeightRequest="30" CornerRadius="8"
                                    BackgroundColor="{StaticResource SuccessSoft}" TextColor="{StaticResource SecondaryDark}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type MobileArchivePhotoViewModel}}, Path=ExportPhotoCommand}"
                                    CommandParameter="{Binding .}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 底部：批量识别按钮 + 说明 -->
        <Border Grid.Row="4" BackgroundColor="White" Padding="14,10" Margin="12,8" StrokeThickness="0" StrokeShape="RoundRectangle 12">
            <VerticalStackLayout Spacing="8">
                <Button Text="批量扫描识别" FontSize="15" HeightRequest="44" CornerRadius="10"
                        BackgroundColor="{StaticResource Primary}" TextColor="White"
                        IsVisible="{Binding IsRecognizeVisible}"
                        Command="{Binding BatchRecognizeCommand}"/>
                <Label Text="照片属公民身份敏感信息，仅存内网数据库，不上传外网。打印功能后续开放。"
                       FontSize="12" TextColor="{StaticResource TextTertiary}" LineBreakMode="WordWrap"/>
            </VerticalStackLayout>
        </Border>

        <!-- 加载蒙版（含批量识别进度：正在识别 n/m…） -->
        <Border Grid.Row="0" Grid.RowSpan="5" BackgroundColor="#80000000"
                IsVisible="{Binding IsBusy}" InputTransparent="False">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="White" HorizontalOptions="Center"/>
                <Label Text="{Binding LoadingMessage}" TextColor="White" FontSize="15"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                <Label Text="图片仅发送至内网识别服务，小图约 15 秒/张、大图约 1–3 分钟/张"
                       TextColor="#CCFFFFFF" FontSize="12" HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
