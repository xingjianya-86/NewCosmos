<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ent="clr-namespace:NewCosmos.Models.Entities"
             x:Class="NewCosmos.Pages.Mobile.MobileHouseholdDeathChangePage"
             x:DataType="HouseholdDeathChangeViewModel"
             Title="户主死亡变更"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">

        <!-- 绿色英雄头部 -->
        <!-- 统一页头（纸墨档案风报头 · Phase 6 移动端；业务信息/统计迁入 Stats） -->
        <components:PageHeaderView Grid.Row="0"
                                   Title="户主死亡变更"
                                   Subtitle="原户主整户停止，选择新户主建立新档案"
                                   BackCommand="{Binding GoBackCommand}"
                                   BackText="返回">
        </components:PageHeaderView>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="12" Spacing="12">

                <!-- 原户主信息 -->
                <Border Style="{StaticResource CardBorder}" BackgroundColor="{StaticResource Gray50}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="原户主信息（只读）" FontSize="14" TextColor="{StaticResource TextSecondary}"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowSpacing="8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="姓名" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                                <Label Text="{Binding OriginalHeadName}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="家庭人口" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                                <Label Text="{Binding OriginalFamilySize, StringFormat='{0}人'}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="身份证号" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                            <Label Text="{Binding OriginalHeadIdCard}" FontSize="15" TextColor="{StaticResource TextPrimary}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="当前保障" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                            <Label Text="{Binding OriginalGuaranteeAmount, StringFormat='{0:F2} 元/月'}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 死亡信息 -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="死亡信息" Style="{StaticResource SectionTitleLabel}" Margin="0" TextColor="{StaticResource Error}"/>
                        <BoxView Style="{StaticResource Divider}" Margin="0"/>
                        <!-- 死亡日期与时刻（组件：未选择为 null，必填校验真实生效；弹窗内限 ≤ 当前时刻） -->
                        <components:DateTimeEntryView Title="死亡日期与时间" IsRequired="True" Value="{Binding DeathDateTime}"/>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="死亡证明编号" Style="{StaticResource FormFieldLabelStyle}"/>
                            <Entry Text="{Binding DeathCertificateNo}" Placeholder="选填" Style="{StaticResource FormFieldEntryStyle}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="死亡原因" Style="{StaticResource FormFieldLabelStyle}"/>
                            <Picker ItemsSource="{Binding DeathReasonOptions}"
                                    SelectedItem="{Binding SelectedDeathReason}"
                                    ItemDisplayBinding="{Binding Display}"
                                    Style="{StaticResource FormFieldPickerStyle}"/>
                            <Entry Text="{Binding OtherDeathReasonText}" Placeholder="请补充说明"
                                   Style="{StaticResource FormFieldEntryStyle}"
                                   IsVisible="{Binding IsOtherReasonVisible}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- 单人户提示：整户停止，无继承人 -->
                <Border Style="{StaticResource CardBorder}" Padding="14" BackgroundColor="{StaticResource WarningSoft}"
                        IsVisible="{Binding IsSinglePersonHousehold}">
                    <Label Text="该户为单人户（户内唯一成员即户主）。户主死亡后无继承人可接任，将整户停止保障，不建立新档案。"
                           FontSize="14" TextColor="{StaticResource WarningDark}" LineBreakMode="WordWrap"/>
                </Border>

                <Label Text="请选择新户主" Style="{StaticResource SectionTitleLabel}" Margin="0"
                       IsVisible="{Binding IsNewHeadSelectionVisible}"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 可选新户主 -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding EligibleMembers}" SelectionMode="Single"
                        SelectedItem="{Binding SelectedNewHead}" Margin="12,0"
                        IsVisible="{Binding IsNewHeadSelectionVisible}">
            <CollectionView.EmptyView>
                <Label Text="暂无可选成员" Style="{StaticResource EmptyStateLabel}" Margin="0,24"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ent:FamilyMember">
                    <Border StrokeShape="RoundRectangle 10" BackgroundColor="White" StrokeThickness="0" Padding="12" Margin="0,4">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                <Label FontSize="14" TextColor="{StaticResource TextSecondary}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding RelationshipToHead, Converter={StaticResource RelationshipDisplayConverter}}"/>
                                            <Span Text=" · "/>
                                            <Span Text="{Binding Gender}"/>
                                            <Span Text=" "/>
                                            <Span Text="{Binding Age, StringFormat='{0}岁'}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding HealthStatusDisplay}" FontSize="14"
                                   TextColor="{StaticResource TextTertiary}" VerticalOptions="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 底部按钮 -->
        <Border Grid.Row="3" BackgroundColor="White" Padding="12,10,12,16" StrokeThickness="0">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Grid.Column="0" Text="返回" HeightRequest="46" CornerRadius="10" FontSize="16"
                        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                        BorderColor="{StaticResource Gray200}" BorderWidth="1"
                        Command="{Binding GoBackCommand}"/>
                <Button Grid.Column="1" Text="{Binding SubmitButtonText}" HeightRequest="46" CornerRadius="10" FontSize="16" FontAttributes="Bold"
                        BackgroundColor="{StaticResource Success}" TextColor="White"
                        Command="{Binding SubmitCommand}"/>
            </Grid>
        </Border>

        <!-- 加载蒙版 -->
        <Border Grid.Row="0" Grid.RowSpan="4" BackgroundColor="#80000000"
                IsVisible="{Binding IsBusy}" InputTransparent="True">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="White" IsVisible="{Binding IsBusy}"/>
                <Label Text="{Binding LoadingMessage}" TextColor="White" FontSize="15" HorizontalOptions="Center"
                       IsVisible="{Binding LoadingMessage, Converter={StaticResource StringNotEmptyConverter}}"/>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
