<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ent="clr-namespace:NewCosmos.Models.Entities"
             x:Class="NewCosmos.Pages.Mobile.MobileElderlyApplicationListPage"
             x:DataType="ElderlyApplicationListViewModel"
             Title="高龄津贴申请登记"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>

        <!-- 三 Tab 共用卡片：状态徽章、明细、操作按钮按父 VM 当前 Tab 显隐 -->
        <DataTemplate x:Key="ElderlyCardTemplate" x:DataType="ent:ElderlyApplication">
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" StrokeThickness="0" Padding="14" Margin="0,5">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8">
                            <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                            <Border Style="{StaticResource ChipDanger}" VerticalOptions="Center"
                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ElderlyApplicationListViewModel}}, Path=IsTab0Selected}">
                                <Label Text="草稿" Style="{StaticResource ChipDangerText}"/>
                            </Border>
                            <Border Style="{StaticResource ChipSuccess}" VerticalOptions="Center"
                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ElderlyApplicationListViewModel}}, Path=IsTab1Selected}">
                                <Label Text="在享" Style="{StaticResource ChipSuccessText}"/>
                            </Border>
                            <Border Style="{StaticResource ChipDanger}" VerticalOptions="Center"
                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ElderlyApplicationListViewModel}}, Path=IsTab2Selected}">
                                <Label Text="已停发" Style="{StaticResource ChipDangerText}"/>
                            </Border>
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="{Binding ApplicationNo, StringFormat='编号: {0}'}" FontSize="12"
                               TextColor="{StaticResource TextTertiary}" VerticalOptions="Center"/>
                    </Grid>

                    <Label Text="{Binding IdCard}" FontSize="13" TextColor="{StaticResource TextSecondary}"/>

                    <!-- 草稿明细 -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12"
                          IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ElderlyApplicationListViewModel}}, Path=IsTab0Selected}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="受理日期" FontSize="11" TextColor="{StaticResource TextTertiary}"/>
                            <Label Text="{Binding ApplyDate, StringFormat='{0:yyyy-MM-dd}'}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="享受类别" FontSize="11" TextColor="{StaticResource TextTertiary}"/>
                            <Label Text="{Binding CategoryName}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 已确认明细 -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12"
                          IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ElderlyApplicationListViewModel}}, Path=IsTab1Selected}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="计发年月" FontSize="11" TextColor="{StaticResource TextTertiary}"/>
                            <Label Text="{Binding IssueStartMonth}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="享受类别" FontSize="11" TextColor="{StaticResource TextTertiary}"/>
                            <Label Text="{Binding CategoryName}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 已停发明细 -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12"
                          IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ElderlyApplicationListViewModel}}, Path=IsTab2Selected}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="停发时间" FontSize="11" TextColor="{StaticResource TextTertiary}"/>
                            <Label Text="{Binding ActualStopDate, StringFormat='{0:yyyy-MM-dd}'}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="停发原因" FontSize="11" TextColor="{StaticResource TextTertiary}"/>
                            <Label Text="{Binding StopReason}" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- 操作按钮（草稿） -->
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="End"
                                           IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ElderlyApplicationListViewModel}}, Path=IsTab0Selected}">
                        <Button Text="确认" FontSize="12" Padding="12,0" HeightRequest="32" CornerRadius="8"
                                BackgroundColor="{StaticResource Success}" TextColor="White"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ElderlyApplicationListViewModel}}, Path=ConfirmCommand}"
                                CommandParameter="{Binding .}"/>
                        <Button Text="编辑" FontSize="12" Padding="12,0" HeightRequest="32" CornerRadius="8"
                                BackgroundColor="{StaticResource Warning}" TextColor="White"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ElderlyApplicationListViewModel}}, Path=EditCommand}"
                                CommandParameter="{Binding .}"/>
                        <Button Text="删除" FontSize="12" Padding="12,0" HeightRequest="32" CornerRadius="8"
                                BackgroundColor="{StaticResource DangerSoft}" TextColor="{StaticResource Error}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ElderlyApplicationListViewModel}}, Path=DeleteCommand}"
                                CommandParameter="{Binding .}"/>
                    </HorizontalStackLayout>

                    <!-- 操作按钮（已确认） -->
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="End"
                                           IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ElderlyApplicationListViewModel}}, Path=IsTab1Selected}">
                        <Button Text="推送打印" FontSize="12" Padding="12,0" HeightRequest="32" CornerRadius="8"
                                BackgroundColor="{StaticResource Info}" TextColor="White"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ElderlyApplicationListViewModel}}, Path=PushPrintCommand}"
                                CommandParameter="{Binding .}"/>
                        <Button Text="停发" FontSize="12" Padding="12,0" HeightRequest="32" CornerRadius="8"
                                BackgroundColor="{StaticResource Warning}" TextColor="White"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ElderlyApplicationListViewModel}}, Path=StopCommand}"
                                CommandParameter="{Binding .}"/>
                    </HorizontalStackLayout>

                    <!-- 操作按钮（已停发） -->
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="End"
                                           IsVisible="{Binding Source={RelativeSource AncestorType={x:Type ElderlyApplicationListViewModel}}, Path=IsTab2Selected}">
                        <Button Text="推送打印" FontSize="12" Padding="12,0" HeightRequest="32" CornerRadius="8"
                                BackgroundColor="{StaticResource Info}" TextColor="White"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ElderlyApplicationListViewModel}}, Path=PushPrintStopCommand}"
                                CommandParameter="{Binding .}"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="0">

        <!-- 紫色英雄头部 -->
        <Border Grid.Row="0" Background="{StaticResource StatCardPurpleGradient}" Padding="16,16,16,14">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <HorizontalStackLayout Grid.Column="0" Spacing="6">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                        </HorizontalStackLayout.GestureRecognizers>
                        <Label Text="‹" FontSize="22" TextColor="#E6FFFFFF" VerticalOptions="Center" FontAttributes="Bold"/>
                        <Label Text="返回" FontSize="14" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Button Grid.Column="2" Text="+ 新增登记" FontSize="13" FontAttributes="Bold"
                            BackgroundColor="White" TextColor="{StaticResource Primary}"
                            Padding="14,0" HeightRequest="38" CornerRadius="19"
                            Command="{Binding CreateNewCommand}"/>
                </Grid>
                <Label Text="高龄津贴申请登记" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                    <components:StatCapsule Grid.Column="0" Value="{Binding ActiveCountText}" Caption="在享（人）"/>
                    <components:StatCapsule Grid.Column="1" Value="{Binding MonthlyNewText}" Caption="本月新增（人）"/>
                    <components:StatCapsule Grid.Column="2" Value="{Binding DraftCount}" Caption="草稿（件）"/>
                    <components:StatCapsule Grid.Column="3" Value="{Binding StoppedCount}" Caption="已停发（人）"/>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- Tab 胶囊 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8" Padding="12,10" BackgroundColor="White">
            <Border Grid.Column="0" StrokeShape="RoundRectangle 16" Padding="10,8"
                    BackgroundColor="{Binding IsTab0Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#1a73e8|#EEF2F7'}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="0"/></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="草稿" FontSize="13" VerticalOptions="Center"
                           TextColor="{Binding IsTab0Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#475569'}"/>
                    <Label Text="{Binding DraftCount}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                           TextColor="{Binding IsTab0Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#1a73e8'}"/>
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="1" StrokeShape="RoundRectangle 16" Padding="10,8"
                    BackgroundColor="{Binding IsTab1Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#1a73e8|#EEF2F7'}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="1"/></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="已确认" FontSize="13" VerticalOptions="Center"
                           TextColor="{Binding IsTab1Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#475569'}"/>
                    <Label Text="{Binding ConfirmedCount}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                           TextColor="{Binding IsTab1Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#1a73e8'}"/>
                </HorizontalStackLayout>
            </Border>
            <Border Grid.Column="2" StrokeShape="RoundRectangle 16" Padding="10,8"
                    BackgroundColor="{Binding IsTab2Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#1a73e8|#EEF2F7'}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding SwitchTabCommand}" CommandParameter="2"/></Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="已停发" FontSize="13" VerticalOptions="Center"
                           TextColor="{Binding IsTab2Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#475569'}"/>
                    <Label Text="{Binding StoppedCount}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                           TextColor="{Binding IsTab2Selected, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FFFFFF|#1a73e8'}"/>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- 搜索栏 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="12,6" BackgroundColor="White">
            <Entry Grid.Column="0" Placeholder="搜索姓名、身份证号..." Text="{Binding SearchText}"
                   HeightRequest="40" FontSize="14" ReturnCommand="{Binding SearchCommand}"/>
            <Button Grid.Column="1" Text="搜索" FontSize="13" Padding="14,0" HeightRequest="40"
                    BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="8"
                    Command="{Binding SearchCommand}"/>
        </Grid>

        <!-- 列表区 -->
        <Grid Grid.Row="3">
            <CollectionView ItemsSource="{Binding DraftApps}" ItemTemplate="{StaticResource ElderlyCardTemplate}"
                            IsVisible="{Binding IsTab0Selected}" Margin="12,8" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="暂无草稿记录" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Margin="0,32"/>
                </CollectionView.EmptyView>
            </CollectionView>
            <CollectionView ItemsSource="{Binding ConfirmedApps}" ItemTemplate="{StaticResource ElderlyCardTemplate}"
                            IsVisible="{Binding IsTab1Selected}" Margin="12,8" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="暂无已确认（在享）记录" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Margin="0,32"/>
                </CollectionView.EmptyView>
            </CollectionView>
            <CollectionView ItemsSource="{Binding StoppedApps}" ItemTemplate="{StaticResource ElderlyCardTemplate}"
                            IsVisible="{Binding IsTab2Selected}" Margin="12,8" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="暂无已停发记录" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Margin="0,32"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>

        <!-- 分页 -->
        <Border Grid.Row="4" BackgroundColor="White" StrokeThickness="0" Padding="12,8,12,14">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                <Button Text="上一页" FontSize="13" Padding="14,0" HeightRequest="38" CornerRadius="8"
                        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                        BorderColor="{StaticResource Gray200}" BorderWidth="1"
                        Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}"/>
                <Label Text="{Binding PageStatusText}" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                <Button Text="下一页" FontSize="13" Padding="14,0" HeightRequest="38" CornerRadius="8"
                        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                        BorderColor="{StaticResource Gray200}" BorderWidth="1"
                        Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"/>
            </HorizontalStackLayout>
        </Border>

        <!-- 加载蒙版 -->
        <Border Grid.Row="0" Grid.RowSpan="5" BackgroundColor="#80000000"
                IsVisible="{Binding IsBusy}" InputTransparent="True">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="White" IsVisible="{Binding IsBusy}"/>
                <Label Text="{Binding LoadingMessage}" TextColor="White" FontSize="14" HorizontalOptions="Center"
                       IsVisible="{Binding LoadingMessage, Converter={StaticResource StringNotEmptyConverter}}"/>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
