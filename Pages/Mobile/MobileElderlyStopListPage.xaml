<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ent="clr-namespace:NewCosmos.Models.Entities"
             x:Class="NewCosmos.Pages.Mobile.MobileElderlyStopListPage"
             x:DataType="ElderlyStopListViewModel"
             Title="停发办理"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <!-- 在享人员 / 当前库搜索卡片 -->
        <DataTemplate x:Key="ActiveStopCard" x:DataType="ent:ElderlyApplication">
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" StrokeThickness="0" Padding="14" Margin="0,5">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding Name}" FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="停发" FontSize="12" Padding="12,0" HeightRequest="32" CornerRadius="8"
                                BackgroundColor="{StaticResource Warning}" TextColor="White"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ElderlyStopListViewModel}}, Path=StopCommand}"
                                CommandParameter="{Binding .}"/>
                    </Grid>
                    <Label Text="{Binding ApplicationNo, StringFormat='编号: {0}'}" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                    <Label Text="{Binding IdCard}" FontSize="13" TextColor="{StaticResource TextTertiary}"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="享受类别" FontSize="11" TextColor="{StaticResource TextTertiary}"/>
                            <Label Text="{Binding CategoryName}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="计发年月" FontSize="11" TextColor="{StaticResource TextTertiary}"/>
                            <Label Text="{Binding IssueStartMonth}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <!-- 导入库搜索卡片 -->
        <DataTemplate x:Key="ImportedStopCard" x:DataType="ent:ElderlyImportedSearchItem">
            <Border StrokeShape="RoundRectangle 12" BackgroundColor="White" StrokeThickness="0" Padding="14" Margin="0,5">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{Binding Name}" FontSize="16" FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="建档并停发" FontSize="12" Padding="10,0" HeightRequest="32" CornerRadius="8"
                                BackgroundColor="{StaticResource Warning}" TextColor="White"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type ElderlyStopListViewModel}}, Path=StopFromImportedCommand}"
                                CommandParameter="{Binding .}"/>
                    </Grid>
                    <Label Text="{Binding IdCard}" FontSize="13" TextColor="{StaticResource TextTertiary}"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="来源" FontSize="11" TextColor="{StaticResource TextTertiary}"/>
                            <Label Text="{Binding SourceDisplay}" FontSize="12" TextColor="{StaticResource Info}"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="年龄" FontSize="11" TextColor="{StaticResource TextTertiary}"/>
                            <Label Text="{Binding Age, StringFormat='{0} 岁'}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">

        <!-- 紫色英雄头部 -->
        <Border Grid.Row="0" Background="{StaticResource StatCardPurpleGradient}" Padding="16,16,16,14">
            <VerticalStackLayout Spacing="10">
                <HorizontalStackLayout Spacing="6">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="‹" FontSize="22" TextColor="#E6FFFFFF" VerticalOptions="Center" FontAttributes="Bold"/>
                    <Label Text="返回" FontSize="14" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <Label Text="停发办理" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                <Label Text="在享人员停发登记 / 导入库搜索" FontSize="13" TextColor="#E6FFFFFF"/>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <components:StatCapsule Grid.Column="0" Value="{Binding ActiveCountText}" Caption="在享（人）"/>
                    <components:StatCapsule Grid.Column="1" Value="{Binding MonthlyStoppedText}" Caption="本月停发（人次）"/>
                    <components:StatCapsule Grid.Column="2" Value="{Binding YearStoppedText}" Caption="年累计（人次）"/>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- 搜索栏 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="12,8" BackgroundColor="White">
            <Entry Grid.Column="0" Placeholder="搜索姓名、身份证号（当前库+导入库）" Text="{Binding SearchText}"
                   HeightRequest="40" FontSize="14" ReturnCommand="{Binding SearchImportedCommand}"/>
            <Button Grid.Column="1" Text="搜索" FontSize="13" Padding="14,0" HeightRequest="40"
                    BackgroundColor="{StaticResource Primary}" TextColor="White" CornerRadius="8"
                    Command="{Binding SearchImportedCommand}"/>
        </Grid>

        <!-- 列表区 -->
        <Grid Grid.Row="2">
            <!-- 默认在享列表 -->
            <CollectionView ItemsSource="{Binding Applications}" ItemTemplate="{StaticResource ActiveStopCard}"
                            IsVisible="{Binding HasDefaultList}" Margin="12,8" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="暂无在享人员，无需停发" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Margin="0,32"/>
                </CollectionView.EmptyView>
            </CollectionView>

            <!-- 搜索结果 -->
            <ScrollView IsVisible="{Binding HasSearchResults}" Margin="0">
                <VerticalStackLayout Padding="12,8" Spacing="4">
                    <Label Text="当前库" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" Margin="4,4,0,0"/>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CurrentSearchResults}"
                                         BindableLayout.ItemTemplate="{StaticResource ActiveStopCard}" Spacing="0"/>

                    <Label Text="历史导入库" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" Margin="4,10,0,0"/>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ImportedSearchResults}"
                                         BindableLayout.ItemTemplate="{StaticResource ImportedStopCard}" Spacing="0"/>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- 分页（仅默认列表） -->
        <Border Grid.Row="3" BackgroundColor="White" StrokeThickness="0" Padding="12,8,12,14"
                IsVisible="{Binding HasDefaultList}">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                <Button Text="上一页" FontSize="13" Padding="14,0" HeightRequest="38" CornerRadius="8"
                        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                        BorderColor="{StaticResource Gray200}" BorderWidth="1"
                        Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}"/>
                <Label Text="{Binding PageStatusText}" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                <Button Text="下一页" FontSize="13" Padding="14,0" HeightRequest="38" CornerRadius="8"
                        BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}"
                        BorderColor="{StaticResource Gray200}" BorderWidth="1"
                        Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"/>
            </HorizontalStackLayout>
        </Border>

        <!-- 错误提示 -->
        <Border Grid.Row="0" Grid.RowSpan="4" Padding="24" StrokeThickness="0" BackgroundColor="Transparent"
                IsVisible="{Binding HasError}" VerticalOptions="End" InputTransparent="False">
            <Border BackgroundColor="{StaticResource Error}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="14,10">
                <Label Text="{Binding ErrorMessage}" FontSize="13" TextColor="White" LineBreakMode="WordWrap"/>
            </Border>
        </Border>

        <!-- 加载蒙版 -->
        <Border Grid.Row="0" Grid.RowSpan="4" BackgroundColor="#80000000"
                IsVisible="{Binding IsBusy}" InputTransparent="True">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="True" Color="White" IsVisible="{Binding IsBusy}"/>
                <Label Text="{Binding LoadingMessage}" TextColor="White" FontSize="14" HorizontalOptions="Center"
                       IsVisible="{Binding LoadingMessage, Converter={StaticResource StringNotEmptyConverter}}"/>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
