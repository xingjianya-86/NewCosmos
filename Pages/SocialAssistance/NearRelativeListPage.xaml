<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ent="clr-namespace:NewCosmos.Models.Entities"
             x:Class="NewCosmos.Pages.SocialAssistance.NearRelativeListPage"
             x:DataType="NearRelativeListViewModel"
             Title="近亲属备案"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="0">

        <!-- 渐变英雄头部（蓝色） -->
        <Border Grid.Row="0" Style="{StaticResource ModuleHeroHeader}" Background="{StaticResource StatCardBlueGradient}">
            <VerticalStackLayout Spacing="16">

                <!-- 返回行 + 新增备案 -->
                <Grid ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Spacing="6">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                        </HorizontalStackLayout.GestureRecognizers>
                        <Label Text="{OnPlatform WinUI='&#xE72B;', Android='&#x2190;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="14" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                        <Label Text="返回工作台" FontSize="13" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Button Grid.Column="1"
                            Text="新增备案"
                            Command="{Binding NewEntryCommand}"
                            BackgroundColor="#33FFFFFF"
                            TextColor="White"
                            FontSize="14"
                            Padding="16,10"
                            CornerRadius="20"
                            VerticalOptions="Center"/>
                </Grid>

                <!-- 标题与副标题 -->
                <HorizontalStackLayout Spacing="14">
                    <Border WidthRequest="52" HeightRequest="52" BackgroundColor="#33FFFFFF" StrokeShape="RoundRectangle 14">
                        <Label Text="{OnPlatform WinUI='&#xE787;', Android='&#x1F4CB;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="28" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="近亲属备案" Style="{StaticResource ModuleHeroTitle}"/>
                        <Label Text="工作人员近亲属享受社会救助的备案名册，防优亲厚友" Style="{StaticResource ModuleHeroSubtitle}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>

        <!-- 顶部搜索栏 + 计数 -->
        <Border Grid.Row="1"
                BackgroundColor="{StaticResource White}"
                StrokeThickness="0"
                Padding="24,16">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}" Offset="0,2" Radius="4" Opacity="0.06"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Border BackgroundColor="{StaticResource Gray100}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        Padding="16,8"
                        HorizontalOptions="Fill">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Label Text="{OnPlatform WinUI='&#xE721;', Android='&#x1F50D;'}"
                               FontFamily="{OnPlatform WinUI='Segoe MDL2 Assets', Android=''}"
                               FontSize="14"
                               TextColor="{StaticResource Gray500}"
                               VerticalOptions="Center"
                               Margin="0,0,8,0"/>
                        <Entry Grid.Column="1"
                               Placeholder="搜索工作人员姓名、工作单位"
                               Text="{Binding SearchText}"
                               FontSize="16"
                               BackgroundColor="Transparent"
                               ReturnCommand="{Binding SearchCommand}"/>
                        <Button Grid.Column="2"
                                Text="搜索"
                                Style="{StaticResource ButtonSmall}"
                                BackgroundColor="{StaticResource Primary}"
                                Command="{Binding SearchCommand}"
                                VerticalOptions="Center"
                                Margin="8,0,0,0"/>
                    </Grid>
                </Border>

                <Label Grid.Column="1"
                       Text="{Binding StatusText}"
                       FontSize="13"
                       TextColor="{StaticResource TextSecondary}"
                       VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- 错误提示条 -->
        <Border Grid.Row="2"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                BackgroundColor="{StaticResource DangerSoft}"
                StrokeThickness="0"
                Padding="24,10">
            <Label Text="{Binding ErrorMessage}"
                   FontSize="13"
                   TextColor="{StaticResource Error}"/>
        </Border>

        <!-- 备案名册表格 -->
        <Border Grid.Row="3"
                Style="{StaticResource CardBorder}"
                Padding="0"
                Margin="24,16"
                MinimumWidthRequest="720">

            <Grid RowDefinitions="Auto, *">

                <!-- 表头 -->
                <Grid Grid.Row="0"
                      Style="{StaticResource TableHeader}"
                      Padding="16"
                      ColumnDefinitions="1.2*, 1.6*, 0.8*, Auto">
                    <Label Text="工作人员姓名" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="1" Text="工作单位" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="2" Text="关联对象" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="3" Text="操作" Style="{StaticResource TableHeaderLabel}" HorizontalOptions="Center"/>
                </Grid>

                <BoxView Grid.Row="0" Grid.ColumnSpan="4" HeightRequest="1"
                         BackgroundColor="{StaticResource Gray300}" VerticalOptions="End"/>

                <!-- 数据列表 -->
                <CollectionView Grid.Row="1"
                               ItemsSource="{Binding Items}"
                               SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                               SelectionMode="Single">
                    <CollectionView.EmptyView>
                        <Label Text="暂无近亲属备案记录" Style="{StaticResource EmptyStateLabel}"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="ent:NearRelativeBrief">
                            <Grid Padding="16"
                                  Style="{StaticResource TableRowInteractive}"
                                  ColumnDefinitions="1.2*, 1.6*, 0.8*, Auto">

                                <Label Text="{Binding StaffName}" FontSize="15" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding WorkUnit}" FontSize="15" VerticalOptions="Center"/>
                                <Label Grid.Column="2"
                                       Text="{Binding LinkCount, StringFormat='{0} 名'}"
                                       FontSize="15" VerticalOptions="Center"/>

                                <HorizontalStackLayout Grid.Column="3" Spacing="8" VerticalOptions="Center">
                                    <Button Text="编辑"
                                            Style="{StaticResource ButtonSmall}"
                                            BackgroundColor="{StaticResource Primary}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type NearRelativeListViewModel}}, Path=EditCommand}"
                                            CommandParameter="{Binding .}"/>
                                    <Button Text="删除"
                                            Style="{StaticResource ButtonSmall}"
                                            BackgroundColor="{StaticResource Error}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type NearRelativeListViewModel}}, Path=DeleteCommand}"
                                            CommandParameter="{Binding .}"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- 加载指示器 -->
        <components:LoadingOverlay Grid.Row="0" Grid.RowSpan="4"
                                   IsLoading="{Binding IsBusy}"
                                   LoadingText="正在加载数据..."/>
    </Grid>
</ContentPage>
