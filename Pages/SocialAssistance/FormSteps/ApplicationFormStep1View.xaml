<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Pages.SocialAssistance.FormSteps.ApplicationFormStep1View"
             x:Name="StepRoot"
             x:DataType="ApplicationFormViewModel">

    <!-- Step1: 基本信息 — 从 ApplicationFormPage.xaml 提取；可见性由宿主页面按 CurrentStep 懒加载控制 -->
    <VerticalStackLayout Spacing="16" IsEnabled="{Binding IsStep1Editable}">

        <!-- ──────────────────────────────────────────────────────── -->
        <!-- 卡片1：户籍所在地（从当前登录用户组织机构获取，固定值） -->
        <!-- ──────────────────────────────────────────────────────── -->
        <Border Style="{StaticResource CardBorder}">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20"
                            BackgroundColor="{StaticResource SuccessSoft}" StrokeThickness="0" Padding="0">
                        <Label Text="{OnPlatform WinUI='&#xE7BA;', Android='&#x26A0;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18"
                               TextColor="{StaticResource Success}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Grid.Column="1" Text="户籍所在地" Style="{StaticResource SectionTitleLabel}" Margin="0" VerticalOptions="Center"/>
                    <Label Grid.Column="2" Text="(从用户组织机构获取)" Style="{StaticResource LabelSmall}" VerticalOptions="Center" HorizontalOptions="End"/>
                </Grid>
                <BoxView Style="{StaticResource Divider}" Margin="0"/>
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="省份" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding HukouProvince}" IsReadOnly="True"
                               BackgroundColor="{StaticResource Gray100}"
                               Style="{StaticResource FormFieldEntryStyle}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="城市" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding HukouCity}" IsReadOnly="True"
                               BackgroundColor="{StaticResource Gray100}"
                               Style="{StaticResource FormFieldEntryStyle}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="8">
                        <Label Text="区县" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding HukouDistrict}" IsReadOnly="True"
                               BackgroundColor="{StaticResource Gray100}"
                               Style="{StaticResource FormFieldEntryStyle}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="8">
                        <Label Text="乡镇" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding HukouTown}" IsReadOnly="True"
                               BackgroundColor="{StaticResource Gray100}"
                               Style="{StaticResource FormFieldEntryStyle}"/>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- ──────────────────────────────────────────────────────── -->
        <!-- 卡片2：申请人所在地址 -->
        <!-- ──────────────────────────────────────────────────────── -->
        <Border Style="{StaticResource CardBorder}">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20"
                            BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0" Padding="0">
                        <Label Text="{OnPlatform WinUI='&#xE707;', Android='&#x1F4CD;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Grid.Column="1" Text="申请人所在地址" Style="{StaticResource SectionTitleLabel}" Margin="0" VerticalOptions="Center"/>
                </Grid>
                <BoxView Style="{StaticResource Divider}" Margin="0"/>
                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12" RowDefinitions="Auto" RowSpacing="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="省份" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Picker ItemsSource="{Binding ProvinceOptions}"
                                SelectedItem="{Binding SelectedProvince}"
                                Style="{StaticResource FormFieldPickerStyle}"
                                IsEnabled="False"
                                BackgroundColor="{StaticResource Gray100}"
                                Title=""/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="城市" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Picker ItemsSource="{Binding CityOptions}"
                                SelectedItem="{Binding SelectedCity}"
                                Style="{StaticResource FormFieldPickerStyle}"
                                Title=""/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="8">
                        <Label Text="区县" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Picker ItemsSource="{Binding DistrictOptions}"
                                SelectedItem="{Binding SelectedDistrict}"
                                Style="{StaticResource FormFieldPickerStyle}"
                                Title=""/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="8">
                        <Label Text="乡镇社区" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Picker ItemsSource="{Binding TownOptions}"
                                SelectedItem="{Binding SelectedTown}"
                                Style="{StaticResource FormFieldPickerStyle}"
                                Title=""/>
                    </VerticalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="1*,3*" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="村社区" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Picker ItemsSource="{Binding VillageOptions}"
                                SelectedItem="{Binding SelectedVillage}"
                                Style="{StaticResource FormFieldPickerStyle}"
                                Title=""/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="详细地址" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding Address}" Placeholder="请输入详细地址（如：XX路XX号）"
                               Style="{StaticResource FormFieldEntryStyle}"/>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- ──────────────────────────────────────────────────────── -->
        <!-- 卡片3：申请人信息 -->
        <!-- ──────────────────────────────────────────────────────── -->
        <Border Style="{StaticResource CardBorder}">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20"
                            BackgroundColor="{StaticResource WarningSoft}" StrokeThickness="0" Padding="0">
                        <Label Text="{OnPlatform WinUI='&#xE77B;', Android='&#x1F464;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18"
                               TextColor="{StaticResource StatCardOrangeStart}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Grid.Column="1" Text="申请人信息" Style="{StaticResource SectionTitleLabel}" Margin="0" VerticalOptions="Center"/>
                </Grid>
                <BoxView Style="{StaticResource Divider}" Margin="0"/>

                <!-- 第1行：姓名、身份证号（含搜索按钮）、残疾证号、性别、年龄 -->
                <Grid ColumnDefinitions="2*,3*,2*,1*,2*" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="姓名" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding ApplicantName}"
                               Placeholder="{Binding ApplicantNameField.Placeholder}"
                               IsReadOnly="{Binding IsApplicantIdentityLocked}"
                               Style="{StaticResource FormFieldEntryStyle}"/>
                    </VerticalStackLayout>
                     <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="身份证号" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding ApplicantIdCard}"
                               Placeholder="{Binding ApplicantIdCardField.Placeholder}"
                               IsReadOnly="{Binding IsApplicantIdentityLocked}"
                               Style="{StaticResource FormFieldEntryStyle}"
                               MaxLength="18"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="8">
                        <Label Text="残疾证号（后两位）" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding DisabilityCardNo}"
                               Placeholder="后两位用于计算"
                               MaxLength="2"
                               Style="{StaticResource FormFieldEntryStyle}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="8">
                        <Label Text="性别" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding DetectedGender}" IsReadOnly="True"
                               BackgroundColor="{StaticResource Gray100}"
                               Style="{StaticResource FormFieldEntryStyle}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="4" Spacing="8">
                        <Label Text="年龄" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding DetectedAgeDisplay}" IsReadOnly="True"
                               BackgroundColor="{StaticResource Gray100}"
                               Style="{StaticResource FormFieldEntryStyle}"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- 第2行：联系方式、民族、婚姻状况、户口性质、文化程度、政治面貌 -->
                <Grid ColumnDefinitions="2*,1*,1*,1*,1*,1*" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="联系方式" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding ApplicantPhone}"
                               Placeholder="{Binding PhoneField.Placeholder}"
                               Style="{StaticResource FormFieldEntryStyle}"
                               Keyboard="Telephone" MaxLength="11"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="民族" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Picker ItemsSource="{Binding EthnicityOptions}"
                                SelectedItem="{Binding SelectedEthnicity}"
                                ItemDisplayBinding="{Binding Display}"
                                Style="{StaticResource FormFieldPickerStyle}"
                                Title=""/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="8">
                        <Label Text="婚姻状况" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Picker ItemsSource="{Binding MaritalStatusOptions}"
                                SelectedItem="{Binding SelectedMaritalStatus}"
                                ItemDisplayBinding="{Binding Display}"
                                Style="{StaticResource FormFieldPickerStyle}"
                                Title=""/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="8">
                        <Label Text="户口性质" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Picker ItemsSource="{Binding HukouTypeOptions}"
                                SelectedItem="{Binding HukouType}"
                                ItemDisplayBinding="{Binding Display}"
                                Style="{StaticResource FormFieldPickerStyle}"
                                Title=""/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="4" Spacing="8">
                        <Label Text="文化程度" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Picker ItemsSource="{Binding EducationLevelOptions}"
                                SelectedItem="{Binding SelectedEducationLevel}"
                                ItemDisplayBinding="{Binding Display}"
                                Style="{StaticResource FormFieldPickerStyle}"
                                Title=""/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="5" Spacing="8">
                        <Label Text="政治面貌" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Picker ItemsSource="{Binding PoliticalStatusOptions}"
                                SelectedItem="{Binding SelectedPoliticalStatus}"
                                ItemDisplayBinding="{Binding Display}"
                                Style="{StaticResource FormFieldPickerStyle}"
                                Title=""/>
                    </VerticalStackLayout>
                </Grid>

                <!-- 第3行：开户行、银行卡号 -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="开户行" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding BankName}"
                               Placeholder="银行卡开户行（导入建档自动带出，可修改）"
                               Style="{StaticResource FormFieldEntryStyle}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="银行卡号" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding BankAccount}"
                               Placeholder="银行卡号（导入建档自动带出，可修改）"
                               Style="{StaticResource FormFieldEntryStyle}"
                               Keyboard="Numeric"/>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- ──────────────────────────────────────────────────────── -->
        <!-- 卡片4：健康与残疾信息 -->
        <!-- ──────────────────────────────────────────────────────── -->
        <Border Style="{StaticResource CardBorder}">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20"
                            BackgroundColor="{StaticResource DangerSoft}" StrokeThickness="0" Padding="0">
                        <Label Text="{OnPlatform WinUI='&#xE90D;', Android='&#x1F3E5;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18"
                               TextColor="{StaticResource Error}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Grid.Column="1" Text="健康与残疾信息" Style="{StaticResource SectionTitleLabel}" Margin="0" VerticalOptions="Center"/>
                </Grid>
                <BoxView Style="{StaticResource Divider}" Margin="0"/>

                <!-- 第1行：身体状况、残疾类型、残疾等级 -->
                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="身体状况" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding SelectedHealthStatusObj.Display}" IsReadOnly="True"
                               BackgroundColor="{StaticResource Gray100}"
                               Style="{StaticResource FormFieldEntryStyle}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="残疾类型" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding SelectedDisabilityTypeObj.Display}" IsReadOnly="True"
                               BackgroundColor="{StaticResource Gray100}"
                               Style="{StaticResource FormFieldEntryStyle}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="8">
                        <Label Text="残疾等级" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding SelectedDisabilityLevelObj.Display}" IsReadOnly="True"
                               BackgroundColor="{StaticResource Gray100}"
                               Style="{StaticResource FormFieldEntryStyle}"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- 第3行：疾病信息（是否重病 + 编码回填 + 一级分类 + 二级名称） -->
                <Grid ColumnDefinitions="Auto,*,*,*" ColumnSpacing="12" Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="是否重病" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <CheckBox IsChecked="{Binding IsSevereDisease}" HorizontalOptions="Start" VerticalOptions="Center"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="8">
                        <Label Text="疾病编码（ICD-10）" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding DiseaseCode}" TextChanged="OnApplicantDiseaseCodeChanged"
                               Placeholder="如 A00.900，输入后自动带出疾病"
                               Style="{StaticResource FormFieldEntryStyle}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="8">
                        <Label Text="一级疾病" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Picker ItemsSource="{Binding DiseaseCategoryOptions}"
                                SelectedItem="{Binding SelectedDiseaseCategoryObj}"
                                ItemDisplayBinding="{Binding Display}"
                                Style="{StaticResource FormFieldPickerStyle}"
                                Title=""/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="8">
                        <Label Text="二级疾病" Style="{StaticResource FormFieldLabelStyle}" FontSize="15"/>
                        <Entry Text="{Binding DiseaseNameText}"
                               Placeholder="输入疾病编码自动带出，可手工修改"
                               Style="{StaticResource FormFieldEntryStyle}"/>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>

</ContentView>
