<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ent="clr-namespace:NewCosmos.Models.Entities"
             x:Class="NewCosmos.Pages.SocialAssistance.FormSteps.ApplicationFormStep2View"
             x:Name="StepRoot"
             x:DataType="ApplicationFormViewModel">

    <!-- Step2: 家庭成员 — 从 ApplicationFormPage.xaml 提取；可见性由宿主页面按 CurrentStep 懒加载控制 -->
    <VerticalStackLayout Spacing="16" IsEnabled="{Binding IsStep2Editable}">

        <!-- 共同生活成员区域 -->
        <Border Style="{StaticResource CardBorder}">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}" Offset="0,2" Radius="6" Opacity="0.08"/>
            </Border.Shadow>
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="👨‍👩‍👧‍👦 共同生活成员" Style="{StaticResource SectionTitleLabel}" Margin="0" VerticalOptions="Center"/>
                    <Button Grid.Column="1" Text="新增人员" Style="{StaticResource ButtonPrimary}" HeightRequest="34" Padding="16,0"
                            Command="{Binding AddSharedLivingMemberCommand}"/>
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}"/>
                <CollectionView ItemsSource="{Binding SharedLivingMembers}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="暂无共同生活成员，点击右上角“新增人员”添加" Style="{StaticResource EmptyStateLabel}" Margin="0,16"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="ent:FamilyMember">
                            <!-- 共同生活成员卡：共享组件 + 户籍共享只读 + 免劳力勾选（2026-11 模板收敛） -->
                            <components:FamilyMemberCardView
                                Host="{Binding BindingContext, Source={x:Reference StepRoot}}"
                                HukouEditable="False"
                                SharedHukouCity="{Binding BindingContext.HukouCity, Source={x:Reference StepRoot}}"
                                SharedHukouDistrict="{Binding BindingContext.HukouDistrict, Source={x:Reference StepRoot}}"
                                SharedHukouTown="{Binding BindingContext.HukouTown, Source={x:Reference StepRoot}}"
                                ShowLaborExempt="True"
                                ShowFamilySize="False"
                                RemoveCommand="{Binding BindingContext.RemoveFamilyMemberCommand, Source={x:Reference StepRoot}}"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- 赡养抚养扶养区域 -->
        <Border Style="{StaticResource CardBorder}">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}" Offset="0,2" Radius="6" Opacity="0.08"/>
            </Border.Shadow>
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="👨‍👩‍👧‍👦 赡养抚养扶养" Style="{StaticResource SectionTitleLabel}" Margin="0" VerticalOptions="Center"/>
                    <Button Grid.Column="1" Text="新增人员" Style="{StaticResource ButtonPrimary}" HeightRequest="34" Padding="16,0"
                            Command="{Binding AddSupportMemberCommand}"/>
                </Grid>
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}"/>
                <CollectionView ItemsSource="{Binding SupportMembers}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="暂无赡养抚养扶养人员，点击右上角“新增人员”添加" Style="{StaticResource EmptyStateLabel}" Margin="0,16"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="ent:FamilyMember">
                            <!-- 赡养抚养扶养卡：共享组件 + 户籍独立可编辑 + 家庭人口（2026-11 模板收敛） -->
                            <components:FamilyMemberCardView
                                Host="{Binding BindingContext, Source={x:Reference StepRoot}}"
                                HukouEditable="True"
                                ShowLaborExempt="False"
                                ShowFamilySize="True"
                                RemoveCommand="{Binding BindingContext.RemoveFamilyMemberCommand, Source={x:Reference StepRoot}}"/>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>

</ContentView>
