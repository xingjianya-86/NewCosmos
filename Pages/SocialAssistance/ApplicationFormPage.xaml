<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                x:Class="NewCosmos.Pages.SocialAssistance.ApplicationFormPage"
                x:Name="MainPage"
                x:DataType="ApplicationFormViewModel"
              Title="低收入人口认定申请"
              NavigationPage.HasNavigationBar="False"
              BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:BoolToInverseConverter x:Key="BoolToInverseConverter"/>
            <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
            <converters:IntToBoolConverter x:Key="IntToBoolConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 顶部标题栏 - 蓝色渐变背景 -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Padding="20" BackgroundColor="{StaticResource Primary}" StrokeThickness="0">
            <Border.Shadow>
                <Shadow Brush="{StaticResource PrimaryDark}" Offset="0,4" Radius="8" Opacity="0.3"/>
            </Border.Shadow>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0"/>
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <!-- 放弃申请：第一步原本无任何退出途径，此处为全程可用的带确认退出入口 -->
                <components:BackButton Grid.Column="0" Command="{Binding AbandonCommand}" IconColor="White" VerticalOptions="Center"/>
                <HorizontalStackLayout Grid.Column="1" Spacing="16" VerticalOptions="Center">
                    <Label Text="{OnPlatform WinUI='&#xE8A5;', Android='&#x1F9FE;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="32" TextColor="{StaticResource White}"/>
                    <VerticalStackLayout Spacing="2">
                        <Label Text="低收入人口认定申请" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource White}"/>
                        <Label Text="家庭申请 · 信息录入 · 分类认定" FontSize="16" TextColor="{StaticResource PrimarySoft}" Opacity="0.9"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <!-- 模式提醒徽章（仅补全/复核等特殊模式显示） -->
                <Border Grid.Column="1" BackgroundColor="{StaticResource White}" Opacity="0.95"
                        StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="12,6"
                        VerticalOptions="Center" IsVisible="{Binding IsModeBannerVisible}" MaximumWidthRequest="360">
                    <Label Text="{Binding ModeBannerText}" FontSize="12" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" VerticalOptions="Center"
                           LineBreakMode="WordWrap"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 卡片式步骤指示器 -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" BackgroundColor="{StaticResource White}" Padding="20,12" StrokeThickness="0" Margin="0,1,0,0">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}" Offset="0,1" Radius="3" Opacity="0.03"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,Auto,*,Auto,*,Auto,*,Auto,*" ColumnSpacing="0">
                
                <!-- Step 1: 基本信息 -->
                <Border Padding="16,10" StrokeShape="RoundRectangle 8"
                        BackgroundColor="{Binding Step1CardBgColor}"
                        Stroke="{Binding Step1CardBorderColor}"
                        StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToStepCommand}" CommandParameter="1"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="1" FontSize="16" FontAttributes="Bold" 
                               TextColor="{Binding Step1TextColor}" HorizontalOptions="Center"/>
                        <Label Text="基本信息" FontSize="16" 
                               TextColor="{Binding Step1TextColor}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- 连接线 1-2 -->
                <BoxView Grid.Column="1" WidthRequest="24" HeightRequest="2" 
                         BackgroundColor="{Binding Line1Color}" VerticalOptions="Center" Margin="4,0"/>

                <!-- Step 2: 家庭成员 -->
                <Border Grid.Column="2" Padding="16,10" StrokeShape="RoundRectangle 8"
                        BackgroundColor="{Binding Step2CardBgColor}"
                        Stroke="{Binding Step2CardBorderColor}"
                        StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToStepCommand}" CommandParameter="2"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="2" FontSize="16" FontAttributes="Bold" 
                               TextColor="{Binding Step2TextColor}" HorizontalOptions="Center"/>
                        <Label Text="家庭成员" FontSize="16" 
                               TextColor="{Binding Step2TextColor}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- 连接线 2-3 -->
                <BoxView Grid.Column="3" WidthRequest="24" HeightRequest="2" 
                         BackgroundColor="{Binding Line2Color}" VerticalOptions="Center" Margin="4,0"/>

                <!-- Step 3: 经济状况 -->
                <Border Grid.Column="4" Padding="16,10" StrokeShape="RoundRectangle 8"
                        BackgroundColor="{Binding Step3CardBgColor}"
                        Stroke="{Binding Step3CardBorderColor}"
                        StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToStepCommand}" CommandParameter="3"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="3" FontSize="16" FontAttributes="Bold" 
                               TextColor="{Binding Step3TextColor}" HorizontalOptions="Center"/>
                        <Label Text="经济状况" FontSize="16" 
                               TextColor="{Binding Step3TextColor}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- 连接线 3-4 -->
                <BoxView Grid.Column="5" WidthRequest="24" HeightRequest="2" 
                         BackgroundColor="{Binding Line3Color}" VerticalOptions="Center" Margin="4,0"/>

                <!-- Step 4: 入户调查 -->
                <Border Grid.Column="6" Padding="16,10" StrokeShape="RoundRectangle 8"
                        BackgroundColor="{Binding Step4CardBgColor}"
                        Stroke="{Binding Step4CardBorderColor}"
                        StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToStepCommand}" CommandParameter="4"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="4" FontSize="16" FontAttributes="Bold" 
                               TextColor="{Binding Step4TextColor}" HorizontalOptions="Center"/>
                        <Label Text="入户调查" FontSize="16" 
                               TextColor="{Binding Step4TextColor}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- 连接线 4-5 -->
                <BoxView Grid.Column="7" WidthRequest="24" HeightRequest="2" 
                         BackgroundColor="{Binding Line4Color}" VerticalOptions="Center" Margin="4,0"/>

                <!-- Step 5: 分类认定 -->
                <Border Grid.Column="8" Padding="16,10" StrokeShape="RoundRectangle 8"
                        BackgroundColor="{Binding Step5CardBgColor}"
                        Stroke="{Binding Step5CardBorderColor}"
                        StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToStepCommand}" CommandParameter="5"/>
                    </Border.GestureRecognizers>
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="5" FontSize="16" FontAttributes="Bold" 
                               TextColor="{Binding Step5TextColor}" HorizontalOptions="Center"/>
                        <Label Text="分类认定" FontSize="16" 
                               TextColor="{Binding Step5TextColor}" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 内容区域：左侧表单 + 右侧字段选择 -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" ColumnDefinitions="*,320" ColumnSpacing="0">

            <!-- 左侧：表单内容 -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">

            <!-- Fix: 收入汇总面板（仅 Step3 显示，固定不滚动） -->
            <Border Grid.Row="0" IsVisible="{Binding IsStep3Visible}"
                    Style="{StaticResource CardBorder}" Margin="16,8,16,0">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource Black}" Offset="0,2" Radius="6" Opacity="0.08"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="4">
                    <Label Text="&#x1F4CA; 收入汇总" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}"/>
                    <!-- 第一行：收入项横向排列 -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="14">
                            <Label FontSize="16" TextColor="{StaticResource TextSecondary}">
                                <Label.FormattedText><FormattedString>
                                    <Span Text="务工(月) "/><Span Text="{Binding WorkIncomeTotal, StringFormat='{0:N2}'}" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                                </FormattedString></Label.FormattedText>
                            </Label><Label FontSize="16" TextColor="{StaticResource TextSecondary}" Text="|"/>
                            <Label FontSize="16" TextColor="{StaticResource TextSecondary}">
                                <Label.FormattedText><FormattedString>
                                    <Span Text="经营(月) "/><Span Text="{Binding BusinessIncomeTotal, StringFormat='{0:N2}'}" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                                </FormattedString></Label.FormattedText>
                            </Label><Label FontSize="16" TextColor="{StaticResource TextSecondary}" Text="|"/>
                            <Label FontSize="16" TextColor="{StaticResource TextSecondary}">
                                <Label.FormattedText><FormattedString>
                                    <Span Text="财产(月) "/><Span Text="{Binding PropertyIncomeTotal, StringFormat='{0:N2}'}" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                                </FormattedString></Label.FormattedText>
                            </Label><Label FontSize="16" TextColor="{StaticResource TextSecondary}" Text="|"/>
                            <Label FontSize="16" TextColor="{StaticResource TextSecondary}">
                                <Label.FormattedText><FormattedString>
                                    <Span Text="转移(月) "/><Span Text="{Binding TransferIncomeTotal, StringFormat='{0:N2}'}" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                                </FormattedString></Label.FormattedText>
                            </Label><Label FontSize="16" TextColor="{StaticResource TextSecondary}" Text="|"/>
                            <Label FontSize="16" TextColor="{StaticResource TextSecondary}">
                                <Label.FormattedText><FormattedString>
                                    <Span Text="其他(月) "/><Span Text="{Binding OtherIncomeTotal, StringFormat='{0:N2}'}" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                                </FormattedString></Label.FormattedText>
                            </Label><Label FontSize="16" TextColor="{StaticResource TextSecondary}" Text="|"/>
                            <Label FontSize="16" TextColor="{StaticResource TextSecondary}">
                                <Label.FormattedText><FormattedString>
                                    <Span Text="赡养(月) "/><Span Text="{Binding AlimonyIncome, StringFormat='{0:N2}'}" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                                </FormattedString></Label.FormattedText>
                            </Label><Label FontSize="16" TextColor="{StaticResource TextSecondary}" Text="|"/>
                            <Label FontSize="16" TextColor="{StaticResource TextSecondary}">
                                <Label.FormattedText><FormattedString>
                                    <Span Text="补贴(年) "/><Span Text="{Binding SubsidyTotal, StringFormat='{0:N2}'}" FontAttributes="Bold" TextColor="{StaticResource Primary}"/><Span Text="{Binding SubsidyRatioNote}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                                </FormattedString></Label.FormattedText>
                            </Label><Label FontSize="16" TextColor="{StaticResource TextSecondary}" Text="|"/>
                            <Label FontSize="16" TextColor="{StaticResource TextSecondary}">
                                <Label.FormattedText><FormattedString>
                                    <Span Text="土地(年) "/><Span Text="{Binding LandIncomeTotal, StringFormat='{0:N2}'}" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                                </FormattedString></Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>
                    </ScrollView>
                    <!-- 第二行：刚性支出明细 -->
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray100}"/>
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="14">
                            <Label FontSize="16" TextColor="{StaticResource Error}">
                                <Label.FormattedText><FormattedString>
                                    <Span Text="医疗(月) "/><Span Text="{Binding MedicalExpenditure, StringFormat='{0:N2}'}" FontAttributes="Bold"/>
                                </FormattedString></Label.FormattedText>
                            </Label><Label FontSize="16" TextColor="{StaticResource Error}" Text="|"/>
                            <Label FontSize="16" TextColor="{StaticResource Error}">
                                <Label.FormattedText><FormattedString>
                                    <Span Text="教育(月) "/><Span Text="{Binding EducationExpenditure, StringFormat='{0:N2}'}" FontAttributes="Bold"/>
                                </FormattedString></Label.FormattedText>
                            </Label><Label FontSize="16" TextColor="{StaticResource Error}" Text="|"/>
                            <Label FontSize="16" TextColor="{StaticResource Error}">
                                <Label.FormattedText><FormattedString>
                                    <Span Text="康复(月) "/><Span Text="{Binding DisabilityRehabExpenditure, StringFormat='{0:N2}'}" FontAttributes="Bold"/>
                                </FormattedString></Label.FormattedText>
                            </Label><Label FontSize="16" TextColor="{StaticResource Error}" Text="|"/>
                            <Label FontSize="16" TextColor="{StaticResource Error}">
                                <Label.FormattedText><FormattedString>
                                    <Span Text="生活(月) "/><Span Text="{Binding LivingExpenditure, StringFormat='{0:N2}'}" FontAttributes="Bold"/>
                                </FormattedString></Label.FormattedText>
                            </Label><Label FontSize="16" TextColor="{StaticResource Error}" Text="|"/>
                            <Label FontSize="16" TextColor="{StaticResource Error}">
                                <Label.FormattedText><FormattedString>
                                    <Span Text="合计(月) "/><Span Text="{Binding RigidExpenditure, StringFormat='{0:N2}'}" FontAttributes="Bold"/>
                                </FormattedString></Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>
                    </ScrollView>
                    <!-- 第三行：汇总结果 -->
                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}"/>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16">
                        <Label FontSize="16" TextColor="{StaticResource TextPrimary}">
                            <Label.FormattedText><FormattedString>
                                <Span Text="收入小计(年): " FontAttributes="Bold"/>
                                <Span Text="{Binding IncomeSubtotal, StringFormat='{0:N2} 元'}" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                            </FormattedString></Label.FormattedText>
                        </Label>
                        <Label Grid.Column="1" FontSize="16" TextColor="{StaticResource TextPrimary}">
                            <Label.FormattedText><FormattedString>
                                <Span Text="总收入(年): " FontAttributes="Bold"/>
                                <Span Text="{Binding TotalFamilyIncomeAnnual, StringFormat='{0:N2} 元'}" FontAttributes="Bold" TextColor="{StaticResource Primary}"/>
                            </FormattedString></Label.FormattedText>
                        </Label>
                        <Label Grid.Column="2" FontSize="16" TextColor="{StaticResource TextPrimary}">
                            <Label.FormattedText><FormattedString>
                                <Span Text="人口: "/><Span Text="{Binding FamilySize}"/><Span Text="人"/>
                            </FormattedString></Label.FormattedText>
                        </Label>
                        <Label Grid.Column="3" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource Primary}">
                            <Label.FormattedText><FormattedString>
                                <Span Text="人均年收入: "/><Span Text="{Binding PerCapitaIncomeAnnual, StringFormat='{0:N2} 元'}"/>
                            </FormattedString></Label.FormattedText>
                        </Label>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="16" Spacing="8">

                <!-- ═══════════════════════════════════════════════════════════ -->
                <!-- 步骤内容宿主：Step1~Step5 已拆分为 FormSteps 目录下的 ContentView -->
                <!-- 由代码隐藏按 CurrentStep 懒加载，任一时刻仅当前步骤的可视树存在 -->
                <!-- ═══════════════════════════════════════════════════════════ -->
                <Grid x:Name="StepHost" />

            </VerticalStackLayout>
        </ScrollView>

        </Grid>

            <!-- 右侧：字段选择边栏（仅在有资产核查数据时显示） -->
            <Border Grid.Column="1"
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 0"
                    IsVisible="{Binding HasAssetCheckData}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- 边栏标题 -->
                    <Grid Grid.Row="0" Padding="16,12" BackgroundColor="{StaticResource Gray50}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Label Text="{OnPlatform WinUI='&#xE8C8;', Android='&#x1F5C3;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="来源数据" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" Margin="8,0,0,0"/>
                    </Grid>

                    <BoxView Grid.Row="0" HeightRequest="1" BackgroundColor="{StaticResource Gray200}" VerticalOptions="End"/>

                    <!-- 字段列表 -->
                    <CollectionView Grid.Row="1" ItemsSource="{Binding AvailableFields}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="results:FieldItem">
                                <Grid Padding="12,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <!-- 勾选框 -->
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center"/>

                                    <!-- 字段名 + 值 -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding DisplayName}" FontSize="12" TextColor="{StaticResource TextSecondary}"/>
                                        <Label Text="{Binding Value}" FontSize="14" TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>

                                    <!-- 填充按钮 -->
                                    <Button Grid.Column="2" Text="填充"
                                            FontSize="12" Padding="8,4" HeightRequest="28"
                                            BackgroundColor="{StaticResource Primary}" TextColor="White"
                                            CornerRadius="4"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ApplicationFormViewModel}}, Path=FillFieldCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="20,40">
                                <Label Text="{OnPlatform WinUI='&#xE8C8;', Android='&#x1F5C3;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="36" TextColor="{StaticResource Gray400}" HorizontalOptions="Center"/>
                                <Label Text="暂无来源数据" Style="{StaticResource EmptyStateLabel}" FontSize="14" Margin="0,8,0,0"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <!-- 操作按钮 -->
                    <VerticalStackLayout Grid.Row="2" Padding="16" Spacing="8">
                        <Button Text="全选" Command="{Binding SelectAllFieldsCommand}" Style="{StaticResource ButtonOutline}" HeightRequest="36"/>
                        <Button Text="填充选中" Command="{Binding FillSelectedFieldsCommand}" Style="{StaticResource ButtonPrimary}" HeightRequest="36"/>
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource Gray200}"/>
                        <Label Text="家庭成员" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" Margin="0,4,0,0"/>
                        <Button Text="导入全部家庭成员" Command="{Binding ImportAllFamilyMembersCommand}" Style="{StaticResource ButtonPrimary}" HeightRequest="36"/>
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </Grid>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 搜索结果弹窗 -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Grid.RowSpan="2"
                IsVisible="{Binding IsSearchPopupVisible}"
                BackgroundColor="#80000000"
                ZIndex="100"
                StrokeThickness="0">
            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 12"
                    Padding="0"
                    MaximumWidthRequest="520"
                    MaximumHeightRequest="480"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="40">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource ShadowDark}" Offset="0,4" Radius="16" Opacity="0.3"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <!-- 标题栏 -->
                    <Grid Padding="20,16" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource Primary}">
                        <Label Text="搜索结果" FontSize="16"
                               TextColor="White" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="✕"
                                FontSize="18" FontAttributes="Bold"
                                TextColor="White" BackgroundColor="Transparent"
                                WidthRequest="32" HeightRequest="32" Padding="0"
                                CornerRadius="16"
                                Command="{Binding CancelSearchResultCommand}"/>
                    </Grid>

                    <!-- 搜索结果数量提示 -->
                    <Label Padding="20,12,20,4" FontSize="15" TextColor="{StaticResource TextSecondary}"
                           Text="{Binding SearchResults.Count, StringFormat='找到 {0} 条记录，请选择一条'}"/>

                    <!-- 结果列表 -->
                    <CollectionView ItemsSource="{Binding SearchResults}"
                                    SelectedItem="{Binding SelectedSearchResult}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnSearchResultSelectionChanged"
                                    MaximumHeightRequest="300"
                                    Margin="16,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="PersonSearchResult">
                                <Border Padding="14" Margin="0,4" StrokeShape="RoundRectangle 8"
                                        Stroke="{StaticResource Gray200}" StrokeThickness="1">
                                    <Border.Background>
                                        <Binding Path="IsSelected" Converter="{StaticResource BoolToColorConverter}"/>
                                    </Border.Background>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18"
                                                BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0" Padding="0">
                                            <Label Text="👤" FontSize="16"
                                                   TextColor="{StaticResource Primary}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold"
                                                   TextColor="{StaticResource TextPrimary}"/>
                                            <Label FontSize="16" TextColor="{StaticResource TextSecondary}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="身份证: "/>
                                                        <Span Text="{Binding IdCard}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label FontSize="16" TextColor="{StaticResource TextTertiary}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding SourceDisplay}"/>
                                                        <Span Text=" · "/>
                                                        <Span Text="{Binding RecordDate, StringFormat='{0:yyyy-MM-dd}'}"/>
                                                        <Span Text=" · ID:"/>
                                                        <Span Text="{Binding RecordId}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
                                <Label Text="🔍" FontSize="48"
                                       TextColor="{StaticResource Gray400}" HorizontalOptions="Center"/>
                                <Label Text="未找到匹配的记录" Style="{StaticResource EmptyStateLabel}"
                                       Margin="0,12,0,0"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <!-- 底部按钮 -->
                    <Grid Padding="20,16" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Button Text="取消" Style="{StaticResource ButtonOutline}"
                                Command="{Binding CancelSearchResultCommand}" MinimumWidthRequest="100"/>
                        <Button Grid.Column="1" Text="确认选择" Style="{StaticResource ButtonPrimary}"
                                Command="{Binding ConfirmSearchResultCommand}" MinimumWidthRequest="120"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 家庭成员导入弹窗 -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Grid.RowSpan="2"
                IsVisible="{Binding IsMemberImportPopupVisible}"
                BackgroundColor="#80000000"
                ZIndex="100"
                StrokeThickness="0">
            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 12"
                    Padding="0"
                    MaximumWidthRequest="520"
                    MaximumHeightRequest="520"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="40">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource ShadowDark}" Offset="0,4" Radius="16" Opacity="0.3"/>
                </Border.Shadow>
                <VerticalStackLayout Spacing="0">
                    <!-- 标题栏 -->
                    <Grid Padding="20,16" ColumnDefinitions="*,Auto" BackgroundColor="{StaticResource Primary}">
                        <Label Text="选择要导入的家庭成员" FontSize="16"
                               TextColor="White" FontAttributes="Bold" VerticalOptions="Center"/>
                        <Button Grid.Column="1" Text="✕"
                                FontSize="18" FontAttributes="Bold"
                                TextColor="White" BackgroundColor="Transparent"
                                WidthRequest="32" HeightRequest="32" Padding="0"
                                CornerRadius="16"
                                Command="{Binding CancelMemberImportCommand}"/>
                    </Grid>

                    <!-- 提示信息 -->
                    <Label Padding="20,12,20,4" FontSize="15" TextColor="{StaticResource TextSecondary}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="找到 "/>
                                <Span Text="{Binding SelectableFamilyMembers.Count}" FontAttributes="Bold"/>
                                <Span Text=" 条记录，请勾选要导入的成员"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <!-- 成员列表 -->
                    <CollectionView ItemsSource="{Binding SelectableFamilyMembers}"
                                    MaximumHeightRequest="300"
                                    Margin="16,0">
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="20,40">
                                <Label Text="{OnPlatform WinUI='&#xE77B;', Android='&#x1F464;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="36" TextColor="{StaticResource Gray400}" HorizontalOptions="Center"/>
                                <Label Text="暂无家庭成员数据" Style="{StaticResource EmptyStateLabel}" FontSize="14" Margin="0,8,0,0"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="results:AssetVerificationFamilyMember">
                                <Border Padding="14" Margin="0,4" StrokeShape="RoundRectangle 8"
                                        Stroke="{StaticResource Gray200}" StrokeThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center"/>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding Name}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label FontSize="14" TextColor="{StaticResource TextSecondary}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="身份证: "/>
                                                        <Span Text="{Binding IdCard}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label FontSize="14" TextColor="{StaticResource TextTertiary}">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="关系: "/>
                                                        <Span Text="{Binding Relationship, Converter={StaticResource RelationshipDisplayConverter}}"/>
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2" Style="{StaticResource ChipInfo}"
                                                VerticalOptions="Center"
                                                IsVisible="{Binding IsHead}">
                                            <Label Text="户主" Style="{StaticResource ChipInfoText}" HorizontalOptions="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- 操作按钮 -->
                    <Grid Padding="20,16" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12">
                        <Button Text="全选" Command="{Binding SelectAllMembersCommand}"
                                Style="{StaticResource ButtonOutline}" HeightRequest="36"/>
                        <Button Grid.Column="1" Text="取消全选" Command="{Binding DeselectAllMembersCommand}"
                                Style="{StaticResource ButtonOutline}" HeightRequest="36"/>
                        <Button Grid.Column="3" Text="取消" Command="{Binding CancelMemberImportCommand}"
                                Style="{StaticResource ButtonOutline}" HeightRequest="36"/>
                        <Button Grid.Column="4"
                                Command="{Binding ImportSelectedMembersCommand}"
                                Style="{StaticResource ButtonPrimary}" HeightRequest="36">
                            <Button.Text>
                                <Binding Path="SelectedMemberCount" StringFormat="导入选中 ({0}人)"/>
                            </Button.Text>
                        </Button>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 加载指示器 -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <components:LoadingOverlay Grid.Row="0" Grid.RowSpan="4"
                                   IsLoading="{Binding IsBusy}"
                                   LoadingText="{Binding LoadingMessage}"/>

        <!-- ═══════════════════════════════════════════════════════════ -->
        <!-- 底部按钮栏 -->
        <!-- ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" BackgroundColor="{StaticResource White}" StrokeThickness="0" Padding="20,12">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}" Offset="0,-2" Radius="4" Opacity="0.1"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
                <Button Grid.Column="0" Text="放弃申请" Style="{StaticResource ButtonOutline}"
                        Command="{Binding AbandonCommand}"
                        IsVisible="{Binding IsEditable}" TextColor="{StaticResource Error}"/>
                <Button Grid.Column="1" Text="保存草稿" Style="{StaticResource ButtonOutline}"
                        Command="{Binding SaveDraftCommand}"
                        IsVisible="{Binding IsSaveDraftVisible}"/>
                <Button Grid.Column="2" Text="← 上一步" Style="{StaticResource ButtonOutline}"
                        Command="{Binding PreviousStepCommand}" IsVisible="{Binding IsNotFirstStep}" MinimumWidthRequest="100"/>
                <Button Grid.Column="3" Text="下一步 →" Style="{StaticResource ButtonPrimary}"
                        Command="{Binding NextStepCommand}" IsVisible="{Binding IsNotLastStep}" MinimumWidthRequest="100"/>
                <Button Grid.Column="4" Text="提交" Style="{StaticResource ButtonSuccess}"
                        Command="{Binding SaveCommand}" IsVisible="{Binding IsSubmitVisible}"
                        IsEnabled="{Binding IsClassificationDone}" MinimumWidthRequest="100"/>
            </Grid>
        </Border>

    </Grid>

</ContentPage>
