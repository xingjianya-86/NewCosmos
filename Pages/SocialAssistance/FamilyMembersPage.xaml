<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Pages.SocialAssistance.FamilyMembersPage"
             x:DataType="FamilyMembersViewModel"
             Title="家庭成员" BackgroundColor="{StaticResource Background}">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <!-- 统一页头（纸墨档案风报头 · Phase 6 页头架构统一，替代旧渐变英雄头） -->
        <components:PageHeaderView Grid.Row="0"
              Glyph="{OnPlatform WinUI='&#xE77B;', Android='&#x1F464;'}"
                                  Title="家庭成员"
                                  Subtitle="管理共同生活家庭成员信息"
                                  BackCommand="{Binding GoBackCommand}"
                                  BackText="返回"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="12">
                <Label Text="共同生活成员" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                <CollectionView ItemsSource="{Binding Members}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="暂无家庭成员，点击下方“+ 添加成员”" Style="{StaticResource EmptyStateLabel}" Margin="0,16"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="MemberItem">
                            <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,4">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Switch IsToggled="{Binding IsEnabled}" OnColor="{StaticResource Primary}" VerticalOptions="Center"/>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Name}" FontSize="19" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                        <Label FontSize="16" TextColor="{StaticResource TextSecondary}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding RelationshipToHead, Converter={StaticResource RelationshipDisplayConverter}}"/> <Span Text=" "/>
                                                    <Span Text="{Binding Gender}"/> <Span Text=" "/>
                                                    <Span Text="{Binding Age,StringFormat='{0}岁'}"/> <Span Text=" "/>
                                                    <Span Text="{Binding HealthStatus}"/>
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2" Text="编辑详情" BackgroundColor="{StaticResource Gray200}" TextColor="{StaticResource Primary}" FontSize="16" CornerRadius="8" Padding="12,0" HeightRequest="36"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <Button Text="+ 添加成员" Command="{Binding AddNewMemberCommand}" BackgroundColor="{StaticResource Gray100}" TextColor="{StaticResource Primary}" CornerRadius="8" HeightRequest="44"/>
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="2" BackgroundColor="{StaticResource White}" Padding="20,12" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <Button Grid.Column="1" Text="保存" Command="{Binding SaveCommand}" Style="{StaticResource ButtonPrimary}" MinimumWidthRequest="100"/>
            <Button Grid.Column="2" Text="下一步" Style="{StaticResource ButtonPrimary}" MinimumWidthRequest="100"/>
        </Grid>
    </Grid>
</ContentPage>
