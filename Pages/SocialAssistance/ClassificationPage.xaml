<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Pages.SocialAssistance.ClassificationPage"
             x:DataType="ClassificationViewModel"
             Title="分类认定" BackgroundColor="{StaticResource Background}">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <!-- 渐变英雄头部（蓝色） -->
        <Border Grid.Row="0" Style="{StaticResource ModuleHeroHeader}" Background="{StaticResource StatCardBlueGradient}">
            <VerticalStackLayout Spacing="12">

                <!-- 返回行 -->
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <HorizontalStackLayout Spacing="6">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                        </HorizontalStackLayout.GestureRecognizers>
                        <Label Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="14" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                        <Label Text="返回" FontSize="13" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>

                <!-- 标题与副标题 -->
                <HorizontalStackLayout Spacing="14">
                    <Border WidthRequest="44" HeightRequest="44" BackgroundColor="#33FFFFFF" StrokeShape="RoundRectangle 12">
                        <Label Text="&#xE892;" FontFamily="Segoe Fluent Icons" FontSize="22" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="分类认定" Style="{StaticResource ModuleHeroTitle}"/>
                        <Label Text="根据收入与资产判定救助类别" Style="{StaticResource ModuleHeroSubtitle}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">
                <!-- 判定结果 -->
                <Border Style="{StaticResource CardBorderElevated}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="判定结果" Style="{StaticResource SectionTitleLabel}" Margin="0" TextColor="{StaticResource TextSecondary}"/>
                        <Label Text="{Binding ClassificationName}" FontSize="28" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center"/>
                        <Label FontSize="18" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString><Span Text="保障金额: "/><Span Text="{Binding GuaranteeAmount,StringFormat='{0:F2}'}" FontAttributes="Bold"/><Span Text=" 元/月"/></FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Border>
                <!-- 一事一议按钮 -->
                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding ShowSpecialApproval}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="⚠ 当前判定为：不符合条件" FontSize="18" TextColor="{StaticResource Error}"/>
                        <Button Text="一事一议" Command="{Binding SpecialApprovalCommand}" Style="{StaticResource WarningButton}"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="2" BackgroundColor="{StaticResource White}" Padding="20,12" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <Button Grid.Column="1" Text="保存认定" Command="{Binding SaveCommand}" Style="{StaticResource ButtonPrimary}" MinimumWidthRequest="120"/>
            <Button Grid.Column="2" Text="输出档案" Command="{Binding GoOutputCommand}" Style="{StaticResource ButtonSecondary}" MinimumWidthRequest="120"/>
        </Grid>
    </Grid>
</ContentPage>
