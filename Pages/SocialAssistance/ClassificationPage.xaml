<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Pages.SocialAssistance.ClassificationPage"
             x:DataType="ClassificationViewModel"
             Title="分类认定" BackgroundColor="{StaticResource Background}">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="0">

        <!-- 统一页头（纸墨档案风报头 · Phase 6 页头架构统一，替代旧渐变英雄头） -->
        <components:PageHeaderView Grid.Row="0"
              Glyph="{OnPlatform WinUI='&#xE892;', Android='&#x1F3F7;&#xFE0F;'}"
                                  Title="分类认定"
                                  Subtitle="根据收入与资产判定救助类别"
                                  BackCommand="{Binding GoBackCommand}"
                                  BackText="返回"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">
                <!-- 判定结果 -->
                <Border Style="{StaticResource CardBorderElevated}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="判定结果" Style="{StaticResource SectionTitleLabel}" Margin="0" TextColor="{StaticResource TextSecondary}"/>
                        <Label Text="{Binding ClassificationName}" FontSize="{OnPlatform WinUI=30, Android=24, Default=30}" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center"/>
                        <Label FontSize="{OnPlatform WinUI=20, Android=18, Default=20}" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString><Span Text="保障金额: "/><Span Text="{Binding GuaranteeAmount,StringFormat='{0:F2}'}" FontAttributes="Bold"/><Span Text=" 元/月"/></FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Border>
                <!-- 一事一议按钮 -->
                <Border Style="{StaticResource CardBorder}" IsVisible="{Binding ShowSpecialApproval}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="⚠ 当前判定为：不符合条件" FontSize="{OnPlatform WinUI=20, Android=18, Default=20}" TextColor="{StaticResource Error}"/>
                        <Button Text="一事一议" Command="{Binding SpecialApprovalCommand}" Style="{StaticResource WarningButton}"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Grid Grid.Row="2" BackgroundColor="{StaticResource White}" Padding="20,12" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <Button Grid.Column="1" Text="保存认定" Command="{Binding SaveCommand}" Style="{StaticResource ButtonPrimary}" MinimumWidthRequest="120"/>
            <Button Grid.Column="2" Text="输出档案" Command="{Binding GoOutputCommand}" Style="{StaticResource ButtonSecondary}" MinimumWidthRequest="120"/>
        </Grid>
    </Grid>
</ContentPage>
