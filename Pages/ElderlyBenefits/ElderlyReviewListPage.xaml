<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ent="clr-namespace:NewCosmos.Models.Entities"
             x:Class="NewCosmos.Pages.ElderlyBenefits.ElderlyReviewListPage"
             x:DataType="ElderlyReviewListViewModel"
             Title="高龄津贴复核"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <!-- 待复核队列行 -->
        <DataTemplate x:Key="PendingReviewRow" x:DataType="ent:ElderlyReview">
            <Grid Padding="16"
                  Style="{StaticResource TableRowInteractive}"
                  ColumnDefinitions="1.4*, 2*, 2.6*, 1.4*, Auto"
                  BackgroundColor="White">
                <Label Text="{Binding Name}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="{Binding IdCard}" FontSize="14" VerticalOptions="Center"/>
                <Label Grid.Column="2" Text="{Binding CategoryChangeDisplay}" FontSize="14" VerticalOptions="Center"/>
                <Label Grid.Column="3" Text="{Binding TriggerSourceName}" FontSize="13"
                       TextColor="{StaticResource Info}" VerticalOptions="Center"/>
                <Button Grid.Column="4" Text="办理" Style="{StaticResource ButtonSmall}"
                        BackgroundColor="{StaticResource ModuleElderly}"
                        IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type ElderlyReviewListViewModel}}, Path=CanReview}"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ElderlyReviewListViewModel}}, Path=ReviewPendingCommand}"
                        CommandParameter="{Binding .}"/>
            </Grid>
        </DataTemplate>

        <!-- 在享人员检索行 -->
        <DataTemplate x:Key="ReviewSearchRow" x:DataType="ent:ElderlyApplication">
            <Grid Padding="16"
                  Style="{StaticResource TableRowInteractive}"
                  ColumnDefinitions="1.4*, 1.4*, 2*, 2.4*, 1.4*, Auto"
                  BackgroundColor="White">
                <Label Text="{Binding ApplicationNo}" FontSize="14" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="{Binding Name}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="2" Text="{Binding IdCard}" FontSize="14" VerticalOptions="Center"/>
                <Label Grid.Column="3" Text="{Binding CategoryName}" FontSize="14" VerticalOptions="Center"/>
                <Label Grid.Column="4" Text="{Binding IssueStartMonth}" FontSize="14" VerticalOptions="Center"/>
                <Button Grid.Column="5" Text="复核" Style="{StaticResource ButtonSmall}"
                        BackgroundColor="{StaticResource ModuleElderly}"
                        IsEnabled="{Binding Source={RelativeSource AncestorType={x:Type ElderlyReviewListViewModel}}, Path=CanReview}"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ElderlyReviewListViewModel}}, Path=ReviewApplicationCommand}"
                        CommandParameter="{Binding .}"/>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- 渐变英雄头部（紫色） -->
        <Border Grid.Row="0" Style="{StaticResource ModuleHeroHeader}" Background="{StaticResource StatCardPurpleGradient}">
            <VerticalStackLayout Spacing="16">
                <HorizontalStackLayout Spacing="6">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="14" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                    <Label Text="返回工作台" FontSize="13" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="14">
                    <Border WidthRequest="52" HeightRequest="52" BackgroundColor="#33FFFFFF" StrokeShape="RoundRectangle 14">
                        <Label Text="&#xE9D5;" FontFamily="Segoe Fluent Icons" FontSize="28" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="高龄津贴复核" Style="{StaticResource ModuleHeroTitle}"/>
                        <Label Text="身份 + 年龄重评 · 停旧增新 · 停止/新增/调整三表" Style="{StaticResource ModuleHeroSubtitle}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- 待复核队列 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="24,16,24,0" Padding="0"
                IsVisible="{Binding HasPendingReviews}">
            <VerticalStackLayout Spacing="0">
                <Grid Padding="16,12" ColumnDefinitions="Auto,*" ColumnSpacing="8" BackgroundColor="{StaticResource WarningSoft}">
                    <Label Text="&#xE7BA;" FontFamily="Segoe Fluent Icons" FontSize="16" TextColor="{StaticResource Warning}" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding PendingCount, StringFormat='待复核队列（{0} 人）'}"
                           FontSize="15" FontAttributes="Bold" TextColor="{StaticResource WarningDark}" VerticalOptions="Center"/>
                </Grid>
                <Grid Padding="16,8" Style="{StaticResource TableHeader}" ColumnDefinitions="1.4*, 2*, 2.6*, 1.4*, Auto">
                    <Label Text="姓名" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="1" Text="身份证号" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="2" Text="类别变化（旧 → 新）" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="3" Text="触发来源" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="4" Text="操作" Style="{StaticResource TableHeaderLabel}" HorizontalOptions="Center"/>
                </Grid>
                <CollectionView ItemsSource="{Binding PendingReviews}" SelectionMode="None" ItemTemplate="{StaticResource PendingReviewRow}"/>
            </VerticalStackLayout>
        </Border>

        <!-- 检索工具栏 -->
        <Border Grid.Row="2" BackgroundColor="{StaticResource White}" StrokeThickness="0" Padding="24,16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="在享人员检索" Style="{StaticResource SectionTitleLabel}" Margin="0" VerticalOptions="Center"/>
                <Border Grid.Column="1" BackgroundColor="{StaticResource Gray100}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 24" Padding="16,8" HorizontalOptions="Fill">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <Label Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               TextColor="{StaticResource Gray500}" VerticalOptions="Center" Margin="0,0,8,0"/>
                        <Entry Grid.Column="1" Placeholder="搜索在享人员姓名、身份证号"
                               Text="{Binding SearchText}" FontSize="16" BackgroundColor="Transparent"
                               ReturnCommand="{Binding SearchCommand}"/>
                        <Button Grid.Column="2" Text="搜索" Style="{StaticResource ButtonSmall}"
                                BackgroundColor="{StaticResource Primary}" Command="{Binding SearchCommand}"
                                VerticalOptions="Center" Margin="8,0,0,0"/>
                        <Button Grid.Column="3" Text="按身份证复核" Style="{StaticResource ButtonSmall}"
                                BackgroundColor="{StaticResource ModuleElderly}" Command="{Binding ReviewByIdCardCommand}"
                                IsEnabled="{Binding CanReview}" VerticalOptions="Center" Margin="8,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 检索结果 -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0" Margin="24,0,24,16" MinimumWidthRequest="900">
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Grid.Row="0" Style="{StaticResource TableHeader}" Padding="16"
                      ColumnDefinitions="1.4*, 1.4*, 2*, 2.4*, 1.4*, Auto">
                    <Label Text="申请编号" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="1" Text="姓名" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="2" Text="身份证号" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="3" Text="享受类别" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="4" Text="计发年月" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="5" Text="操作" Style="{StaticResource TableHeaderLabel}" HorizontalOptions="Center"/>
                </Grid>
                <CollectionView Grid.Row="1" ItemsSource="{Binding SearchResults}" SelectionMode="None"
                                ItemTemplate="{StaticResource ReviewSearchRow}">
                    <CollectionView.EmptyView>
                        <Label Text="暂无在享人员" Style="{StaticResource EmptyStateLabel}"/>
                    </CollectionView.EmptyView>
                </CollectionView>
                <components:PaginationBarView Grid.Row="2" BackgroundColor="{StaticResource Gray50}"/>
            </Grid>
        </Border>

        <components:LoadingOverlay Grid.Row="0" Grid.RowSpan="4"
                                   IsLoading="{Binding IsBusy}" LoadingText="正在加载数据..."/>
    </Grid>
</ContentPage>
