<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ent="clr-namespace:NewCosmos.Models.Entities"
             x:Class="NewCosmos.Pages.ElderlyBenefits.ElderlyReviewPage"
             x:DataType="ElderlyReviewViewModel"
             Title="高龄津贴复核"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 渐变英雄头部（紫色） -->
        <Border Grid.Row="0" Style="{StaticResource ModuleHeroHeader}" Background="{StaticResource StatCardPurpleGradient}">
            <VerticalStackLayout Spacing="16">
                <HorizontalStackLayout Spacing="6">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="{OnPlatform WinUI='&#xE72B;', Android='&#x2190;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="14" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                    <Label Text="返回" FontSize="13" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="14">
                    <Border WidthRequest="52" HeightRequest="52" BackgroundColor="#33FFFFFF" StrokeShape="RoundRectangle 14">
                        <Label Text="{OnPlatform WinUI='&#xE9D5;', Android='&#x26A0;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="28" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="高龄津贴复核办理" Style="{StaticResource ModuleHeroTitle}"/>
                        <Label Text="重评身份与年龄档次，变更后停旧增新并打印三表" Style="{StaticResource ModuleHeroSubtitle}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- 人员信息 -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="人员信息" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                        <BoxView Style="{StaticResource Divider}" Margin="0"/>
                        <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="姓名" Style="{StaticResource FormFieldLabelStyle}"/>
                                <Entry Text="{Binding ApplicantName}" IsReadOnly="True"
                                       BackgroundColor="{StaticResource Gray100}" Style="{StaticResource FormFieldEntryStyle}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="性别" Style="{StaticResource FormFieldLabelStyle}"/>
                                <Entry Text="{Binding Gender}" IsReadOnly="True"
                                       BackgroundColor="{StaticResource Gray100}" Style="{StaticResource FormFieldEntryStyle}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="年龄" Style="{StaticResource FormFieldLabelStyle}"/>
                                <Entry Text="{Binding AgeDisplay}" IsReadOnly="True"
                                       BackgroundColor="{StaticResource Gray100}" Style="{StaticResource FormFieldEntryStyle}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" Spacing="4">
                                <Label Text="档案" Style="{StaticResource FormFieldLabelStyle}"/>
                                <Entry Text="{Binding ApplicationNo}" IsReadOnly="True"
                                       BackgroundColor="{StaticResource Gray100}" Style="{StaticResource FormFieldEntryStyle}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="4">
                                <Label Text="身份证号码" Style="{StaticResource FormFieldLabelStyle}"/>
                                <Entry Text="{Binding ApplicantIdCard}" IsReadOnly="True"
                                       BackgroundColor="{StaticResource Gray100}" Style="{StaticResource FormFieldEntryStyle}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Spacing="4">
                                <Label Text="身份比对结果" Style="{StaticResource FormFieldLabelStyle}"/>
                                <Entry Text="{Binding IdentityFlag}" IsReadOnly="True"
                                       BackgroundColor="{StaticResource Gray100}" Style="{StaticResource FormFieldEntryStyle}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- 补全拦截提示条：名册未建档 / 导入来源档案缺必填项时显示，按钮与确认复核的硬拦截同路径 -->
                        <Border IsVisible="{Binding IsCompletionNeeded}" Style="{StaticResource CardBorder}"
                                BackgroundColor="{StaticResource InfoSoft}" Stroke="Transparent" Padding="12">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="该人员档案来自高龄导入名册，办理复核前需先补建并补全档案信息。补全保存后将自动返回本页继续复核（复核变更将停旧增新并打印三表）。"
                                       FontSize="13" TextColor="{StaticResource PrimaryDark}" LineBreakMode="WordWrap"/>
                                <Label Text="{Binding CompletionHint}" FontSize="12"
                                       TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap"/>
                                <Button Text="补全历史档案" Style="{StaticResource ButtonOutline}"
                                        Command="{Binding CompleteHistoryArchiveCommand}" HeightRequest="36"/>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 评估结果 -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="类别评估" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                        <BoxView Style="{StaticResource Divider}" Margin="0"/>

                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12">
                            <Border BackgroundColor="{StaticResource Gray100}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="当前（旧）类别" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                                    <Label Text="{Binding OldCategoryName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                    <Label Text="{Binding OldAmountText}" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                                </VerticalStackLayout>
                            </Border>
                            <Label Grid.Column="1" Text="{OnPlatform WinUI='&#xE72A;', Android='&#x2753;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="20"
                                   TextColor="{StaticResource Gray400}" VerticalOptions="Center"/>
                            <Border Grid.Column="2" BackgroundColor="{StaticResource PrimarySoft}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="重评（新）类别" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                                    <Label Text="{Binding NewCategoryName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}"/>
                                    <Label Text="{Binding NewAmountText}" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="变化类型" Style="{StaticResource FormFieldLabelStyle}"/>
                                <Entry Text="{Binding ChangeTypeText}" IsReadOnly="True"
                                       BackgroundColor="{StaticResource Gray100}" Style="{StaticResource FormFieldEntryStyle}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="调整原因" Style="{StaticResource FormFieldLabelStyle}"/>
                                <Entry Text="{Binding AdjustReasonName}" IsReadOnly="True"
                                       BackgroundColor="{StaticResource Gray100}" Style="{StaticResource FormFieldEntryStyle}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Label Text="应生效月" Style="{StaticResource FormFieldLabelStyle}"/>
                                <Entry Text="{Binding EffectiveMonthText}" IsReadOnly="True"
                                       BackgroundColor="{StaticResource Gray100}" Style="{StaticResource FormFieldEntryStyle}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="新档计发起始月（次月）" Style="{StaticResource FormFieldLabelStyle}"/>
                                <Entry Text="{Binding IssueStartMonthText}" IsReadOnly="True"
                                       BackgroundColor="{StaticResource Gray100}" Style="{StaticResource FormFieldEntryStyle}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 复核意见 -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="复核意见" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                        <BoxView Style="{StaticResource Divider}" Margin="0"/>
                        <Editor Text="{Binding ReviewOpinion}" Placeholder="复核意见/说明（可选）..." HeightRequest="80"/>
                    </VerticalStackLayout>
                </Border>

                <!-- 复核历史 -->
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="复核历史" Style="{StaticResource SectionTitleLabel}" Margin="0"/>
                        <BoxView Style="{StaticResource Divider}" Margin="0"/>
                        <CollectionView ItemsSource="{Binding HistoryRecords}">
                            <CollectionView.EmptyView>
                                <Label Text="暂无复核记录" FontSize="13" TextColor="{StaticResource TextTertiary}"/>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="ent:ElderlyReview">
                                    <Grid ColumnDefinitions="1.6*, 2.4*, 1.4*, 1.4*" Padding="0,6" ColumnSpacing="8">
                                        <Label Text="{Binding ReviewedAt, StringFormat='{0:yyyy-MM-dd}'}" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                                        <Label Grid.Column="1" Text="{Binding CategoryChangeDisplay}" FontSize="13" TextColor="{StaticResource TextPrimary}"/>
                                        <Label Grid.Column="2" Text="{Binding ReviewResultName}" FontSize="13" TextColor="{StaticResource Success}"/>
                                        <Label Grid.Column="3" Text="{Binding ReviewedBy}" FontSize="13" TextColor="{StaticResource TextSecondary}"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" BackgroundColor="White" Padding="20,12" StrokeThickness="0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <Button Grid.Column="1" Text="确认复核" Style="{StaticResource ButtonPrimary}"
                        Command="{Binding ConfirmReviewCommand}" IsEnabled="{Binding CanConfirm}"
                        MinimumWidthRequest="140"/>
                <Button Grid.Column="2" Text="取消" Style="{StaticResource ButtonOutline}"
                        Command="{Binding CancelCommand}" MinimumWidthRequest="100"/>
            </Grid>
        </Border>

        <components:LoadingOverlay Grid.Row="0" Grid.RowSpan="3"
                                   IsLoading="{Binding IsBusy}" LoadingText="正在重评类别..."/>
    </Grid>
</ContentPage>
