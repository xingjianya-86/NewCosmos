<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Pages.ElderlyBenefits.ElderlyBenefitsHomePage"
             x:DataType="ElderlyBenefitsHomeViewModel"
             Title="高龄津贴发放"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="Auto,*">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,20">

                <!-- 域色渐变头部横幅：标题 + 职责描述 + 模块统计栏 -->
                <!-- 统一页头（纸墨档案风报头 · Phase 6，统计胶囊迁入 Stats 插槽并转浅色变体） -->
                <components:PageHeaderView
                                           Glyph="{OnPlatform WinUI='&#xE7B8;', Android='&#x1F474;'}"
                                           Title="高龄津贴发放"
                                           Subtitle="80 周岁以上老年人津贴申请登记 · 停发管理 · 类别复核 · 月度报表"
                                           BackCommand="{Binding GoBackCommand}"
                                           BackText="返回工作台">
                    <components:PageHeaderView.Stats>
<Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                            <components:StatCapsule IsLight="True"  Grid.Column="0"  Value="{Binding ActiveCountText}" Caption="在享领取（人）"/>
                            <components:StatCapsule IsLight="True"  Grid.Column="1"  Value="{Binding MonthlyNewText}" Caption="本月新增登记（人）"/>

                            <Border Grid.Column="2" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                    BackgroundColor="Transparent" Padding="0">
                                <components:StatCapsule IsLight="True" Value="{Binding PendingNewText}" Caption="待新增（人）"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToElderlyPendingCommand}"/>
                                </Border.GestureRecognizers>
                            </Border>

                            <Border Grid.Column="3" StrokeThickness="0" StrokeShape="RoundRectangle 8"
                                    BackgroundColor="Transparent" Padding="0">
                                <components:StatCapsule IsLight="True" Value="{Binding PendingTransferText}" Caption="需停旧增新（人）"/>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToElderlyPendingCommand}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </components:PageHeaderView.Stats>
                </components:PageHeaderView>

                <!-- 子功能卡片区 -->
                <VerticalStackLayout Margin="20,20,20,0" Spacing="14">
                    <Label Text="业务办理" Style="{StaticResource SectionTitleLabel}" Margin="4,4,0,0"/>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="14">

                        <!-- 申请登记 -->
                        <components:FeatureCard Grid.Row="0" Grid.Column="0" Glyph="{OnPlatform WinUI='&#xE710;', Android='&#x2795;'}"
                                                IconBackgroundColor="#F5F3FF" IconColor="{StaticResource ModuleElderly}"
                                                Title="津贴申请登记" Description="受理登记、审核确认高龄津贴申请"
                                                Command="{Binding OpenApplicationListCommand}"
                                                Opacity="{Binding ElderlyOpacity}"/>

                        <!-- 停发办理 -->
                        <components:FeatureCard Grid.Row="0" Grid.Column="1" Glyph="{OnPlatform WinUI='&#xE738;', Android='&#x1F3B5;'}"
                                                IconBackgroundColor="#F5F3FF" IconColor="{StaticResource ModuleElderly}"
                                                Title="停发办理" Description="死亡、户籍迁出等情形停发处理"
                                                Command="{Binding OpenStopListCommand}"
                                                Opacity="{Binding ElderlyOpacity}"/>

                        <!-- 月报表 -->
                        <components:FeatureCard Grid.Row="1" Grid.Column="0" Glyph="{OnPlatform WinUI='&#xE81E;', Android='&#x1F6E0;&#xFE0F;'}"
                                                IconBackgroundColor="#F5F3FF" IconColor="{StaticResource ModuleElderly}"
                                                Title="高龄津贴月报表" Description="按月生成、导出发放统计报表"
                                                Command="{Binding OpenMonthlyReportCommand}"
                                                Opacity="{Binding ElderlyOpacity}"/>

                        <!-- 后补追缴入口已收敛到主界面侧栏（CanAccessRecovery 权限门控），本页不再重复 -->

                        <!-- 高龄津贴复核 -->
                        <components:FeatureCard Grid.Row="2" Grid.Column="0" Glyph="{OnPlatform WinUI='&#xE9D5;', Android='&#x26A0;&#xFE0F;'}"
                                                IconBackgroundColor="#F5F3FF" IconColor="{StaticResource ModuleElderly}"
                                                Title="高龄津贴复核" Description="身份/年龄重评，停旧增新并打印三表"
                                                Command="{Binding OpenReviewListCommand}"
                                                Opacity="{Binding ElderlyOpacity}"/>

                        <!-- 下月待办 -->
                        <components:FeatureCard Grid.Row="2" Grid.Column="1" Glyph="{OnPlatform WinUI='&#xE823;', Android='&#x1F4C5;'}"
                                                IconBackgroundColor="#F5F3FF" IconColor="{StaticResource ModuleElderly}"
                                                Title="下月待办" Description="已完结档案中满80周岁待办理人员"
                                                Command="{Binding NavigateToElderlyPendingCommand}"
                                                Opacity="{Binding ElderlyOpacity}"/>

                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
