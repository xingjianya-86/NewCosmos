<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ent="clr-namespace:NewCosmos.Models.Entities"
             x:Class="NewCosmos.Pages.ElderlyBenefits.ElderlyStopListPage"
             x:DataType="ElderlyStopListViewModel"
             Title="停发办理"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <!-- 在享/当前库搜索列表交替行色（共用） -->
        <DataTemplate x:Key="ElderlyStopEvenRow" x:DataType="ent:ElderlyApplication">
            <Grid Padding="16"
                  Style="{StaticResource TableRowInteractive}"
                  ColumnDefinitions="50, 1.5*, 1.2*, 2*, 1.5*, 1.5*, Auto"
                  BackgroundColor="White">
                <Label Text="{Binding Id}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="{Binding ApplicationNo}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="2" Text="{Binding Name}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="3" Text="{Binding IdCard}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="4" Text="{Binding CategoryName}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="5" Text="{Binding IssueStartMonth}" FontSize="15" VerticalOptions="Center"/>
                <HorizontalStackLayout Grid.Column="6" Spacing="8" HorizontalOptions="Center">
                    <Button Text="停发" Style="{StaticResource ButtonSmall}"
                            BackgroundColor="{StaticResource Warning}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ElderlyStopListViewModel}}, Path=StopCommand}"
                            CommandParameter="{Binding .}"/>
                </HorizontalStackLayout>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ElderlyStopOddRow" x:DataType="ent:ElderlyApplication">
            <Grid Padding="16"
                  Style="{StaticResource TableRowInteractive}"
                  ColumnDefinitions="50, 1.5*, 1.2*, 2*, 1.5*, 1.5*, Auto"
                  BackgroundColor="#F8F9FA">
                <Label Text="{Binding Id}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="{Binding ApplicationNo}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="2" Text="{Binding Name}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="3" Text="{Binding IdCard}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="4" Text="{Binding CategoryName}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="5" Text="{Binding IssueStartMonth}" FontSize="15" VerticalOptions="Center"/>
                <HorizontalStackLayout Grid.Column="6" Spacing="8" HorizontalOptions="Center">
                    <Button Text="停发" Style="{StaticResource ButtonSmall}"
                            BackgroundColor="{StaticResource Warning}"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ElderlyStopListViewModel}}, Path=StopCommand}"
                            CommandParameter="{Binding .}"/>
                </HorizontalStackLayout>
            </Grid>
        </DataTemplate>
        <converters:AlternatingRowTemplateSelector x:Key="ActiveStopSelector"
            EvenTemplate="{StaticResource ElderlyStopEvenRow}"
            OddTemplate="{StaticResource ElderlyStopOddRow}"/>
        <converters:AlternatingRowTemplateSelector x:Key="CurSearchStopSelector"
            EvenTemplate="{StaticResource ElderlyStopEvenRow}"
            OddTemplate="{StaticResource ElderlyStopOddRow}"/>

        <!-- 导入库搜索列表交替行色 -->
        <DataTemplate x:Key="ImportedStopEvenRow" x:DataType="ent:ElderlyImportedSearchItem">
            <Grid Padding="16"
                  Style="{StaticResource TableRowInteractive}"
                  ColumnDefinitions="50, 1.5*, 1.2*, 2*, 1.5*, 1.5*, Auto"
                  BackgroundColor="White">
                <Label Text="{Binding Id}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="--" FontSize="15" VerticalOptions="Center" TextColor="{StaticResource Gray500}"/>
                <Label Grid.Column="2" Text="{Binding Name}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="3" Text="{Binding IdCard}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="4" Text="{Binding SourceDisplay}" FontSize="13" VerticalOptions="Center" TextColor="{StaticResource Info}"/>
                <Label Grid.Column="5" Text="{Binding Age, StringFormat='{0} 岁'}" FontSize="15" VerticalOptions="Center"/>
                <Button Grid.Column="6" Text="建档并停发" Style="{StaticResource ButtonSmall}"
                        BackgroundColor="{StaticResource Warning}"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ElderlyStopListViewModel}}, Path=StopFromImportedCommand}"
                        CommandParameter="{Binding .}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ImportedStopOddRow" x:DataType="ent:ElderlyImportedSearchItem">
            <Grid Padding="16"
                  Style="{StaticResource TableRowInteractive}"
                  ColumnDefinitions="50, 1.5*, 1.2*, 2*, 1.5*, 1.5*, Auto"
                  BackgroundColor="#F8F9FA">
                <Label Text="{Binding Id}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="--" FontSize="15" VerticalOptions="Center" TextColor="{StaticResource Gray500}"/>
                <Label Grid.Column="2" Text="{Binding Name}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="3" Text="{Binding IdCard}" FontSize="15" VerticalOptions="Center"/>
                <Label Grid.Column="4" Text="{Binding SourceDisplay}" FontSize="13" VerticalOptions="Center" TextColor="{StaticResource Info}"/>
                <Label Grid.Column="5" Text="{Binding Age, StringFormat='{0} 岁'}" FontSize="15" VerticalOptions="Center"/>
                <Button Grid.Column="6" Text="建档并停发" Style="{StaticResource ButtonSmall}"
                        BackgroundColor="{StaticResource Warning}"
                        Command="{Binding Source={RelativeSource AncestorType={x:Type ElderlyStopListViewModel}}, Path=StopFromImportedCommand}"
                        CommandParameter="{Binding .}"/>
            </Grid>
        </DataTemplate>
        <converters:AlternatingRowTemplateSelector x:Key="ImportedStopSelector"
            EvenTemplate="{StaticResource ImportedStopEvenRow}"
            OddTemplate="{StaticResource ImportedStopOddRow}"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="0">

        <!-- 渐变英雄头部（紫色） -->
        <Border Grid.Row="0" Style="{StaticResource ModuleHeroHeader}" Background="{StaticResource StatCardPurpleGradient}">
            <VerticalStackLayout Spacing="16">

                <!-- 返回行 -->
                <HorizontalStackLayout Spacing="6">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="14" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                    <Label Text="返回工作台" FontSize="13" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <!-- 标题与副标题 -->
                <HorizontalStackLayout Spacing="14">
                    <Border WidthRequest="52" HeightRequest="52" BackgroundColor="#33FFFFFF" StrokeShape="RoundRectangle 14">
                        <Label Text="&#xE716;" FontFamily="Segoe Fluent Icons" FontSize="28" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                        <Label Text="停发办理" Style="{StaticResource ModuleHeroTitle}"/>
                        <Label Text="在享人员停发登记 / 导入库搜索" Style="{StaticResource ModuleHeroSubtitle}"/>
                    </VerticalStackLayout>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>

        <!-- 统计栏（替换原"共 N 人"chip） -->
        <Grid Grid.Row="1" Padding="20,10" ColumnDefinitions="*,*,*,*" ColumnSpacing="12"
              BackgroundColor="{StaticResource White}">
            <components:StatCapsule Grid.Column="0" IsLight="True" Value="{Binding ActiveCountText}" Caption="在享领取（人）"/>
            <components:StatCapsule Grid.Column="1" IsLight="True" Value="{Binding MonthlyStoppedText}" Caption="本月停发（人次）"/>
            <components:StatCapsule Grid.Column="2" IsLight="True" Value="{Binding YearStoppedText}" Caption="年累计停发（人次）"/>
        </Grid>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="2"
                BackgroundColor="{StaticResource White}"
                StrokeThickness="0"
                Padding="24,16">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}" Offset="0,2" Radius="4" Opacity="0.06"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="*">
                <!-- 搜索框 -->
                <Border BackgroundColor="{StaticResource Gray100}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 24"
                        Padding="16,8"
                        HorizontalOptions="Fill">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Label Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               TextColor="{StaticResource Gray500}"
                               VerticalOptions="Center"
                               Margin="0,0,8,0"/>
                        <Entry Grid.Column="1"
                               Placeholder="搜索申请人姓名、身份证号（支持当前库+导入库）"
                               Text="{Binding SearchText}"
                               FontSize="16"
                               BackgroundColor="Transparent"
                               ReturnCommand="{Binding SearchImportedCommand}"/>
                        <Button Grid.Column="2"
                                Text="搜索"
                                Style="{StaticResource ButtonSmall}"
                                BackgroundColor="{StaticResource Primary}"
                                Command="{Binding SearchImportedCommand}"
                                VerticalOptions="Center"
                                Margin="8,0,0,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 错误提示条：加载/导航失败时显式暴露，禁止静默无响应 -->
        <Border Grid.Row="3"
                Padding="24,8,24,0"
                StrokeThickness="0"
                BackgroundColor="Transparent"
                IsVisible="{Binding HasError}">
            <Border BackgroundColor="{StaticResource Error}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    Padding="14,10">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="&#xE783;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           TextColor="{StaticResource White}"
                           VerticalOptions="Center"/>
                    <Label Text="{Binding ErrorMessage}"
                           FontSize="13"
                           TextColor="{StaticResource White}"
                           VerticalOptions="Center"
                           LineBreakMode="WordWrap"/>
                </HorizontalStackLayout>
            </Border>
        </Border>

        <!-- 数据表格 -->
        <Border Grid.Row="4"
                Style="{StaticResource CardBorder}"
                Padding="0"
                Margin="24,16"
                MinimumWidthRequest="900">

            <Grid RowDefinitions="Auto, *, Auto">

                <!-- 表头 -->
                <Grid Grid.Row="0"
                     Style="{StaticResource TableHeader}"
                     Padding="16"
                     ColumnDefinitions="50, 1.5*, 1.2*, 2*, 1.5*, 1.5*, Auto">
                    <Label Text="序号" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="1" Text="申请编号" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="2" Text="申请人" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="3" Text="身份证号" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="4" Text="享受类别/来源" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="5" Text="计发年月/年龄" Style="{StaticResource TableHeaderLabel}"/>
                    <Label Grid.Column="6" Text="操作" Style="{StaticResource TableHeaderLabel}" HorizontalOptions="Center"/>
                </Grid>

                <BoxView Grid.Row="0"
                        Grid.ColumnSpan="7"
                        HeightRequest="1"
                        BackgroundColor="{StaticResource Gray300}"
                        VerticalOptions="End"/>

                <!-- 默认列表（在享人员） -->
                <CollectionView Grid.Row="1"
                               x:Name="ActiveStopList"
                               ItemsSource="{Binding Applications}"
                               SelectionMode="None"
                               IsVisible="{Binding HasDefaultList}"
                               ItemTemplate="{StaticResource ActiveStopSelector}">
                    <CollectionView.EmptyView>
                        <Label Text="暂无在享人员，无需停发" Style="{StaticResource EmptyStateLabel}"/>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- 搜索结果 - 当前库记录 -->
                <CollectionView Grid.Row="1"
                               x:Name="CurSearchStopList"
                               ItemsSource="{Binding CurrentSearchResults}"
                               SelectionMode="None"
                               IsVisible="{Binding HasSearchResults}"
                               ItemTemplate="{StaticResource CurSearchStopSelector}">
                </CollectionView>

                <!-- 搜索结果 - 导入库记录 -->
                <CollectionView Grid.Row="1"
                               x:Name="ImportedStopList"
                               ItemsSource="{Binding ImportedSearchResults}"
                               SelectionMode="None"
                               IsVisible="{Binding HasSearchResults}"
                               ItemTemplate="{StaticResource ImportedStopSelector}">
                </CollectionView>

                <!-- 分页控件 -->
                <components:PaginationBarView Grid.Row="2" BackgroundColor="{StaticResource Gray50}"/>
            </Grid>
        </Border>

        <!-- 加载指示器 -->
        <components:LoadingOverlay Grid.Row="0" Grid.RowSpan="4"
                                   IsLoading="{Binding IsBusy}"
                                   LoadingText="正在加载数据..."/>
    </Grid>
</ContentPage>
