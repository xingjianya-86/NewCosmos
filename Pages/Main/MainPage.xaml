<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Pages.Main.MainPage"
             x:DataType="MainViewModel"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>

        <!-- 侧边栏导航项（悬停/按下/选中态统一由样式承载） -->
        <Style x:Key="SidebarNavItem" TargetType="Grid">
            <Setter Property="HeightRequest" Value="44"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource SidebarItemHover}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource SidebarItemHover}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource SidebarItemSelected}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <!-- 顶栏图标按钮（悬停/按下反馈与侧栏项同语言）。
             图标必须用 Label + Segoe Fluent Icons 渲染：Button.Text 测量私有区字形时
             用回退字体的窄字宽（约 0.5em），渲染却是全宽字形，齿轮这类宽字形右侧被竖切。 -->
        <Style x:Key="TopIconButton" TargetType="Grid">
            <Setter Property="WidthRequest" Value="40"/>
            <Setter Property="HeightRequest" Value="40"/>
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="VerticalOptions" Value="Center"/>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource Gray100}"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource Gray200}"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="76,Auto,*,44">

        <!-- 顶部报头（纸墨档案风：朱砂竖条 + 宋体标题 + DM Mono kicker + 底部双线） -->
        <Grid Grid.Row="0" ColumnDefinitions="6,*">

            <!-- 左侧朱砂竖条（code.html .tab-strip） -->
            <BoxView Grid.Column="0" Color="{StaticResource Seal}"/>

            <Grid Grid.Column="1" RowDefinitions="*,3,4,1">
                <Border Grid.Row="0" Style="{StaticResource TopBar}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                        <!-- Logo 和标题（窗口变窄时标题截断收缩，避免把右侧操作区挤出窗口） -->
                        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <!-- 应用内 Logo：吉祥物图标（与系统图标同源，Resources\Images\mascot_icon.png） -->
                            <Image Source="mascot_icon.png" WidthRequest="34" HeightRequest="34" Aspect="AspectFill" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                <Label Text="NEWCOSMOS" FontFamily="{OnPlatform WinUI='DM Mono', Android='dmmono', Default='DM Mono'}"
                                       FontSize="13" CharacterSpacing="3.6" TextColor="{StaticResource Seal}"/>
                                <Label Text="{Binding Title}" FontSize="21" FontAttributes="Bold"
                                       FontFamily="{OnPlatform WinUI='Noto Serif SC', Android='notoserifregular', Default='Noto Serif SC'}"
                                       TextColor="{StaticResource TextPrimary}" LineBreakMode="TailTruncation" MaxLines="1"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- 右侧操作区 -->
                        <HorizontalStackLayout Grid.Column="1" Spacing="20">
                            <!-- 当前日期 -->
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{OnPlatform WinUI='&#xE823;', Android='&#x1F4C5;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                <Label Text="{Binding CurrentDateString}" FontSize="18" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <!-- 用户信息（显示真实姓名；姓名过长时截断，避免把设置按钮挤出窗口） -->
                            <Border StrokeThickness="1" Stroke="{StaticResource LineStrong}" BackgroundColor="{StaticResource Gray100}" Padding="10,5" MaximumWidthRequest="260">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Text="{OnPlatform WinUI='&#xE77B;', Android='&#x1F464;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding CurrentUserDisplayName}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1"/>
                                </Grid>
                            </Border>

                            <!-- 设置按钮 -->
                            <Grid Style="{StaticResource TopIconButton}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenSettingsCommand}"/>
                                </Grid.GestureRecognizers>
                                <Label Text="{OnPlatform WinUI='&#xE713;', Android='&#x2699;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- 报头底部双线（3px 墨线 + 4px 间距 + 1px 细线，code.html 签名） -->
                <BoxView Grid.Row="1" Color="{StaticResource Ink}"/>
                <BoxView Grid.Row="3" Color="{StaticResource LineStrong}"/>
            </Grid>
        </Grid>

        <!-- 警告横幅区（Schema + 渐退期到期提醒） -->
        <VerticalStackLayout Grid.Row="1" Spacing="0">

            <!-- Schema警告横幅 -->
            <Border IsVisible="{Binding ShowSchemaWarning}"
                    BackgroundColor="{StaticResource WarningSoft}"
                    StrokeShape="RoundRectangle 0"
                    Padding="16,10"
                    Margin="10,5,10,5">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="{OnPlatform WinUI='&#xE7BA;', Android='&#x26A0;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18" TextColor="{StaticResource WarningDark}" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding SchemaWarningMessage}" FontSize="18" TextColor="{StaticResource WarningDark}" VerticalOptions="Center" HorizontalOptions="Fill"/>
                    <Label Grid.Column="2" Text="{OnPlatform WinUI='&#xE713;', Android='&#x27A1;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource WarningDark}" VerticalOptions="Center" Opacity="0.6"/>
                </Grid>
            </Border>

            <!-- 渐退期提醒横幅（点击跳转到渐退期管理页面） -->
            <Border IsVisible="{Binding ShowGracePeriodWarning}"
                    BackgroundColor="{StaticResource WarningSoft}"
                    StrokeShape="RoundRectangle 0"
                    Padding="16,10"
                    Margin="10,5,10,5">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToGracePeriodExpiringCommand}"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="{OnPlatform WinUI='&#xE823;', Android='&#x1F4C5;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18" TextColor="{StaticResource WarningDark}" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding GracePeriodExpiringBannerText}" FontSize="18" TextColor="{StaticResource WarningDark}" VerticalOptions="Center" HorizontalOptions="Fill"/>
                    <Label Grid.Column="2" Text="{OnPlatform WinUI='&#xE76C;', Android='&#x27A1;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource WarningDark}" VerticalOptions="Center" Opacity="0.6"/>
                </Grid>
            </Border>

            <!-- 普惠高龄待办提醒横幅（点击跳转到普惠高龄登记列表页） -->
            <Border IsVisible="{Binding ShowElderlyReminder}"
                    BackgroundColor="{StaticResource WarningSoft}"
                    StrokeShape="RoundRectangle 0"
                    Padding="16,10"
                    Margin="10,5,10,5">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToElderlyPendingCommand}"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="{OnPlatform WinUI='&#xE823;', Android='&#x1F4C5;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18" TextColor="{StaticResource WarningDark}" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding ElderlyReminderText}" FontSize="18" TextColor="{StaticResource WarningDark}" VerticalOptions="Center" HorizontalOptions="Fill"/>
                    <Label Grid.Column="2" Text="{OnPlatform WinUI='&#xE76C;', Android='&#x27A1;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource WarningDark}" VerticalOptions="Center" Opacity="0.6"/>
                </Grid>
            </Border>

            <!-- 大学生毕业提醒横幅（点击跳转到大学生管理页面） -->
            <Border IsVisible="{Binding ShowCollegeStudentReminder}"
                    BackgroundColor="{StaticResource WarningSoft}"
                    StrokeShape="RoundRectangle 0"
                    Padding="16,10"
                    Margin="10,5,10,5">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToCollegeStudentCommand}"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="{OnPlatform WinUI='&#xE774;', Android='&#x1F393;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18" TextColor="{StaticResource WarningDark}" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding CollegeStudentReminderText}" FontSize="18" TextColor="{StaticResource WarningDark}" VerticalOptions="Center" HorizontalOptions="Fill"/>
                    <Label Grid.Column="2" Text="{OnPlatform WinUI='&#xE76C;', Android='&#x27A1;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource WarningDark}" VerticalOptions="Center" Opacity="0.6"/>
                </Grid>
            </Border>

            <!-- 死亡申报联动提醒横幅（点击跳转到死亡情况说明页面） -->
            <Border IsVisible="{Binding ShowDeathLinkageReminder}"
                    BackgroundColor="{StaticResource WarningSoft}"
                    StrokeShape="RoundRectangle 0"
                    Padding="16,10"
                    Margin="10,5,10,5">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NavigateToDeathStatementCommand}"/>
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Label Grid.Column="0" Text="{OnPlatform WinUI='&#xE7BA;', Android='&#x26B0;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18" TextColor="{StaticResource WarningDark}" VerticalOptions="Center"/>
                    <Label Grid.Column="1" Text="{Binding DeathLinkageBannerText}" FontSize="18" TextColor="{StaticResource WarningDark}" VerticalOptions="Center" HorizontalOptions="Fill"/>
                    <Label Grid.Column="2" Text="{OnPlatform WinUI='&#xE76C;', Android='&#x27A1;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource WarningDark}" VerticalOptions="Center" Opacity="0.6"/>
                </Grid>
            </Border>

        </VerticalStackLayout>

        <!-- 主内容区 -->
        <Grid Grid.Row="2" ColumnDefinitions="Auto,*">

            <!-- 左侧导航栏（分组 + 全部真实跳转；唯一就地项为首页） -->
            <Border Grid.Column="0" Style="{StaticResource Sidebar}" WidthRequest="200">
                <ScrollView>
                    <VerticalStackLayout Spacing="2" Padding="8,12">

                        <!-- ── 工作台 ── -->
                        <Label Text="工 作 台" Style="{StaticResource NavGroupHeader}"/>

                        <Grid x:Name="NavHome" Style="{StaticResource SidebarNavItem}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Home"/>
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center" Margin="16,0">
                                <Label Text="{OnPlatform WinUI='&#xE80F;', Android='&#x2696;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="White"/>
                                <Label Text="首页" FontSize="16" TextColor="White"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- ── 救助业务 ── -->
                        <Label Text="{x:Static constants:ModuleCategoryConstants.BUSINESS}" Style="{StaticResource NavGroupHeader}"/>

                        <Grid Style="{StaticResource SidebarNavItem}" IsVisible="{Binding CanAccessSocialAssistance}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="SocialAssistance"/>
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center" Margin="16,0">
                                <Label Text="{OnPlatform WinUI='&#xE765;', Android='&#x1F3E0;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource SidebarItemUnselected}"/>
                                <Label Text="低收入人口救助帮扶" FontSize="15" TextColor="{StaticResource SidebarItemUnselected}"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <Grid Style="{StaticResource SidebarNavItem}" IsVisible="{Binding CanAccessElderlyBenefit}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Elderly"/>
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center" Margin="16,0">
                                <Label Text="{OnPlatform WinUI='&#xE7B8;', Android='&#x1F474;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource SidebarItemUnselected}"/>
                                <Label Text="高龄津贴发放" FontSize="15" TextColor="{StaticResource SidebarItemUnselected}"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <Grid Style="{StaticResource SidebarNavItem}" IsVisible="{Binding CanAccessAssetVerification}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="AssetVerification"/>
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center" Margin="16,0">
                                <Label Text="{OnPlatform WinUI='&#xE721;', Android='&#x1F50D;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource SidebarItemUnselected}"/>
                                <Label Text="家庭经济状况核对" FontSize="15" TextColor="{StaticResource SidebarItemUnselected}"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <Grid Style="{StaticResource SidebarNavItem}" IsVisible="{Binding CanAccessArchiveQuery}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Archive"/>
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center" Margin="16,0">
                                <Label Text="{OnPlatform WinUI='&#xE8F1;', Android='&#x1F5C2;&#xFE0F;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource SidebarItemUnselected}"/>
                                <Label Text="救助档案管理" FontSize="15" TextColor="{StaticResource SidebarItemUnselected}"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <Grid Style="{StaticResource SidebarNavItem}" IsVisible="{Binding CanAccessRecovery}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Recovery"/>
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center" Margin="16,0">
                                <Label Text="{OnPlatform WinUI='&#xE8D1;', Android='&#x1F4B0;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource SidebarItemUnselected}"/>
                                <Label Text="后补追缴" FontSize="15" TextColor="{StaticResource SidebarItemUnselected}"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- ── 管理工具 ── -->
                        <Label Text="{x:Static constants:ModuleCategoryConstants.TOOLS}" Style="{StaticResource NavGroupHeader}"/>

                        <Grid Style="{StaticResource SidebarNavItem}" IsVisible="{Binding CanAccessDatabaseManagement}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Database"/>
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center" Margin="16,0">
                                <Label Text="{OnPlatform WinUI='&#xE88E;', Android='&#x1F4CA;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource SidebarItemUnselected}"/>
                                <Label Text="数据中心" FontSize="15" TextColor="{StaticResource SidebarItemUnselected}"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <Grid Style="{StaticResource SidebarNavItem}" IsVisible="{Binding CanAccessUserManagement}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="User"/>
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center" Margin="16,0">
                                <Label Text="{OnPlatform WinUI='&#xE77B;', Android='&#x1F464;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource SidebarItemUnselected}"/>
                                <Label Text="用户与权限管理" FontSize="15" TextColor="{StaticResource SidebarItemUnselected}"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <Grid Style="{StaticResource SidebarNavItem}" IsVisible="{Binding CanAccessOrganizationManagement}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Organization"/>
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center" Margin="16,0">
                                <Label Text="{OnPlatform WinUI='&#xE73E;', Android='&#x2713;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource SidebarItemUnselected}"/>
                                <Label Text="经办机构管理" FontSize="15" TextColor="{StaticResource SidebarItemUnselected}"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <Grid Style="{StaticResource SidebarNavItem}" IsVisible="{Binding CanAccessTemplateManagement}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Templates"/>
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center" Margin="16,0">
                                <Label Text="{OnPlatform WinUI='&#xE8B7;', Android='&#x1F4C1;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource SidebarItemUnselected}"/>
                                <Label Text="文书模板管理" FontSize="15" TextColor="{StaticResource SidebarItemUnselected}"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- 值班管理 -->
                        <Grid Style="{StaticResource SidebarNavItem}" IsVisible="{Binding CanAccessDuty}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Duty"/>
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center" Margin="16,0">
                                <Label Text="{OnPlatform WinUI='&#xE8C0;', Android='&#x1F4C5;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource SidebarItemUnselected}"/>
                                <Label Text="值班管理" FontSize="15" TextColor="{StaticResource SidebarItemUnselected}"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- ── 娱乐天地 ── -->
                        <Label Text="{x:Static constants:ModuleCategoryConstants.ENTERTAINMENT}" Style="{StaticResource NavGroupHeader}"/>

                        <!-- 彩票助手 -->
                        <Grid Style="{StaticResource SidebarNavItem}" IsVisible="{Binding CanAccessLottery}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCommand}" CommandParameter="Lottery"/>
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center" Margin="16,0">
                                <Label Text="{OnPlatform WinUI='&#xE734;', Android='&#x1F3B2;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource SidebarItemUnselected}"/>
                                <Label Text="彩票助手" FontSize="15" TextColor="{StaticResource SidebarItemUnselected}"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <!-- 分隔线 -->
                        <BoxView HeightRequest="1" BackgroundColor="{StaticResource SidebarItemHover}" Margin="8,12"/>

                        <!-- 退出登录 -->
                        <Grid Style="{StaticResource SidebarNavItem}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding LogoutCommand}"/>
                            </Grid.GestureRecognizers>
                            <HorizontalStackLayout Spacing="12" VerticalOptions="Center" Margin="16,0">
                                <Label Text="{OnPlatform WinUI='&#xE7E8;', Android='&#x1F6AA;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="16" TextColor="{StaticResource Error}"/>
                                <Label Text="退出登录" FontSize="15" TextColor="{StaticResource Error}"/>
                            </HorizontalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- 右侧工作区：仅仪表盘（统计概览 + 一域一卡直达入口）；
                 列 0 = 内容滚动区，列 1 = 看板娘立绘栏（Auto：隐藏时列宽归零，不影响卡片列宽） -->
            <Grid Grid.Column="1" BackgroundColor="{StaticResource Gray50}" ColumnDefinitions="*,Auto">

                <ScrollView Grid.Column="0">
                    <VerticalStackLayout Padding="20" Spacing="20">

                        <!-- 统计概览区（宋体小标题 + 朱砂短横，code.html .stat .k 风格） -->
                        <HorizontalStackLayout Spacing="10" Margin="0,0,0,8">
                            <BoxView WidthRequest="14" HeightRequest="2" Color="{StaticResource Seal}" VerticalOptions="Center"/>
                            <Label Text="数据概览" FontSize="19" FontAttributes="Bold"
                                   FontFamily="{OnPlatform WinUI='Noto Serif SC', Android='notoserifregular', Default='Noto Serif SC'}"
                                   TextColor="{StaticResource TextPrimary}"/>
                        </HorizontalStackLayout>

                        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="16">

                            <!-- 本月总新增 -->
                            <Border Grid.Column="0" Style="{StaticResource StatCard}" Background="{StaticResource StatCardBlueGradient}">
                                <VerticalStackLayout Spacing="8">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{OnPlatform WinUI='&#xE73E;', Android='&#x2713;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18" TextColor="White"/>
                                        <Label Text="本月总新增" FontSize="18" TextColor="White" Opacity="0.9"/>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding MonthlyNewAdditions}" FontSize="38" FontAttributes="Bold" TextColor="White"/>
                                    <Label Text="统计周期内 新入保（户）" FontSize="16" TextColor="White" Opacity="0.8"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- 本月总退出 -->
                            <Border Grid.Column="1" Style="{StaticResource StatCard}" Background="{StaticResource StatCardGreenGradient}">
                                <VerticalStackLayout Spacing="8">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{OnPlatform WinUI='&#xE7E8;', Android='&#x1F6AA;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18" TextColor="White"/>
                                        <Label Text="本月总退出" FontSize="18" TextColor="White" Opacity="0.9"/>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding MonthlyExits}" FontSize="38" FontAttributes="Bold" TextColor="White"/>
                                    <Label Text="统计周期内 停保退出（户）" FontSize="16" TextColor="White" Opacity="0.8"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- 新申请经济核对 -->
                            <Border Grid.Column="2" Style="{StaticResource StatCard}" Background="{StaticResource StatCardOrangeGradient}">
                                <VerticalStackLayout Spacing="8">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{OnPlatform WinUI='&#xE721;', Android='&#x1F50D;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18" TextColor="White"/>
                                        <Label Text="新申请经济核对" FontSize="18" TextColor="White" Opacity="0.9"/>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding NewAssetChecks}" FontSize="38" FontAttributes="Bold" TextColor="White"/>
                                    <Label Text="统计周期内 已申未出报告（件）" FontSize="16" TextColor="White" Opacity="0.8"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- 本月新增高龄老人 -->
                            <Border Grid.Column="3" Style="{StaticResource StatCard}" Background="{StaticResource StatCardPurpleGradient}">
                                <VerticalStackLayout Spacing="8">
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{OnPlatform WinUI='&#xE7B8;', Android='&#x1F474;'}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="18" TextColor="White"/>
                                        <Label Text="本月新增高龄老人" FontSize="18" TextColor="White" Opacity="0.9"/>
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding MonthlyNewElderly}" FontSize="38" FontAttributes="Bold" TextColor="White"/>
                                    <Label Text="自然月受理登记（人）" FontSize="16" TextColor="White" Opacity="0.8"/>
                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                        <!-- 模块直达区（一域一卡，细分功能在各模块首页内；按内容分类：
                             救助业务/管理工具/娱乐天地/快捷链接，分组与卡片数据驱动，
                             卡片目录见 MainViewModel.RebuildDashboard） -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding DashboardGroups}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="ModuleGroup">
                                    <VerticalStackLayout Spacing="0">

                                        <!-- 分组标题（宋体小标题 + 朱砂短横，与数据概览同语言） -->
                                        <HorizontalStackLayout Spacing="10" Margin="0,12,0,8">
                                            <BoxView WidthRequest="14" HeightRequest="2" Color="{StaticResource Seal}" VerticalOptions="Center"/>
                                            <Label Text="{Binding Title}" FontSize="19" FontAttributes="Bold"
                                                   FontFamily="{OnPlatform WinUI='Noto Serif SC', Android='notoserifregular', Default='Noto Serif SC'}"
                                                   TextColor="{StaticResource TextPrimary}"/>
                                        </HorizontalStackLayout>

                                        <!-- 组内卡片（3 列流动排位，Row/Col 由 MainViewModel.RebuildDashboard 写入） -->
                                        <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="16"
                                              BindableLayout.ItemsSource="{Binding Cards}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="ModuleCardItem">
                                                    <Border Grid.Row="{Binding Row}" Grid.Column="{Binding Col}" Style="{StaticResource ModuleCard}">
                                                        <Border.Shadow>
                                                            <Shadow Brush="#000000" Offset="0,2" Radius="8" Opacity="0.08"/>
                                                        </Border.Shadow>
                                                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                                            <HorizontalStackLayout Spacing="12">
                                                                <Border WidthRequest="44" HeightRequest="44" BackgroundColor="{Binding IconBgColor}" StrokeShape="RoundRectangle 12">
                                                                    <Label Text="{Binding IconGlyph}" FontFamily="{OnPlatform WinUI='Segoe Fluent Icons', Android=''}" FontSize="24" TextColor="{Binding IconColor}" HorizontalOptions="Center" VerticalOptions="Center"/>
                                                                </Border>
                                                                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                                                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>
                                                                    <Label Text="{Binding Subtitle}" FontSize="14" TextColor="{StaticResource TextTertiary}"/>
                                                                </VerticalStackLayout>
                                                            </HorizontalStackLayout>
                                                            <Label Grid.Row="1" Text="{Binding Description}" FontSize="14" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap"/>
                                                            <Button Grid.Row="2" Text="{Binding ButtonText}" Style="{StaticResource FunctionButtonPrimary}" Command="{Binding Command}" CommandParameter="{Binding CommandParameter}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </Grid>

                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- 看板娘立绘栏：固定在工作区右下角，不随内容滚动、不遮挡业务卡片。
                     立绘是浅色调，直接贴浅灰工作区会糊，故垫一张与仪表盘卡片同语言的
                     圆角白卡（浅蓝渐变 + 轻阴影）衬托；Android（数据录入端）整栏隐藏。 -->
                <Grid Grid.Column="1"
                      WidthRequest="200"
                      IsVisible="{OnPlatform WinUI=true, Android=false}">
                    <Border Margin="0,0,16,20"
                            Padding="10,12,10,10"
                            VerticalOptions="End"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="White" Offset="0"/>
                                <GradientStop Color="#E7F0FE" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="#000000" Offset="0,4" Radius="12" Opacity="0.10"/>
                        </Border.Shadow>
                        <Image Source="newcosmos_character.png"
                               Aspect="AspectFit"
                               InputTransparent="True"/>
                    </Border>
                </Grid>

            </Grid>

        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="3" Style="{StaticResource StatusBar}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
                <HorizontalStackLayout Grid.Column="0" Spacing="16">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="数据库:" FontSize="16" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                        <Label Text="{Binding DatabaseStatusMessage}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <BoxView WidthRequest="1" HeightRequest="12" BackgroundColor="{StaticResource Gray300}"/>
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="版本:" FontSize="16" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                        <Label Text="{Binding AppVersion}" FontSize="16" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                        <Button Text="检查更新" Style="{StaticResource ButtonOutline}" FontSize="14"
                                HeightRequest="26" Padding="10,0" MinimumWidthRequest="0"
                                VerticalOptions="Center" Margin="6,0,0,0"
                                Command="{Binding CheckForUpdatesCommand}"/>
                        <Button Text="更新日志" Style="{StaticResource ButtonOutline}" FontSize="14"
                                HeightRequest="26" Padding="10,0" MinimumWidthRequest="0"
                                VerticalOptions="Center" Margin="6,0,0,0"
                                Command="{Binding NavigateCommand}" CommandParameter="UpdateLog"/>
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
                <Label Grid.Column="2" Text="© 2026 帝皇权杖δ-me13 社会救助管理系统" FontSize="16" TextColor="{StaticResource TextTertiary}" HorizontalOptions="End"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
