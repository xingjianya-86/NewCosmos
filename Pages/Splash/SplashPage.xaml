<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NewCosmos.Pages.Splash.SplashPage"
             Title="启动中"
             NavigationPage.HasNavigationBar="False"
             SafeAreaEdges="None"
             BackgroundColor="Black">

    <!-- 启动动画：宿主是 AnimationWebViewView（code-behind 注入，构造需要 DI 依赖，
         无法在 XAML 实例化）；虚拟主机映射、自动播放环境、桥接协议、boot 看门狗
         都在该控件内，与序列登录页（LoginPage 覆盖层）共用同一套实现。
         动画结束/跳过经 newcosmos-splash://done → BridgeReceived → 放行 ISplashGate，
         App 再切到登录页或主界面。SKIP 按钮与 Esc 由动画运行时自己处理。 -->
    <Grid x:Name="HostPanel" BackgroundColor="Black" />
</ContentPage>
