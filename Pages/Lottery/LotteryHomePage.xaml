<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:NewCosmos.Components"
             xmlns:local="clr-namespace:NewCosmos.ViewModels.Lottery"
             x:Class="NewCosmos.Pages.Lottery.LotteryHomePage"
             x:DataType="local:LotteryHomeViewModel"
             Title="彩票助手"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <Grid RowDefinitions="*">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,20">

                <!-- 域色渐变头部横幅 -->
                <!-- 统一页头（纸墨档案风报头 · Phase 6，统计胶囊迁入 Stats 插槽并转浅色变体） -->
                <components:PageHeaderView
                                           Glyph="{OnPlatform WinUI='&#xE834;', Android='&#x1F3C6;'}"
                                           Title="彩票助手"
                                           Subtitle="双色球 · 大乐透 · 历史数据 · 智能预测"
                                           BackCommand="{Binding GoBackCommand}"
                                           BackText="返回工作台">
                    <components:PageHeaderView.Stats>
<Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <components:StatCapsule IsLight="True" Grid.Column="0" Value="{Binding LatestDrawNumber}" Caption="最新开奖期号"/>
                            <components:StatCapsule IsLight="True" Grid.Column="1" Value="{Binding TotalDrawCount, StringFormat='{0}'}" Caption="历史数据（期）"/>
                        </Grid>
                    </components:PageHeaderView.Stats>
                </components:PageHeaderView>

                <!-- 最新开奖信息卡片区 -->
                <VerticalStackLayout Margin="20,20,20,0" Spacing="14">
                    <Label Text="{Binding LatestDrawTitle}" Style="{StaticResource SectionTitleLabel}" Margin="4,4,0,0"/>

                    <Border Style="{StaticResource CardBorder}" Padding="16">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                            <Label Text="期号" Grid.Row="0" Grid.Column="0" TextColor="{StaticResource TextTertiary}" WidthRequest="60"/>
                            <Label Text="{Binding LatestDrawNumber}" Grid.Row="0" Grid.Column="1" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}"/>

                            <Label Text="日期" Grid.Row="1" Grid.Column="0" TextColor="{StaticResource TextTertiary}"/>
                            <Label Text="{Binding LatestDrawDate}" Grid.Row="1" Grid.Column="1" TextColor="{StaticResource TextPrimary}"/>

                            <Label Text="红球" Grid.Row="2" Grid.Column="0" TextColor="{StaticResource TextTertiary}"/>
                            <Label Text="{Binding LatestRedNumbers}" Grid.Row="2" Grid.Column="1" TextColor="#E53935" FontAttributes="Bold"/>

                            <Label Text="蓝球" Grid.Row="3" Grid.Column="0" TextColor="{StaticResource TextTertiary}"/>
                            <Label Text="{Binding LatestBlueNumbers}" Grid.Row="3" Grid.Column="1" TextColor="#1E88E5" FontAttributes="Bold"/>
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- 功能入口卡片区 -->
                <VerticalStackLayout Margin="20,20,20,0" Spacing="14">
                    <Label Text="功能入口" Style="{StaticResource SectionTitleLabel}" Margin="4,4,0,0"/>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="14">

                        <!-- 同步历史数据 -->
                        <components:FeatureCard Grid.Row="0" Grid.Column="0" Glyph="{OnPlatform WinUI='&#xE8B7;', Android='&#x1F4C1;'}"
                                                IconBackgroundColor="#EBF5FF" IconColor="{StaticResource ModuleSocialAssistance}"
                                                Title="同步历史数据" Description="从官方接口下载双色球/大乐透开奖数据"
                                                Command="{Binding SyncHistoryDataCommand}"/>

                        <!-- 快速机选 -->
                        <components:FeatureCard Grid.Row="0" Grid.Column="1" Glyph="{OnPlatform WinUI='&#xE834;', Android='&#x1F3C6;'}"
                                                IconBackgroundColor="#ECFDF5" IconColor="{StaticResource ModuleArchive}"
                                                Title="快速机选" Description="随机生成一组推荐号码"
                                                Command="{Binding QuickPickCommand}"/>

                        <!-- 智能预测 -->
                        <components:FeatureCard Grid.Row="1" Grid.Column="0" Glyph="{OnPlatform WinUI='&#xE9D9;', Android='&#x1F4CA;'}"
                                                IconBackgroundColor="#F5F3FF" IconColor="{StaticResource ModuleElderly}"
                                                Title="智能预测" Description="机器学习(LSTM) 预测（双色球/大乐透）"
                                                Command="{Binding OpenPredictionCommand}"/>

                        <!-- 历史记录 -->
                        <components:FeatureCard Grid.Row="1" Grid.Column="1" Glyph="{OnPlatform WinUI='&#xE81C;', Android='&#x26BD;'}"
                                                IconBackgroundColor="#FFF7ED" IconColor="#EA580C"
                                                Title="历史记录" Description="查看往期开奖结果与统计"
                                                Command="{Binding OpenHistoryCommand}"/>

                        <!-- 训练模型 -->
                        <components:FeatureCard Grid.Row="2" Grid.Column="0" Glyph="{OnPlatform WinUI='&#xE9D5;', Android='&#x26A0;&#xFE0F;'}"
                                                IconBackgroundColor="#FEF3C7" IconColor="#D97706"
                                                Title="训练预测模型" Description="训练 LSTM 模型（全量历史，约10-40分钟）"
                                                Command="{Binding TrainModelCommand}"/>

                        <!-- 中奖结果 -->
                        <components:FeatureCard Grid.Row="2" Grid.Column="1" Glyph="{OnPlatform WinUI='&#xE8D4;', Android='&#x2B50;'}"
                                                IconBackgroundColor="#FCE7F3" IconColor="#DB2777"
                                                Title="中奖结果" Description="查看购彩命中、奖级与奖金明细"
                                                Command="{Binding OpenResultCommand}"/>

                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 加载遮罩 -->
        <components:LoadingOverlay Grid.RowSpan="1" IsLoading="{Binding IsBusy}" LoadingText="{Binding LoadingMessage}"/>

    </Grid>
</ContentPage>
