<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:NewCosmos.Components"
             xmlns:vm="clr-namespace:NewCosmos.ViewModels.DutyManagement"
             xmlns:ent="clr-namespace:NewCosmos.Models.Entities"
             x:Class="NewCosmos.Pages.DutyManagement.DutyAdjustPage"
             x:DataType="vm:DutyAdjustViewModel"
             Title="班务调整管理"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Background}">

    <ContentPage.Resources>
        <converters:StringToColorConverter x:Key="DutyStatusColor"/>
    </ContentPage.Resources>

    <Grid RowDefinitions="*">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,20">

                <!-- 头部横幅 -->
                <Border Style="{StaticResource ModuleHeroHeader}" Background="{StaticResource StatCardBlueGradient}">
                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="Auto,*">
                            <HorizontalStackLayout Spacing="6">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoBackCommand}"/>
                                </HorizontalStackLayout.GestureRecognizers>
                                <Label Text="&#xE72B;" FontFamily="Segoe Fluent Icons" FontSize="14" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                                <Label Text="返回值班表" FontSize="13" TextColor="#E6FFFFFF" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Grid>

                        <HorizontalStackLayout Spacing="14">
                            <Border WidthRequest="52" HeightRequest="52" BackgroundColor="#33FFFFFF" StrokeShape="RoundRectangle 14">
                                <Label Text="&#xE77B;" FontFamily="Segoe Fluent Icons" FontSize="28" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                                <Label Text="班务调整管理" Style="{StaticResource ModuleHeroTitle}"/>
                                <Label Text="请假 · 串班（相互对调）· 代班（单向顶班）· 撤销后值班表自动重排" Style="{StaticResource ModuleHeroSubtitle}"/>
                            </VerticalStackLayout>
                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- 工具栏：显示开关 + 三个新增入口 -->
                <Grid Margin="20,16,20,0" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
                    <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                        <CheckBox IsChecked="{Binding ShowCancelled}" VerticalOptions="Center"/>
                        <Label Text="显示已撤销记录" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Button Grid.Column="2" Text="+ 请假" FontSize="13" HeightRequest="34" CornerRadius="8" Padding="14,4"
                            Style="{StaticResource ButtonOutline}" Opacity="{Binding ManageOpacity}"
                            Command="{Binding StartAddLeaveCommand}"/>
                    <Button Grid.Column="3" Text="+ 串班" FontSize="13" HeightRequest="34" CornerRadius="8" Padding="14,4"
                            Style="{StaticResource ButtonOutline}" Opacity="{Binding ManageOpacity}"
                            Command="{Binding StartAddSwapCommand}"/>
                    <Button Grid.Column="4" Text="+ 代班" FontSize="13" HeightRequest="34" CornerRadius="8" Padding="14,4"
                            Style="{StaticResource ButtonPrimary}" Opacity="{Binding ManageOpacity}"
                            Command="{Binding StartAddSubstituteCommand}"/>
                </Grid>

                <!-- ── 请假管理 ── -->
                <Label Margin="20,14,20,0" Text="请假管理" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}"/>
                <Label Margin="20,4,20,0" Text="请假区间内生成值班表时顺延跳过并消耗轮次；撤销请假后受影响月份自动重排" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                <CollectionView ItemsSource="{Binding LeaveRecords}" Margin="20,8,20,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="ent:DutyLeaveView">
                            <Border Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="120,180,*,Auto,Auto" ColumnSpacing="10">
                                    <Label Grid.Column="0" Text="{Binding MemberName}" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                    <Label Grid.Column="1" Text="{Binding RangeDisplay}" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                    <Label Grid.Column="2" Text="{Binding Reason}" FontSize="12" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" IsVisible="{Binding HasReason}"/>
                                    <Border Grid.Column="3" StrokeShape="RoundRectangle 8" Padding="6,1" BackgroundColor="#E8F5E9" VerticalOptions="Center">
                                        <Label Text="{Binding Days, StringFormat='{0} 天'}" FontSize="10" TextColor="#2E7D32"/>
                                    </Border>
                                    <Button Grid.Column="4" Text="撤销" FontSize="12" Style="{StaticResource ButtonSmall}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DutyAdjustViewModel}}, Path=DeleteLeaveCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="暂无请假记录" FontSize="12" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Padding="10"/>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- ── 串班管理 ── -->
                <Label Margin="20,14,20,0" Text="串班管理（单向转让）" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}"/>
                <Label Margin="20,4,20,0" Text="串班=转出者让出某日班次由受让人顶上（限同组、限今天及以后）；撤销后所在月自动重排恢复" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                <CollectionView ItemsSource="{Binding SwapRecords}" Margin="20,8,20,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="ent:DutyShiftChangeView">
                            <Border Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="70,110,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Padding="6,1" BackgroundColor="#E0F2FE" VerticalOptions="Center">
                                        <Label Text="{Binding ChangeTypeName}" FontSize="11" TextColor="#0369A1"/>
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding DutyDateDisplay}" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                    <Label Grid.Column="2" Text="{Binding ChangeDirection}" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                    <Label Grid.Column="3" Text="{Binding Reason}" FontSize="12" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" IsVisible="{Binding HasReason}"/>
                                    <Border Grid.Column="4" StrokeShape="RoundRectangle 8" Padding="6,1" VerticalOptions="Center"
                                            BackgroundColor="{Binding StatusColorHex, Converter={StaticResource DutyStatusColor}}">
                                        <Label Text="{Binding StatusText}" FontSize="10" TextColor="White"/>
                                    </Border>
                                    <Button Grid.Column="5" Text="改期" FontSize="12" Style="{StaticResource ButtonSmall}" IsVisible="{Binding CanCancel}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DutyAdjustViewModel}}, Path=StartRescheduleCommand}"
                                            CommandParameter="{Binding .}"/>
                                    <Button Grid.Column="6" Text="撤销" FontSize="12" Style="{StaticResource ButtonSmall}" IsVisible="{Binding CanCancel}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DutyAdjustViewModel}}, Path=CancelSwapCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="暂无串班记录" FontSize="12" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Padding="10"/>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- ── 代班管理 ── -->
                <Label Margin="20,14,20,0" Text="代班管理" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}"/>
                <Label Margin="20,4,20,0" Text="代班=某人代替另一人上班一次（限同组、限今天及以后）；撤销后所在月自动重排恢复" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                <CollectionView ItemsSource="{Binding SubstituteRecords}" Margin="20,8,20,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="ent:DutyShiftChangeView">
                            <Border Style="{StaticResource CardBorder}" Padding="14,10" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="70,110,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                    <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Padding="6,1" BackgroundColor="#FEF3C7" VerticalOptions="Center">
                                        <Label Text="{Binding ChangeTypeName}" FontSize="11" TextColor="#B45309"/>
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding DutyDateDisplay}" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"/>
                                    <Label Grid.Column="2" Text="{Binding ChangeDirection}" FontSize="13" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                                    <Label Grid.Column="3" Text="{Binding Reason}" FontSize="12" TextColor="{StaticResource TextTertiary}" VerticalOptions="Center" IsVisible="{Binding HasReason}"/>
                                    <Border Grid.Column="4" StrokeShape="RoundRectangle 8" Padding="6,1" VerticalOptions="Center"
                                            BackgroundColor="{Binding StatusColorHex, Converter={StaticResource DutyStatusColor}}">
                                        <Label Text="{Binding StatusText}" FontSize="10" TextColor="White"/>
                                    </Border>
                                    <Button Grid.Column="5" Text="改期" FontSize="12" Style="{StaticResource ButtonSmall}" IsVisible="{Binding CanCancel}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DutyAdjustViewModel}}, Path=StartRescheduleCommand}"
                                            CommandParameter="{Binding .}"/>
                                    <Button Grid.Column="6" Text="撤销" FontSize="12" Style="{StaticResource ButtonSmall}" IsVisible="{Binding CanCancel}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DutyAdjustViewModel}}, Path=CancelSubstituteCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="暂无代班记录" FontSize="12" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Padding="10"/>
                    </CollectionView.EmptyView>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 新增请假表单面板 -->
        <Grid Grid.Row="0" IsVisible="{Binding IsLeaveFormVisible}" BackgroundColor="#66000000">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <Border Style="{StaticResource CardBorder}" Padding="20" WidthRequest="500">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding LeaveFormTitle}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}" Command="{Binding CancelLeaveFormCommand}" Padding="4,0"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="请假人员 *" FontSize="13" VerticalOptions="Center"/>
                            <Picker Grid.Column="1" ItemsSource="{Binding MemberOptions}"
                                    SelectedItem="{Binding SelectedLeaveMember}"
                                    ItemDisplayBinding="{Binding Name}"
                                    HeightRequest="36"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="6">
                            <Label Grid.Column="0" Text="开始" FontSize="13" VerticalOptions="Center"/>
                            <DatePicker Grid.Column="1" Date="{Binding LeaveStartDate}" WidthRequest="140" HeightRequest="36"/>
                            <Label Grid.Column="2" Text="结束" FontSize="13" VerticalOptions="Center" Margin="10,0,0,0"/>
                            <DatePicker Grid.Column="3" Date="{Binding LeaveEndDate}" WidthRequest="140" HeightRequest="36"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="事由" FontSize="13" VerticalOptions="Center"/>
                            <Entry Grid.Column="1" Text="{Binding LeaveReason}" Placeholder="选填；补登记必填" HeightRequest="36"/>
                        </Grid>

                        <Label Text="{Binding BackfillHintText}" IsVisible="{Binding IsBackfillHintVisible}"
                               FontSize="12" TextColor="#B45309" LineBreakMode="WordWrap"/>

                        <Label Text="请假登记/撤销会删除受影响月份的排班数据（到值班表页重新生成后生效）；支持补登记过去日期且必须填写事由" FontSize="11" TextColor="{StaticResource TextTertiary}"/>

                        <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                            <Button Text="登记" Style="{StaticResource ButtonPrimary}" HeightRequest="34" Padding="18,4" Opacity="{Binding ManageOpacity}" Command="{Binding SaveLeaveCommand}"/>
                            <Button Text="关闭" Style="{StaticResource ButtonOutline}" HeightRequest="34" Padding="18,4" Command="{Binding CancelLeaveFormCommand}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>

        <!-- 新增串班（相互对调）表单面板 -->
        <Grid Grid.Row="0" IsVisible="{Binding IsSwapFormVisible}" BackgroundColor="#66000000">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <Border Style="{StaticResource CardBorder}" Padding="20" WidthRequest="540">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding SwapFormTitle}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}" Command="{Binding CancelSwapFormCommand}" Padding="4,0"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="甲方 *" FontSize="13" VerticalOptions="Center"/>
                            <Picker Grid.Column="1" ItemsSource="{Binding MemberOptions}"
                                    SelectedItem="{Binding SelectedSwapFromMember}"
                                    ItemDisplayBinding="{Binding Name}"
                                    HeightRequest="36"/>
                        </Grid>

                        <Label Text="甲方的班次（选择要换出的 X 日）" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                        <CollectionView ItemsSource="{Binding SwapFutureSchedules}" HeightRequest="130" SelectionMode="Single"
                                        SelectedItem="{Binding SelectedSwapSchedule}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="ent:DutyFutureSchedule">
                                    <Border StrokeShape="RoundRectangle 8" Padding="12,8" Margin="0,0,0,6" BackgroundColor="#F8FAFC">
                                        <Label Text="{Binding Display}" FontSize="13" TextColor="{StaticResource TextPrimary}"/>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="请先选择甲方，或该成员今天及以后没有班次" FontSize="12" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Padding="10"/>
                            </CollectionView.EmptyView>
                        </CollectionView>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="乙方 *" FontSize="13" VerticalOptions="Center"/>
                            <Picker Grid.Column="1" ItemsSource="{Binding SwapTargetOptions}"
                                    SelectedItem="{Binding SelectedSwapToMember}"
                                    ItemDisplayBinding="{Binding Name}"
                                    HeightRequest="36"/>
                        </Grid>

                        <Label Text="乙方的班次（选择要换出的 Y 日，与甲方班次同组）" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                        <CollectionView ItemsSource="{Binding SwapToFutureSchedules}" HeightRequest="130" SelectionMode="Single"
                                        SelectedItem="{Binding SelectedSwapToSchedule}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="ent:DutyFutureSchedule">
                                    <Border StrokeShape="RoundRectangle 8" Padding="12,8" Margin="0,0,0,6" BackgroundColor="#F8FAFC">
                                        <Label Text="{Binding Display}" FontSize="13" TextColor="{StaticResource TextPrimary}"/>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="请先选择乙方，或该成员今天及以后没有班次" FontSize="12" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Padding="10"/>
                            </CollectionView.EmptyView>
                        </CollectionView>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="事由" FontSize="13" VerticalOptions="Center"/>
                            <Entry Grid.Column="1" Text="{Binding SwapReason}" Placeholder="选填" HeightRequest="36"/>
                        </Grid>

                        <Label Text="串班为相互对调：X 日乙方上、Y 日甲方上（同组、两日不可相同、对调后双方无双班）；值班表即时刷新，撤销后自动恢复" FontSize="11" TextColor="{StaticResource TextTertiary}"/>

                        <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                            <Button Text="保存" Style="{StaticResource ButtonPrimary}" HeightRequest="34" Padding="18,4" Opacity="{Binding ManageOpacity}" Command="{Binding SaveShiftSwapCommand}"/>
                            <Button Text="关闭" Style="{StaticResource ButtonOutline}" HeightRequest="34" Padding="18,4" Command="{Binding CancelSwapFormCommand}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>

        <!-- 新增代班表单面板 -->
        <Grid Grid.Row="0" IsVisible="{Binding IsSubstituteFormVisible}" BackgroundColor="#66000000">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <Border Style="{StaticResource CardBorder}" Padding="20" WidthRequest="520">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding SubstituteFormTitle}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}" Command="{Binding CancelSubstituteFormCommand}" Padding="4,0"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="被代班人 *" FontSize="13" VerticalOptions="Center"/>
                            <Picker Grid.Column="1" ItemsSource="{Binding MemberOptions}"
                                    SelectedItem="{Binding SelectedSubstituteFromMember}"
                                    ItemDisplayBinding="{Binding Name}"
                                    HeightRequest="36"/>
                        </Grid>

                        <Label Text="选择要代班的班次（限今天及以后）" FontSize="12" TextColor="{StaticResource TextTertiary}"/>
                        <CollectionView ItemsSource="{Binding SubstituteFutureSchedules}" HeightRequest="150" SelectionMode="Single"
                                        SelectedItem="{Binding SelectedSubstituteSchedule}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="ent:DutyFutureSchedule">
                                    <Border StrokeShape="RoundRectangle 8" Padding="12,8" Margin="0,0,0,6" BackgroundColor="#F8FAFC">
                                        <Label Text="{Binding Display}" FontSize="13" TextColor="{StaticResource TextPrimary}"/>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Label Text="请先选择被代班人，或该成员今天及以后没有班次" FontSize="12" TextColor="{StaticResource TextTertiary}" HorizontalOptions="Center" Padding="10"/>
                            </CollectionView.EmptyView>
                        </CollectionView>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="代班人 *" FontSize="13" VerticalOptions="Center"/>
                            <Picker Grid.Column="1" ItemsSource="{Binding SubstituteTargetOptions}"
                                    SelectedItem="{Binding SelectedSubstituteMember}"
                                    ItemDisplayBinding="{Binding Name}"
                                    HeightRequest="36"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="事由" FontSize="13" VerticalOptions="Center"/>
                            <Entry Grid.Column="1" Text="{Binding SubstituteReason}" Placeholder="选填" HeightRequest="36"/>
                        </Grid>

                        <Label Text="代班为单人顶班一次：代班人代替被代班人上班；值班表即时刷新，撤销后自动恢复" FontSize="11" TextColor="{StaticResource TextTertiary}"/>

                        <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                            <Button Text="保存" Style="{StaticResource ButtonPrimary}" HeightRequest="34" Padding="18,4" Opacity="{Binding ManageOpacity}" Command="{Binding SaveSubstituteCommand}"/>
                            <Button Text="关闭" Style="{StaticResource ButtonOutline}" HeightRequest="34" Padding="18,4" Command="{Binding CancelSubstituteFormCommand}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>

        <!-- 改期面板 -->
        <Grid Grid.Row="0" IsVisible="{Binding IsReschedulePanelVisible}" BackgroundColor="#66000000">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="12">
                <Border Style="{StaticResource CardBorder}" Padding="20" WidthRequest="480">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding ReschedulePanelTitle}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="12" BackgroundColor="Transparent" TextColor="{StaticResource TextSecondary}" Command="{Binding CancelRescheduleFormCommand}" Padding="4,0"/>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
                            <Label Grid.Column="0" Text="{Binding RescheduleDateLabel}" FontSize="13" VerticalOptions="Center"/>
                            <DatePicker Grid.Column="1" Date="{Binding RescheduleNewDate}" WidthRequest="150" HeightRequest="36"/>
                        </Grid>

                        <Label Text="改期后自动重排新旧日期所在月：新日期由记录中的顶班人顶上，旧日期恢复轮转原值；一条记录始终，不会产生重复" FontSize="11" TextColor="{StaticResource TextTertiary}"/>

                        <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                            <Button Text="保存" Style="{StaticResource ButtonPrimary}" HeightRequest="34" Padding="18,4" Opacity="{Binding ManageOpacity}" Command="{Binding SaveRescheduleCommand}"/>
                            <Button Text="关闭" Style="{StaticResource ButtonOutline}" HeightRequest="34" Padding="18,4" Command="{Binding CancelRescheduleFormCommand}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>

        <components:LoadingOverlay Grid.Row="0" IsLoading="{Binding IsBusy}" LoadingText="{Binding LoadingMessage}"/>

        <Grid Grid.Row="0" VerticalOptions="End" HorizontalOptions="Center" Margin="0,0,0,24" InputTransparent="True">
            <components:SnackBarView Message="{Binding SnackBarMessage}"
                                     Type="{Binding SnackBarType}"
                                     IsVisible="{Binding IsSnackBarVisible}"/>
        </Grid>

    </Grid>
</ContentPage>
