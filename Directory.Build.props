<Project>
  <!-- 统一的警告屏蔽配置 -->
  <PropertyGroup>
    <!-- 代码分析警告（CA系列）-->
    <NoWarn>$(NoWarn);CA1707;CA1859;CA1845;CA1822;CA1852;CA2201;CA1000;CA1001;CA1416;CA1716;CA1816</NoWarn>
    
    <!-- XAML编译警告（XC系列）；验证绑定时用 -p:ShowXamlCWarnings=true 显形 -->
    <NoWarn Condition="'$(ShowXamlCWarnings)' != 'true'">$(NoWarn);XC0022;XC0023;XC0024;XC0025;XC0045;XC0009</NoWarn>
    
    <!-- 系统库警告 -->
    <NoWarn>$(NoWarn);SYSLIB1045</NoWarn>
    
    <!-- 可空性警告（CS系列）-->
    <NoWarn>$(NoWarn);CS8625</NoWarn>
    
    <!-- 警告不作为错误处理 -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- 批 7（2026-09-22）：恢复构建期代码分析器（此前 RunAnalyzers=false 关闭省时）。
       AnalysisLevel/EnableNETAnalyzers 走 .NET 10 SDK 默认（latest）；TreatWarningsAsErrors 维持 false；
       存量已知误报在上方 NoWarn 白名单逐条屏蔽并注明分类，新警告按"真问题修 / 误报入白名单+注释"处理。 -->
</Project>
